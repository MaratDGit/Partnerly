<Project Sdk="Microsoft.NET.Sdk">

  <!-- Partnerly Agent: a small tray program that lets Partnerly cards act on this PC.
       Windows only (tray, clipboard, screenshots, lock screen). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Partnerly.Agent</AssemblyName>
    <RootNamespace>Partnerly.Agent</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.5.0</Version>
    <Product>Partnerly Agent</Product>
    <Company>Partnerly</Company>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="6.0.36" />
  </ItemGroup>

</Project>
