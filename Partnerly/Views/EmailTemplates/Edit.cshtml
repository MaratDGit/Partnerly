@model Partnerly.Models.ViewModels.EmailTemplateViewModel;
@await Html.PartialAsync("_Toast")

@{
    ViewData["Title"] = "Редактировать шаблон";
    Layout = "_ContentNavbarLayout";
}

<div class="card">
    <div class="card-header justify-content-between">
        <h5>@ViewData["Title"]</h5>
    </div>

    <div class="card-body">
        <form id="emailTemplateForm" asp-action="Edit">
         <div class="sticky-buttons justify-content-between mb-6">
             <a asp-action="Index" class="btn btn-sm btn-outline-primary">
                <i class="bx bx-arrow-back me-1"></i> 
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">
                <i class="bx bx-undo me-1"></i>
            </a>
            <button type="submit" id="btnSave" class="btn btn-sm btn-outline-primary">
                <i class="bx bx-save me-1"></i> 
            </button>
            <a class="btn btn-sm btn-outline-primary" asp-action="Create">
                <i class="bx bx-plus me-1"></i> 
            </a>
            <a class="btn btn-sm btn-outline-primary" asp-action="Delete" asp-route-id="@Model.Id">
                    <i class="bx bx-trash me-1"></i> 
            </a>
            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#previewModal" onclick="showPreview()">
                <i class="bx bx-show me-1"></i> 
            </button>
        </div>

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Name" />

        <div class="form-floating mb-1 max-w-600">
            <input asp-for="Subject" id="subject" class="form-control" autofocus/>
            <label asp-for="Subject"></label>
            <span asp-validation-for="Subject" class="text-danger"></span>       
        </div>
        <div class="form-floating mb-1">
            <textarea asp-for="BodyHtml"  id="bodyHtml" class="form-control" style="height: 300px" rows="10"></textarea>
            <label asp-for="BodyHtml"></label>
            <span asp-validation-for="BodyHtml" class="text-danger"></span>    
        </div>
        </form>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-labelledby="previewModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="previewModalLabel">Предпросмотр письма</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
      </div>
      <div class="modal-body">
        <h4 id="previewSubject"></h4>
        <hr />
        <div id="previewBody"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
      </div>
    </div>
  </div>
</div>

<script src="~/js/form-change-tracker.js"></script>
<script>
    enableSaveOnChange("#emailTemplateForm", "#btnSave");

    function showPreview() {
        const subject = document.getElementById("subject").value;
        const bodyHtml = document.getElementById("bodyHtml").value;

        document.getElementById("previewSubject").innerText = subject;
        document.getElementById("previewBody").innerHTML = bodyHtml; 
    }
</script>


