@model Partnerly.Models.ViewModels.EmailTemplateViewModel

@{
    ViewData["Title"] = "Deleting the template";
    Layout = "_ContentNavbarLayout";
}

@await Html.PartialAsync(
"_DeleteConfirmation",
    new Partnerly.Models.ViewModels.DeleteConfirmationViewModel
    {
        Id = Model.Id,
        Title = Localizer["Deletingthetemplate"],
        Message = Localizer["Areyousureyouwanttodeletethisfile"],
        DeleteAction = "DeleteConfirmed",
        DeleteController = "EmailTemplates",
        CancelAction = "Index",
        CancelController = "EmailTemplates"
    })



