@model Partnerly.Models.ViewModels.EmailTemplateViewModel;
@await Html.PartialAsync("_Toast")

@{
    ViewData["Title"] = "Удаление шаблона";
    Layout = "_ContentNavbarLayout";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5>@ViewData["Title"]</h5>
    </div>

    <div class="card-body">
        <form id="emailTemplateForm" asp-action="DeleteConfirmed">
            <div class="sticky-buttons justify-content-between mb-6">
                 <a asp-action="Index" class="btn btn-sm btn-outline-primary">
                    <i class="bx bx-arrow-back me-1 fs-6"></i> Отмена
                </a>
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bx bx-trash me-1 fs-6"></i> Подтверждать</button>
            </div>

            <input type="hidden" asp-for="Id" />
        </form>
    </div>
</div>
