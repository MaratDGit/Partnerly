@{
    ViewData["Title"] = "Шаблоны электронной почты";
    Layout = "_ContentNavbarLayout";
}

@await Html.PartialAsync("_DataTablePartial", null, new ViewDataDictionary(ViewData)
{
    { "TableName", "Шаблоны электронной почты" },
    { "TableId", "emailTemplatesTable" },
})

@section PageScripts {
    <script>
         $(document).ready(function () {
            initUniqueDataTable("emailTemplatesTable", '@Url.Action("GetData", "EmailTemplates")');
        });
    </script>
}
