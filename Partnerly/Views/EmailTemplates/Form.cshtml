@model Partnerly.Models.ViewModels.EmailTemplateViewModel
@await Html.PartialAsync("_Toast")

@{
    bool isEdit = Model.Id != Guid.Empty;

    ViewData["Title"] = Model.Title;
    Layout = "_ContentNavbarLayout";
}

@section PageStyles {
    <link rel="stylesheet" href="~/assets/css/email-template-preview.css" asp-append-version="true" />
}

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="mb-0">
            @(isEdit
                        ? Localizer["Edittemplate"]
                        : Localizer["Createatemplate"])
        </h5>

        @if (isEdit)
        {
            @await Html.PartialAsync("_AuditInfo", Model)
        }
    </div>

    <div class="card-body">
        <form id="emailTemplateForm"
              asp-action="@(isEdit ? "Edit" : "Create")"
              method="post">

            @await Html.PartialAsync("_StickyButtons", Model.StickyButtons)

            @if (isEdit)
            {
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Name" />
                <input type="hidden" asp-for="Note" />
            }

            <div class="form-floating mb-1 max-w-600 position-relative">
                @if (isEdit)
                {
                    <input asp-for="NameView"
                           id="name"
                           class="form-control lookup-input pe-5"
                           placeholder=" "
                           data-lookup="true"
                           data-lookup-source="/EmailTemplates/GetLookupList"
                           data-lookup-title="@Localizer["Templates"]"
                           data-edit-url-base="/EmailTemplates/Edit/"
                           data-lookup-column-names="name:@Localizer["Name"],subject:@Localizer["Topic"]"
                           data-lookup-display-field="Name"
                           data-lookup-param="fieldName"
                           data-lookup-param-value="Name"
                           readonly />

                    <label asp-for="NameView"></label>
                }
                else
                {
                    <input asp-for="Name"
                           id="name"
                           class="form-control lookup-input pe-5"
                           placeholder=" "
                           data-lookup="true"
                           data-lookup-source="/EmailTemplates/GetLookupList"
                           data-lookup-title="@Localizer["Templates"]"
                           data-edit-url-base="/EmailTemplates/Edit/"
                           data-lookup-column-names="name:@Localizer["Name"],subject:@Localizer["Topic"]"
                           data-lookup-display-field="Name"
                           data-lookup-param="fieldName"
                           data-lookup-param-value="Name" />

                    <label asp-for="Name"></label>

                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                }

                <i class="bx bx-search lookup-icon"></i>
            </div>

            <div class="form-floating mb-1 max-w-600">
                <input asp-for="Subject"
                       id="subject"
                       class="form-control" />

                <label asp-for="Subject"></label>

                <span asp-validation-for="Subject"
                      class="text-danger"></span>
            </div>

            <div class="form-floating mb-1">
                <textarea asp-for="BodyHtml"
                          id="bodyHtml"
                          class="form-control"
                          style="height: 300px"
                          rows="10"></textarea>

                <label asp-for="BodyHtml"></label>

                <span asp-validation-for="BodyHtml"
                      class="text-danger"></span>
            </div>
        </form>
    </div>
</div>

<div class="modal fade"
     id="previewModal"
     tabindex="-1"
     aria-labelledby="previewModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered email-preview-dialog">
        <div class="modal-content email-preview-content">
            <div class="modal-header email-preview-header">
                <h5 class="modal-title" id="previewModalLabel">
                    <span class="email-preview-icon">
                        <i class="bx bx-envelope-open"></i>
                    </span>
                    <span>@Localizer["Emailpreview"]</span>
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="@Localizer["Close"]">
                </button>
            </div>

            <div class="modal-body email-preview-body">
                <div class="email-preview-letter">
                    <div class="email-preview-meta">
                        <span class="email-preview-meta-label">@Localizer["Subject"]</span>
                        <h4 id="previewSubject" class="email-preview-subject"></h4>
                    </div>

                    <div class="email-preview-frame-wrap">
                        <iframe id="previewFrame"
                                title="Email template preview"
                                sandbox=""></iframe>
                        <div class="email-preview-empty" data-preview-empty hidden>
                            <i class="bx bx-mail-send"></i>
                            <p>@Localizer["EmailPreviewEmpty"]</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer email-preview-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    @Localizer["Close"]
                </button>
            </div>
        </div>
    </div>
</div>

<script src="~/assets/js/form-change-tracker.js"></script>

<script>
    enableSaveOnChange("#emailTemplateForm", "#btnSave");

    function mountPreviewModal() {
        const modal = document.getElementById("previewModal");
        if (modal && modal.parentElement !== document.body) {
            document.body.appendChild(modal);
        }
        return modal;
    }

    function showPreview() {
        mountPreviewModal();

        const subject = (document.getElementById("subject")?.value || "").trim();
        const bodyHtml = document.getElementById("bodyHtml")?.value || "";
        const subjectEl = document.getElementById("previewSubject");
        const frame = document.getElementById("previewFrame");
        const empty = document.querySelector("[data-preview-empty]");

        if (subjectEl) {
            subjectEl.textContent = subject || "—";
            subjectEl.classList.toggle("is-empty", !subject);
        }

        if (frame) {
            frame.srcdoc = bodyHtml;
        }

        if (empty) {
            empty.hidden = bodyHtml.trim().length > 0;
        }
    }

    document.addEventListener("DOMContentLoaded", mountPreviewModal);
</script>