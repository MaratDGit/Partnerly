@model Partnerly.Automation.Web.ViewModels.AutomationRunDetailsViewModel
@{
    ViewData["Title"] = Localizer["History"].Value;
}

@section PageStyles {
    <link rel="stylesheet" href="~/assets/css/automation-builder.css" asp-append-version="true" />
}

<div class="container-xxl flex-grow-1 container-p-y automation-page">
    @await Html.PartialAsync("_Toast")
    <div class="automation-page-head">
        <div>
            <p class="automation-kicker">@Localizer["History"]</p>
            <h1>@Model.Definition.Name</h1>
            <p class="automation-lead">@Model.Run.Status · @Model.Run.TriggerType · @Localizer["AutomationRunLead"]</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary" asp-action="History" asp-route-id="@Model.Definition.Id">@Localizer["Back"]</a>
            @if (Model.Run.Status is "queued" or "running" or "waiting"
                 && (ViewData["Permissions"] as HashSet<string>)?.Contains("automation.run") == true)
            {
                <form asp-action="Cancel" asp-route-id="@Model.Run.Id" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">@Localizer["Canceled"]</button>
                </form>
            }
        </div>
    </div>
    @await Html.PartialAsync("~/Views/Shared/Automation/_AutomationNav.cshtml")

    @if (!string.IsNullOrEmpty(Model.Run.Error))
    {
        <div class="alert alert-danger">@Model.Run.Error</div>
    }

    <div class="automation-glass">
        <p class="automation-kicker">@Localizer["Actions"]</p>
        <h2 class="h5 mb-3">@Localizer["History"]</h2>
        <div class="table-responsive">
            <table class="automation-table">
                <thead>
                    <tr>
                        <th>@Localizer["Name"]</th>
                        <th>@Localizer["Type"]</th>
                        <th>@Localizer["Status"]</th>
                        <th>@Localizer["Error"]</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Steps.Count == 0)
                {
                    <tr><td colspan="4">@Localizer["AutomationEmptyRuns"]</td></tr>
                }
                else
                {
                    foreach (var step in Model.Steps)
                    {
                        <tr>
                            <td>@step.NodeId</td>
                            <td>@step.ActionType</td>
                            <td>@step.Status</td>
                            <td>@step.Error</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
