@model Partnerly.Automation.Web.ViewModels.AutomationTemplatesViewModel
@{
    ViewData["Title"] = Localizer["AutomationTemplates"].Value;
}

@section PageStyles {
    <link rel="stylesheet" href="~/assets/css/automation-builder.css" asp-append-version="true" />
}

<div class="container-xxl flex-grow-1 container-p-y automation-page">
    @await Html.PartialAsync("_Toast")
    <div class="automation-page-head">
        <div>
            <p class="automation-kicker">@Localizer["Automation"]</p>
            <h1>@Localizer["AutomationTemplates"]</h1>
            <p class="automation-lead">@Localizer["AutomationTemplatesLead"]</p>
        </div>
    </div>
    @await Html.PartialAsync("~/Views/Shared/Automation/_AutomationNav.cshtml")

    <div class="row g-3">
        @foreach (var preset in Model.Presets)
        {
            <div class="col-md-4">
                <div class="automation-glass h-100 d-flex flex-column">
                    <p class="automation-kicker">@Localizer["StartFromTemplate"]</p>
                    <h2 class="h5">@preset.Name</h2>
                    <p class="automation-lead flex-grow-1 mb-3">@preset.Description</p>
                    @if ((ViewData["Permissions"] as HashSet<string>)?.Contains("automation.create") == true)
                    {
                        <button type="button"
                                class="btn btn-primary align-self-start"
                                data-open-create-automation
                                data-template-id="@preset.Id"
                                data-template-name="@preset.Name"
                                data-template-description="@preset.Description">
                            @Localizer["UseTemplate"]
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</div>

@await Html.PartialAsync("~/Views/Shared/Automation/_CreateAutomationPopup.cshtml")

@section PageScripts {
    <script src="~/assets/js/automation/create-popup.js" asp-append-version="true"></script>
}
