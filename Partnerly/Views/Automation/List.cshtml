@using Partnerly.Models.DataTable
@model DataTableOptions
@{
    ViewData["Title"] = Localizer["MyAutomations"].Value;
}

@section PageStyles {
    <link rel="stylesheet" href="~/assets/css/automation-builder.css" asp-append-version="true" />
}

<div class="container-xxl flex-grow-1 container-p-y automation-page">
    @await Html.PartialAsync("_Toast")
    <div class="automation-page-head">
        <div>
            <p class="automation-kicker">@Localizer["Automation"]</p>
            <h1>@Localizer["MyAutomations"]</h1>
            <p class="automation-lead">@Localizer["MyAutomationsLead"]</p>
        </div>
        @if ((ViewData["Permissions"] as HashSet<string>)?.Contains("automation.create") == true)
        {
            <button type="button" class="btn btn-primary" data-open-create-automation>
                <i class="bx bx-plus"></i> @Localizer["Create"]
            </button>
        }
    </div>
    @await Html.PartialAsync("~/Views/Shared/Automation/_AutomationNav.cshtml")
    <div class="automation-glass automation-table-shell">
        @await Html.PartialAsync("~/Views/Shared/DataTable/_DataTable.cshtml", Model)
    </div>
</div>

@await Html.PartialAsync("~/Views/Shared/Automation/_CreateAutomationPopup.cshtml")

@section PageScripts {
    <script src="~/assets/js/automation/create-popup.js" asp-append-version="true"></script>
}
