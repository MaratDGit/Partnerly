@model Partnerly.Automation.Web.ViewModels.AutomationBuilderViewModel
@{
    ViewData["Title"] = Localizer["AutomationBuilder"].Value;
}

@section PageStyles {
    <link rel="stylesheet" href="~/vendor/drawflow/drawflow.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/automation-builder.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/automation-chat.css" asp-append-version="true" />
}

<div class="automation-page automation-builder-page">
    @await Html.PartialAsync("_AutomationToast")
    @await Html.PartialAsync("~/Views/Shared/Automation/_BuilderPanel.cshtml", Model)
</div>

@await Html.PartialAsync("~/Views/Shared/Automation/_HubOverlay.cshtml")

@section PageScripts {
    <script src="~/vendor/drawflow/drawflow.min.js" asp-append-version="true"></script>
    <script src="~/assets/js/integrations/builder-forms.js" asp-append-version="true"></script>
    <script src="~/assets/js/automation/builder-fields.js" asp-append-version="true"></script>
    <script src="~/assets/js/automation/builder.js" asp-append-version="true"></script>
    <script src="~/assets/js/automation/hub.js" asp-append-version="true"></script>
    <script src="~/assets/js/automation/builder-status.js" asp-append-version="true"></script>
    <script src="~/assets/js/automation/builder-props.js" asp-append-version="true"></script>
    <script src="~/assets/js/automation/builder-leave-guard.js" asp-append-version="true"></script>
    <script src="~/assets/js/automation/builder-chat.js" asp-append-version="true"></script>
    <script src="~/assets/js/automation/builder-tools.js" asp-append-version="true"></script>
}
