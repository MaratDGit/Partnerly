@using Partnerly.Helpers
@model Partnerly.Automation.Web.ViewModels.AutomationSettingsViewModel
@{
    ViewData["Title"] = Localizer["AutomationSettings"].Value;
}

@section PageStyles {
    <link rel="stylesheet" href="~/assets/css/automation-builder.css" asp-append-version="true" />
}

<div class="container-xxl flex-grow-1 container-p-y automation-page">
    @await Html.PartialAsync("_Toast")
    <div class="automation-page-head">
        <div>
            <p class="automation-kicker">@Localizer["Automation"]</p>
            <h1>@Localizer["AutomationSettings"]</h1>
            <p class="automation-lead">@Localizer["AutomationSettingsLead"]</p>
        </div>
    </div>
    @await Html.PartialAsync("~/Views/Shared/Automation/_AutomationNav.cshtml")

    @if (Model.Definition == null)
    {
        <div class="automation-glass">
            <p class="automation-kicker">@Localizer["MyAutomations"]</p>
            <p class="automation-lead mb-3">@Localizer["LimitsOnDefinition"]</p>
            @if (Model.Definitions.Count == 0)
            {
                <p class="mb-0">@Localizer["AutomationEmptyRuns"]</p>
            }
            else
            {
                <div class="automation-list">
                    @foreach (var item in Model.Definitions)
                    {
                        <a asp-action="Settings" asp-route-id="@item.Id">@item.Name</a>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <form asp-action="SettingsSave" asp-route-id="@Model.Definition.Id" method="post" class="automation-glass">
            @Html.AntiForgeryToken()
            <p class="automation-kicker">@Model.Definition.Name</p>
            <h2 class="h5 mb-3">@Localizer["AutomationSettings"]</h2>
            <div class="mb-3">
                <label class="form-label">@Localizer["TimeZone"]</label>
                <select class="form-select" name="timeZoneId">
                    @foreach (var zone in TimeZoneHelper.Choices)
                    {
                        if (string.Equals(zone.Id, Model.Definition.TimeZoneId, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@zone.Id" selected>@zone.Label</option>
                        }
                        else
                        {
                            <option value="@zone.Id">@zone.Label</option>
                        }
                    }
                </select>
                <div class="form-text">@Localizer["ScheduleTimeHelp"]</div>
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">@Localizer["MaxConcurrentRuns"]</label>
                    <input class="form-control" type="number" min="1" max="20" name="maxConcurrentRuns" value="@Model.Definition.MaxConcurrentRuns" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@Localizer["MaxRunsPerHour"]</label>
                    <input class="form-control" type="number" min="1" max="1000" name="maxRunsPerHour" value="@Model.Definition.MaxRunsPerHour" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@Localizer["RetryLimit"]</label>
                    <input class="form-control" type="number" min="0" max="10" name="retryLimit" value="@Model.Definition.RetryLimit" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">@Localizer["StepTimeoutSeconds"]</label>
                    <input class="form-control" type="number" min="1" max="300" name="stepTimeoutSeconds" value="@Model.Definition.StepTimeoutSeconds" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">@Localizer["RunTimeoutSeconds"]</label>
                    <input class="form-control" type="number" min="1" max="86400" name="runTimeoutSeconds" value="@Model.Definition.RunTimeoutSeconds" />
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
                <a class="btn btn-outline-secondary" asp-action="Builder" asp-route-id="@Model.Definition.Id">@Localizer["AutomationBuilder"]</a>
            </div>
        </form>
    }
</div>
