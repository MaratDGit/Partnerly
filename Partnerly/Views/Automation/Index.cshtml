@model Partnerly.Automation.Web.ViewModels.AutomationDashboardViewModel
@{
    ViewData["Title"] = Localizer["Automation"].Value;
    var perms = ViewData["Permissions"] as HashSet<string>;
    bool Can(string code) => perms?.Contains(code) == true;
    var canHistory = Can("automation.history") ? "true" : "false";
    var canEdit = Can("automation.edit") ? "true" : "false";
    var canDelete = Can("automation.delete") ? "true" : "false";
    var activeCount = Model.Definitions.Count(item => item.IsActive);
    var categories = new[] { "partnerly", "telegram", "google", "microsoft", "whatsapp", "computer" };
    string CategoryIcon(string category) => category switch
    {
        "computer" => "bx-desktop",
        "telegram" => "bxl-telegram",
        "google" => "bxl-google",
        "microsoft" => "bxl-microsoft",
        "whatsapp" => "bxl-whatsapp",
        _ => "bx-bot"
    };
    (string Icon, string Css) ServiceLogo(string service) => service switch
    {
        "Telegram" => ("bxl-telegram", "is-telegram"),
        "WhatsApp" => ("bxl-whatsapp", "is-whatsapp"),
        "Google Sheets" => ("bx-spreadsheet", "is-google"),
        "Gmail" => ("bxl-gmail", "is-google"),
        "Google Drive" => ("bxl-google-cloud", "is-google"),
        "Outlook" => ("bxl-microsoft", "is-microsoft"),
        "Computer" => ("bx-desktop", "is-computer"),
        _ => ("bx-plug", "")
    };
    string CategoryLabel(string category) => category switch
    {
        "telegram" => "Telegram",
        "google" => "Google",
        "microsoft" => "Outlook",
        "whatsapp" => "WhatsApp",
        "computer" => "Computer",
        _ => "Partnerly"
    };
}

@section PageStyles {
    <link rel="stylesheet" href="~/assets/css/automation-builder.css" asp-append-version="true" />
}

<div id="automationHubRoot"
     class="container-xxl flex-grow-1 container-p-y automation-page automation-hub-page"
     data-active="@Localizer["Active"]"
     data-inactive="@Localizer["Inactive"]"
     data-empty="@Localizer["AutomationEmptyDefinitions"]"
     data-history="@Localizer["History"]"
     data-settings="@Localizer["Settings"]"
     data-edit="@Localizer["Edit"]"
     data-delete="@Localizer["Delete"]"
     data-col-status="@Localizer["Status"]"
     data-col-updated="@Localizer["UpdatedDate"]"
     data-can-history="@canHistory"
     data-can-edit="@canEdit"
     data-can-delete="@canDelete">
    @await Html.PartialAsync("_AutomationToast")

    <header class="automation-hub-hero">
        <div class="automation-hub-hero-text">
            <div class="automation-hub-stats">
                <span class="automation-hub-stat"><i class="bx bx-bot"></i> <strong data-hub-count>@Model.Definitions.Count</strong> @Localizer["AutomationHubAgents"]</span>
                <span class="automation-hub-stat is-on"><i class="bx bx-play-circle"></i> <strong>@activeCount</strong> @Localizer["Active"]</span>
                <span class="automation-hub-stat"><i class="bx bx-layer"></i> <strong>@Model.Presets.Count</strong> @Localizer["ReadyTemplates"]</span>
            </div>
        </div>
        <div class="automation-hub-hero-actions">
            @if (Can("automation.connections"))
            {
                <a class="automation-hub-secondary" asp-controller="Integrations" asp-action="Index">
                    <i class="bx bx-plug"></i> @Localizer["Integrations"]
                </a>
            }
            @if (Can("automation.create"))
            {
                <label class="automation-hub-secondary" role="button" tabindex="0" data-import-agent-label
                       data-import-url="@Url.Action("Import", "Automation")">
                    <i class="bx bx-upload"></i> @Localizer["ToolsImport"]
                    <input type="file" accept=".json,application/json" hidden data-import-agent />
                </label>
                <button type="button" class="automation-hub-primary" data-open-create-automation>
                    <i class="bx bx-plus"></i> @Localizer["Create"]
                </button>
            }
        </div>
    </header>

    @{
        var allTags = Model.Definitions.SelectMany(item => item.TagList).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(tag => tag, StringComparer.OrdinalIgnoreCase).ToList();
    }
    @if (allTags.Count > 0)
    {
        <div class="automation-hub-tags" data-tag-filter role="group" aria-label="@Localizer["ToolsTags"]">
            <i class="bx bx-purchase-tag-alt" aria-hidden="true"></i>
            @foreach (var tag in allTags)
            {
                <button type="button" class="automation-hub-tag is-filter" data-tag="@tag.ToLowerInvariant()">@tag</button>
            }
        </div>
    }

    <div class="automation-glass automation-hub-table-wrap">
        @Html.AntiForgeryToken()
        <table class="automation-hub-table">
            <thead>
                <tr>
                    <th class="automation-hub-switch-col"><span class="visually-hidden">@Localizer["Status"]</span></th>
                    <th>@Localizer["Name"]</th>
                    <th>@Localizer["Status"]</th>
                    <th>@Localizer["UpdatedDate"]</th>
                    <th class="automation-hub-actions-col">@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody data-hub-rows>
            @if (Model.Definitions.Count == 0)
            {
                <tr data-hub-empty>
                    <td colspan="5" class="automation-hub-empty">@Localizer["AutomationEmptyDefinitions"]</td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Definitions)
                {
                    <tr data-automation-row="@item.Id" data-icon="@item.Icon" data-tags="@(string.Join("|", item.TagList).ToLowerInvariant())">
                        <td class="automation-hub-switch-cell">
                            <div class="form-check form-switch automation-hub-switch" title="@(item.IsActive ? Localizer["Active"] : Localizer["Inactive"])">
                                <input class="form-check-input" type="checkbox" data-hub-toggle data-id="@item.Id"
                                       aria-label="@Localizer["Status"]" checked="@item.IsActive" disabled="@(Can("automation.edit") ? null : "disabled")" />
                            </div>
                        </td>
                        <td class="automation-hub-cell-main">
                            <div class="automation-hub-row-main">
                                <span class="automation-hub-avatar @(item.IsActive ? "is-on" : "is-off")" aria-hidden="true"><i class="bx @item.Icon"></i></span>
                                <div class="automation-hub-row-text">
                                    <div class="automation-hub-name">@item.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="automation-hub-desc">@item.Description</div>
                                    }
                                    @if (item.TagList.Count > 0)
                                    {
                                        <div class="automation-hub-tags-row">
                                            @foreach (var tag in item.TagList)
                                            {
                                                <span class="automation-hub-tag">@tag</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </td>
                        <td data-label="@Localizer["Status"]">
                            <span class="automation-hub-status @(item.IsActive ? "is-on" : "is-off")">
                                @(item.IsActive ? Localizer["Active"] : Localizer["Inactive"])
                            </span>
                        </td>
                        <td class="automation-hub-date" data-label="@Localizer["UpdatedDate"]">@Partnerly.Helpers.TimeZoneHelper.FormatIn(item.UpdatedDate, item.TimeZoneId)</td>
                        <td class="automation-hub-actions">
                            @if (Can("automation.history"))
                            {
                                <button type="button" class="automation-hub-icon" data-hub="history" data-id="@item.Id" title="@Localizer["History"]" aria-label="@Localizer["History"]">
                                    <i class="bx bx-history"></i>
                                </button>
                            }
                            @if (Can("automation.edit"))
                            {
                                <button type="button" class="automation-hub-icon" data-hub="settings" data-id="@item.Id" title="@Localizer["Settings"]" aria-label="@Localizer["Settings"]">
                                    <i class="bx bx-cog"></i>
                                </button>
                                <a class="automation-hub-icon is-primary" asp-action="Builder" asp-route-id="@item.Id" title="@Localizer["Edit"]" aria-label="@Localizer["Edit"]">
                                    <i class="bx bx-edit"></i>
                                </a>
                            }
                            @if (Can("automation.delete"))
                            {
                                <button type="button" class="automation-hub-icon is-danger" data-hub="delete" data-id="@item.Id" data-name="@item.Name" title="@Localizer["Delete"]" aria-label="@Localizer["Delete"]">
                                    <i class="bx bx-trash"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    <section class="automation-hub-templates" data-template-section>
        <div class="automation-hub-templates-head">
            <h2>@Localizer["ReadyTemplates"]</h2>
            <div class="automation-hub-filters" role="tablist" aria-label="@Localizer["ReadyTemplates"]">
                <button type="button" class="automation-hub-filter is-active" data-template-filter="all" role="tab" aria-selected="true">@Localizer["All"]</button>
                @foreach (var category in categories.Where(c => Model.Presets.Any(p => p.Category == c)))
                {
                    <button type="button" class="automation-hub-filter is-@category" data-template-filter="@category" role="tab" aria-selected="false">
                        <i class="bx @CategoryIcon(category)" aria-hidden="true"></i> @CategoryLabel(category)
                    </button>
                }
            </div>
        </div>
        <div class="automation-hub-template-grid">
            @foreach (var preset in Model.Presets)
            {
                var title = Localizer[preset.NameKey].Value;
                var lead = Localizer[preset.DescriptionKey].Value;
                var sizeKey = preset.Size == "large"
                    ? "TplSizeLarge"
                    : preset.Size == "medium" ? "TplSizeMedium" : "TplSizeSmall";
                <article class="automation-glass automation-hub-template is-@preset.Category" data-template-category="@preset.Category">
                    <h3>@title</h3>
                    <div class="automation-hub-template-logos">
                        <span class="automation-hub-logo" title="Partnerly" aria-hidden="true"><i class="bx bx-bot"></i></span>
                        @foreach (var service in preset.Services)
                        {
                            var logo = ServiceLogo(service);
                            <span class="automation-hub-logo @logo.Css" title="@service"><i class="bx @logo.Icon" aria-hidden="true"></i></span>
                        }
                    </div>
                    <p>@lead</p>
                    <div class="automation-hub-template-meta">
                        <span><i class="bx bx-git-commit" aria-hidden="true"></i> @Localizer["AutomationHubSteps"]: @preset.StepCount</span>
                        <span class="automation-hub-template-size is-@preset.Size">@Localizer[sizeKey]</span>
                    </div>
                    @if (Can("automation.create"))
                    {
                        <button type="button"
                                class="automation-hub-template-use"
                                data-open-create-automation
                                data-template-id="@preset.Id"
                                data-template-name="@title"
                                data-template-description="@lead">
                            @Localizer["UseShort"]
                        </button>
                    }
                </article>
            }
        </div>
    </section>
</div>

<template id="automationDeleteTemplate">
    @await Html.PartialAsync("~/Views/Shared/Automation/_DeletePanel.cshtml")
</template>

@await Html.PartialAsync("~/Views/Shared/Automation/_CreateAutomationPopup.cshtml")
@await Html.PartialAsync("~/Views/Shared/Automation/_HubOverlay.cshtml")

@section PageScripts {
    <script src="~/assets/js/automation/create-popup.js" asp-append-version="true"></script>
    <script src="~/assets/js/automation/hub.js" asp-append-version="true"></script>
}
