@using System.Globalization

@await Html.PartialAsync("Sections/_Variables")

@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var currentFlag = currentCulture switch
    {
        "en" => "gb",
        "ru" => "ru",
        "hy" => "am",
        _ => "gb"
    };
    var appName = TempData.Peek("appName") as string ?? Partnerly.Helpers.SystemSettingsDefaults.ApplicationName;
    var isScrollable = ViewData["LandingScroll"] as bool? == true;
}

<!DOCTYPE html>
<html lang="@currentCulture"
      data-theme="light"
      data-bs-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#080814" />

    @await Html.PartialAsync("_PageTitle")

    <script>
        (function () {
            try {
                var saved = localStorage.getItem("partnerly-theme") || "system";
                var dark = saved === "dark" || (saved === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
                var theme = dark ? "dark" : "light";
                document.documentElement.setAttribute("data-theme", theme);
                document.documentElement.setAttribute("data-bs-theme", theme);
                if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                    document.documentElement.classList.add("landing-draw");
                }
            } catch (error) {
                // Keep the default light theme.
            }
        })();
    </script>

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" />
    <link rel="stylesheet" href="~/assets/css/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/spiner.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/assets/img/favicon.svg" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon.png" asp-append-version="true" />
</head>

<body class="landing-body@(isScrollable ? " is-scrollable" : "")">

    <div id="globalLoader" hidden style="display:none;" aria-hidden="true">
        <div class="loader-container">
            <div class="spinner"></div>
            <div class="loader-text">@Localizer["LookupLoading"]</div>
        </div>
    </div>

    <header class="landing-header">
        <div class="landing-header-inner">

            <a asp-controller="Home"
               asp-action="Index"
               class="landing-brand">
                @await Html.PartialAsync("_SiteLogo", "landing")
                <span class="landing-brand-text" aria-label="@appName">
                    @foreach (var character in appName)
                    {
                        <span class="landing-brand-letter">@(character == ' ' ? "\u00A0" : character.ToString())</span>
                    }
                </span>
            </a>

            <div class="landing-header-actions partnerly-navbar-actions">

                <div class="dropdown">
                    <button type="button"
                            class="partnerly-navbar-action partnerly-language-button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            aria-label="Language">
                        <img src="https://flagcdn.com/24x18/@(currentFlag).png"
                             alt="@currentCulture"
                             width="24"
                             height="18" />
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end partnerly-language-menu">
                        <li>
                            <form asp-controller="Language" asp-action="SetLanguage" method="post">
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button type="submit" name="culture" value="en" class="dropdown-item">
                                    <img src="https://flagcdn.com/24x18/gb.png" width="24" height="18" class="me-2" alt="English" />
                                    <span>English</span>
                                </button>
                            </form>
                        </li>
                        <li>
                            <form asp-controller="Language" asp-action="SetLanguage" method="post">
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button type="submit" name="culture" value="ru" class="dropdown-item">
                                    <img src="https://flagcdn.com/24x18/ru.png" width="24" height="18" class="me-2" alt="Русский" />
                                    <span>Русский</span>
                                </button>
                            </form>
                        </li>
                        <li>
                            <form asp-controller="Language" asp-action="SetLanguage" method="post">
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button type="submit" name="culture" value="hy" class="dropdown-item">
                                    <img src="https://flagcdn.com/24x18/am.png" width="24" height="18" class="me-2" alt="Հայերեն" />
                                    <span>Հայերեն</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>

                <button type="button"
                        class="partnerly-navbar-action partnerly-theme-button"
                        id="partnerlyThemeButton"
                        aria-label="Change theme"
                        title="Change theme">
                    <i class="bx bx-moon" id="partnerlyThemeIcon"></i>
                </button>

            </div>
        </div>
    </header>

    <main class="landing-main">
        @RenderBody()
    </main>

    <script src="~/assets/vendor/libs/jquery/jquery.js" asp-append-version="true"></script>
    <script src="~/assets/vendor/js/bootstrap.js" asp-append-version="true"></script>
    <script src="~/assets/js/spiner.js" asp-append-version="true"></script>
    <script src="~/assets/js/partnerly-theme.js" asp-append-version="true"></script>
    <script src="~/assets/js/landing-brand.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
