@await Html.PartialAsync("Sections/_Variables")
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Branch</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/landing.css" />
</head>
<body>
    <header class="landing-header">
        <div class="container">
            <div class="logo">
                <a asp-controller="Home" asp-action="Index" class="app-brand-link gap-2">
                    <span>@await Html.PartialAsync("../_Partials/_Macros")</span>
                    <span>@TempData.Peek("appName")</span>
                </a>
            </div>
            <nav class="nav-links">
                <a href="#pricing">Тарифы</a>
                <a href="#videos">Обучающие видео</a>
                <a asp-controller="Account" asp-action="Login" class="btn-outline">Войти</a>
            </nav>

            <div class="menu-toggle" onclick="document.body.classList.toggle('menu-open')">
                ☰
            </div>
        </div>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

     <!-- Footer -->
    <footer class="landing-footer">
        <div class="container">
            <p>&copy; <script>
        document.write(new Date().getFullYear())
        </script> @TempData.Peek("appName"). Все права защищены.</p>
            <nav>
                <a asp-controller="Home" asp-action="Privacy">Политика</a>
            </nav>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
   @await RenderSectionAsync("Scripts", required: false)
</body>
</html>




