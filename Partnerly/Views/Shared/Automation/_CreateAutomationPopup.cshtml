@using Partnerly.Automation.Authoring
@{
    var presets = AutomationTemplateCatalog.All;
}

<div id="automationCreate"
     class="automation-create"
     hidden
     aria-hidden="true">
    <div class="automation-create-card"
         role="dialog"
         aria-modal="true"
         aria-labelledby="automationCreateTitle">
        <button type="button"
                class="automation-create-close"
                data-automation-create-close
                aria-label="@Localizer["Close"]">
            <i class="bx bx-x"></i>
        </button>

        <p class="automation-create-kicker">@Localizer["Automation"]</p>
        <h2 id="automationCreateTitle" data-create-title="@Localizer["CreateAutomation"]" data-edit-title="@Localizer["Edit"]">@Localizer["CreateAutomation"]</h2>
        <p class="automation-create-lead" data-create-only>@Localizer["CreateAutomationLead"]</p>

        <form asp-controller="Automation" asp-action="Create" method="post" class="automation-create-form"
              data-create-url="@Url.Action("Create", "Automation")"
              data-edit-url="@Url.Action("UpdateMeta", "Automation")">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label" for="automationCreateName">@Localizer["Name"]</label>
                <input id="automationCreateName"
                       class="form-control"
                       name="name"
                       maxlength="200"
                       required
                       autocomplete="off" />
                <div class="form-text">@Localizer["AutomationNameHelp"]</div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="automationCreateDescription">@Localizer["Description"]</label>
                <textarea id="automationCreateDescription"
                          class="form-control"
                          name="description"
                          maxlength="500"
                          rows="3"></textarea>
                <div class="form-text">@Localizer["AutomationDescriptionHelp"]</div>
            </div>
            <div class="mb-4" data-create-only>
                <label class="form-label" for="automationCreateTemplate">@Localizer["StartFromTemplate"]</label>
                <select id="automationCreateTemplate" class="form-select" name="templateId">
                    <option value="">@Localizer["BlankAutomation"]</option>
                    @foreach (var preset in presets)
                    {
                        var title = Localizer[preset.NameKey].Value;
                        var lead = Localizer[preset.DescriptionKey].Value;
                        var sizeKey = preset.Size == "large"
                            ? "TplSizeLarge"
                            : preset.Size == "medium" ? "TplSizeMedium" : "TplSizeSmall";
                        <option value="@preset.Id"
                                data-name="@title"
                                data-description="@lead">@title (@Localizer[sizeKey])</option>
                    }
                </select>
                <div class="form-text">@Localizer["StartFromTemplateHelp"]</div>
            </div>
            <div class="automation-create-actions">
                <button type="button" class="btn btn-outline-secondary" data-automation-create-close>@Localizer["Cancel"]</button>
                <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
            </div>
        </form>
    </div>
</div>
