<div id="automationHub"
     class="automation-create automation-hub-overlay"
     hidden
     aria-hidden="true">
    <div class="automation-create-card automation-hub-card"
         data-hub-card
         role="dialog"
         aria-modal="true">
        <button type="button"
                class="automation-create-close"
                data-automation-hub-close
                aria-label="@Localizer["Close"]">
            <i class="bx bx-x"></i>
        </button>
        <div data-hub-body></div>
    </div>
</div>

<div id="automationHubNested"
     class="automation-create automation-hub-overlay automation-hub-overlay--nested"
     hidden
     aria-hidden="true">
    <div class="automation-create-card automation-hub-card"
         data-hub-card
         role="dialog"
         aria-modal="true">
        <button type="button"
                class="automation-create-close"
                data-automation-hub-close
                aria-label="@Localizer["Close"]">
            <i class="bx bx-x"></i>
        </button>
        <div data-hub-body></div>
    </div>
</div>
