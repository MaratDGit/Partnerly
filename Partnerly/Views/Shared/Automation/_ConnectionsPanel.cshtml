@model Partnerly.Automation.Web.ViewModels.AutomationConnectionsViewModel
@{
    var canManage = (ViewData["Permissions"] as HashSet<string>)?.Contains("automation.connections") == true;
}

<div class="automation-hub-panel automation-conn-sections">
    <h2>@Localizer["AutomationConnections"]</h2>

    <div class="automation-conn-scroll">

    <div class="automation-hub-block">
        <div class="automation-int-head">
            <h3>@Localizer["Integrations"]</h3>
            <a class="automation-int-manage" asp-controller="Integrations" asp-action="Index" target="_blank" rel="noopener">
                <i class="bx bx-plug" aria-hidden="true"></i> @Localizer["IntegrationManage"]
            </a>
        </div>
        @if (Model.IntegrationConnections.Count == 0)
        {
            <p class="automation-create-lead mb-0">@Localizer["IntegrationNoConnectionsHint"]</p>
        }
        else
        {
            <ul class="automation-int-list">
                @foreach (var item in Model.IntegrationConnections)
                {
                    var icon = item.Kind switch { "telegram" => "bxl-telegram", "google" => "bxl-google", "microsoft" => "bxl-microsoft", "whatsapp" => "bxl-whatsapp", _ => "bx-plug" };
                    <li>
                        <span class="automation-int-icon is-@item.Kind"><i class="bx @icon" aria-hidden="true"></i></span>
                        <span class="automation-int-name">@item.Name</span>
                        <span class="automation-int-kind">@item.Kind</span>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="automation-hub-block">
        <div class="automation-int-head">
            <h3>@Localizer["ConnWebhooksTitle"]</h3>
        </div>
        <p class="automation-conn-hint">@Localizer["ConnWebhooksHint"]</p>
        @if (Model.Webhooks.Count == 0)
        {
            <p class="automation-create-lead mb-0">@Localizer["AutomationEmptyWebhooks"]</p>
        }
        else
        {
            foreach (var hook in Model.Webhooks)
            {
                <div class="automation-connection">
                    <div class="fw-semibold mb-2"><i class="bx bx-bot me-1" aria-hidden="true"></i>@hook.AutomationName</div>

                    <div class="form-text">@Localizer["WebhookUrl"]</div>
                    <div class="automation-copy-row">
                        <code class="automation-code" data-copy-text>@hook.Url</code>
                        <button type="button" class="btn automation-icon-btn" data-copy title="@Localizer["ConnCopy"]" aria-label="@Localizer["ConnCopy"]">
                            <i class="bx bx-copy" aria-hidden="true"></i>
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(hook.Secret))
                    {
                        <div class="form-text mt-2">@Localizer["WebhookSecret"]</div>
                        <div class="automation-copy-row">
                            <code class="automation-code" data-copy-text>@hook.Secret</code>
                            <button type="button" class="btn automation-icon-btn" data-copy title="@Localizer["ConnCopy"]" aria-label="@Localizer["ConnCopy"]">
                                <i class="bx bx-copy" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="form-text mt-2">@Localizer["WebhookSignHint"]</div>
                    }
                </div>
            }
        }
    </div>

    <div class="automation-hub-block">
        <div class="automation-int-head">
            <h3>@Localizer["ConnHttpTitle"]</h3>
            @if (canManage)
            {
                <button type="button"
                        class="btn automation-icon-btn automation-add-btn"
                        data-connection-toggle="#automationHttpForm"
                        title="@Localizer["ConnAdd"]"
                        aria-label="@Localizer["ConnAdd"]"
                        aria-expanded="false">
                    <i class="bx bx-plus" aria-hidden="true"></i>
                </button>
            }
        </div>
        <p class="automation-conn-hint">@Localizer["ConnHttpHint"]</p>

        @if (canManage)
        {
            <form asp-action="CreateHttpConnection"
                  asp-controller="Automation"
                  method="post"
                  id="automationHttpForm"
                  class="automation-conn-form"
                  hidden
                  data-hub-ajax
                  data-hub-stay
                  data-hub-reload="connections">
                @Html.AntiForgeryToken()
                <div class="automation-conn-form-fields">
                    <div>
                        <label class="form-label">@Localizer["Name"]</label>
                        <input class="form-control" name="name" maxlength="200" required />
                    </div>
                    <div>
                        <label class="form-label">@Localizer["BaseUrl"]</label>
                        <input class="form-control" name="baseUrl" maxlength="500" placeholder="https://example.com" required />
                    </div>
                </div>
                <button type="submit" class="btn automation-icon-btn automation-add-btn" title="@Localizer["Save"]" aria-label="@Localizer["Save"]">
                    <i class="bx bx-check" aria-hidden="true"></i>
                </button>
            </form>
        }

        @if (Model.HttpConnections.Count == 0)
        {
            <p class="automation-create-lead mb-0">@Localizer["AutomationEmptyConnections"]</p>
        }
        else
        {
            <ul class="automation-http-list">
                @foreach (var item in Model.HttpConnections)
                {
                    <li>
                        <span class="automation-int-icon is-http"><i class="bx bx-link-alt" aria-hidden="true"></i></span>
                        <span class="automation-int-name">@item.Name</span>
                        @if (canManage)
                        {
                            <form asp-action="DeleteHttpConnection"
                                  asp-controller="Automation"
                                  method="post"
                                  class="m-0"
                                  data-hub-ajax
                                  data-hub-stay
                                  data-hub-reload="connections">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn automation-icon-btn automation-del-btn" title="@Localizer["Delete"]" aria-label="@Localizer["Delete"]">
                                    <i class="bx bx-trash" aria-hidden="true"></i>
                                </button>
                            </form>
                        }
                    </li>
                }
            </ul>
        }
    </div>
    </div>
</div>
