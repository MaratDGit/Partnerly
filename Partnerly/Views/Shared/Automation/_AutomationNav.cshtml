@using System.Linq
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    bool On(params string[] names) =>
        names.Any(name => string.Equals(action, name, StringComparison.OrdinalIgnoreCase));
}

<nav class="automation-nav" aria-label="@Localizer["Automation"]">
    <a class="@(On("Index") ? "is-active" : null)" asp-controller="Automation" asp-action="Index">@Localizer["AutomationDashboard"]</a>
    <a class="@(On("List", "Builder", "Delete") ? "is-active" : null)" asp-controller="Automation" asp-action="List">@Localizer["MyAutomations"]</a>
    <a class="@(On("History", "RunDetails") ? "is-active" : null)" asp-controller="Automation" asp-action="History">@Localizer["History"]</a>
    <a class="@(On("Templates") ? "is-active" : null)" asp-controller="Automation" asp-action="Templates">@Localizer["AutomationTemplates"]</a>
    <a class="@(On("Connections") ? "is-active" : null)" asp-controller="Automation" asp-action="Connections">@Localizer["AutomationConnections"]</a>
    <a class="@(On("Settings", "SettingsSave") ? "is-active" : null)" asp-controller="Automation" asp-action="Settings">@Localizer["AutomationSettings"]</a>
</nav>
