    // The search of the card list works in every language: each card is sent with its name in English, Russian
    // and Armenian (taken from the resource files), so "email", "письмо" or the Armenian word all find the same
    // card whatever language the page is shown in.
    var typeNames = new Dictionary<string, string[]>();
    {
        var savedUi = CultureInfo.CurrentUICulture;
        var collected = new Dictionary<string, List<string>>();
        try
        {
            foreach (var code in new[] { "en", "ru", "hy" })
            {
                CultureInfo.CurrentUICulture = new CultureInfo(code);
                foreach (var pair in buildTypes())
                {
                    if (!collected.TryGetValue(pair.Key, out var list))
                    {
                        collected[pair.Key] = list = new List<string>();
                    }

                    if (!string.IsNullOrWhiteSpace(pair.Value) && !list.Contains(pair.Value))
                    {
                        list.Add(pair.Value);
                    }
                }
            }
        }
        finally
        {
            CultureInfo.CurrentUICulture = savedUi;
        }

        foreach (var pair in collected)
        {
            typeNames[pair.Key] = pair.Value.ToArray();
        }
    }
