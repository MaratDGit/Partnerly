@model Partnerly.Automation.Web.ViewModels.AutomationBuilderViewModel
@{
    var perms = ViewData["Permissions"] as HashSet<string>;
    var canPublish = perms?.Contains("automation.publish") == true;
    var canRun = perms?.Contains("automation.run") == true;
    var canEdit = perms?.Contains("automation.edit") == true;
    var canConnections = perms?.Contains("automation.connections") == true;
    var canLiveRun = canRun && Model.IsPublished;
}

<form asp-action="BuilderSave"
      asp-controller="Automation"
      asp-route-id="@Model.Id"
      method="post"
      id="automationBuilderForm"
      class="automation-hub-builder"
      data-hub-ajax
      data-hub-stay
      data-builder-id="@Model.Id"
      data-can-edit="@(canEdit ? "true" : "false")"
      data-can-publish="@(canPublish ? "true" : "false")"
      data-can-run="@(canRun ? "true" : "false")"
      data-can-connections="@(canConnections ? "true" : "false")"
      data-toggle-url="@Url.Action("ToggleActive", "Automation", new { id = Model.Id })"
      data-catalog-url="@Url.Action("Catalog", "Automation")"
      data-save-url="@Url.Action("BuilderSave", "Automation", new { id = Model.Id })"
      data-publish-url="@Url.Action("Publish", "Automation", new { id = Model.Id })"
      data-run-url="@Url.Action("Run", "Automation", new { id = Model.Id, dryRun = false })"
      data-test-url="@Url.Action("Run", "Automation", new { id = Model.Id, dryRun = true })">
    @Html.AntiForgeryToken()
    <input type="hidden" name="name" value="@Model.Name" />
    <input type="hidden" name="description" value="@Model.Description" />
    <input type="hidden" name="graphJson" id="graphJson" value="@Model.GraphJson" />
    <script type="application/json" id="automationBuilderGraph">@Html.Raw(string.IsNullOrWhiteSpace(Model.GraphJson) ? "{}" : Model.GraphJson)</script>
    <script type="application/json" id="automationBuilderI18n">@await Html.PartialAsync("~/Views/Shared/Automation/_BuilderI18n.cshtml")</script>

    <div class="automation-builder">
        <div class="automation-canvas-wrap">
            <div id="drawflow" class="parent-drawflow automation-canvas"></div>
            <div class="automation-status"
                 data-status-card
                 data-state-url="@Url.Action("State", "Automation", new { id = Model.Id })"
                 data-automation-id="@Model.Id"
                 data-published="@(Model.IsPublished ? "true" : "false")"
                 data-active="@(Model.IsActive ? "true" : "false")"
                 data-changes="@(Model.HasUnpublishedChanges ? "true" : "false")"
                 data-running="@Model.RunningCount"
                 data-last-status="@Model.LastRunStatus"
                 data-last-at="@Model.LastRunAtUtc"
                 data-l-publish-first="@Localizer["AgentPublishFirst"]"
                 data-l-running="@Localizer["AgentStateRunning"]"
                 data-l-live="@Localizer["AgentStateLive"]"
                 data-l-paused="@Localizer["AgentStatePaused"]"
                 data-l-draft="@Localizer["AgentStateDraft"]"
                 data-l-published="@Localizer["AgentFlagPublished"]"
                 data-l-notpublished="@Localizer["AgentFlagNotPublished"]"
                 data-l-active="@Localizer["AgentFlagActive"]"
                 data-l-inactive="@Localizer["AgentFlagInactive"]"
                 data-l-changes="@Localizer["AgentFlagChanges"]"
                 data-l-lastrun="@Localizer["AgentLastRun"]"
                 data-l-noruns="@Localizer["AgentNoRuns"]"
                 data-l-runsnow="@Localizer["AgentRunsNow"]"
                 data-l-queued="@Localizer["AgentRunQueued"]"
                 data-l-runrunning="@Localizer["AgentRunRunning"]"
                 data-l-waiting="@Localizer["AgentRunWaiting"]"
                 data-l-succeeded="@Localizer["AgentRunSucceeded"]"
                 data-l-failed="@Localizer["AgentRunFailed"]"
                 data-l-cancelled="@Localizer["AgentRunCancelled"]"
                 role="status" aria-live="polite">
                <div class="automation-status-main">
                    <span class="automation-status-dot" data-status-dot aria-hidden="true"></span>
                    <strong data-status-label></strong>
                </div>
                <div class="automation-status-chips">
                    <span class="automation-status-chip" data-chip="published"></span>
                    <span class="automation-status-chip" data-chip="active"></span>
                    <span class="automation-status-chip is-warn" data-chip="changes" hidden></span>
                </div>
                <div class="automation-status-run" data-status-run></div>
            </div>
            <aside class="automation-props" data-props-panel hidden>
                <div class="automation-props-head">
                    <h6>@Localizer["NodeProperties"]</h6>
                    <button type="button" class="automation-props-close" data-props-close title="@Localizer["Close"]" aria-label="@Localizer["Close"]">
                        <i class="bx bx-x" aria-hidden="true"></i>
                    </button>
                </div>
                <p class="automation-hint" data-prop-empty>@Localizer["SelectNodeHint"]</p>
                <div class="automation-props-body">
                    <div data-prop-form hidden>
                        <label class="form-label">@Localizer["Name"]</label>
                        <input class="form-control mb-1" data-prop-name />
                        <div class="form-text mb-3">@Localizer["NodeNameHelp"]</div>
                        <div data-prop-fields></div>
                    </div>
                </div>
            </aside>
            <div class="automation-zoom" role="group" aria-label="@Localizer["FitView"]">
                <button type="button" class="automation-zoom-btn" data-zoom-out title="@Localizer["ZoomOut"]" aria-label="@Localizer["ZoomOut"]">−</button>
                <span class="automation-zoom-label" data-zoom-label>100%</span>
                <button type="button" class="automation-zoom-btn" data-zoom-in title="@Localizer["ZoomIn"]" aria-label="@Localizer["ZoomIn"]">+</button>
                <button type="button" class="automation-zoom-btn" data-zoom-fit title="@Localizer["FitView"]" aria-label="@Localizer["FitView"]">
                    <i class="bx bx-target-lock" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="automation-toolbar">
        <div class="automation-add" data-add-menu>
            <button type="button" class="automation-add-toggle" data-add-toggle aria-expanded="false">@Localizer["BuilderMenu"]</button>
            <div class="automation-add-panel" hidden>
                <a class="automation-add-item" data-act="back" asp-action="Index">@Localizer["Back"]</a>
                <button type="submit" class="automation-add-item" data-act="save" disabled="@(canEdit ? null : "disabled")">
                    @Localizer["Save"]
                </button>
                <button type="submit"
                        class="automation-add-item"
                        data-act="publish"
                        formaction="@Url.Action("Publish", "Automation", new { id = Model.Id })"
                        disabled="@(canPublish ? null : "disabled")">
                    @Localizer["Publish"]
                </button>
                <button type="submit"
                        class="automation-add-item"
                        data-act="test"
                        formaction="@Url.Action("Run", "Automation", new { id = Model.Id, dryRun = true })"
                        disabled="@(canRun ? null : "disabled")">
                    @Localizer["TestRun"]
                </button>
                <button type="submit"
                        class="automation-add-item"
                        data-act="run"
                        formaction="@Url.Action("Run", "Automation", new { id = Model.Id, dryRun = false })"
                        disabled="@(canLiveRun ? null : "disabled")"
                        title="@(canLiveRun || !canRun ? null : Localizer["AutomationRunNeedsPublish"].Value)">
                    @Localizer["RunNow"]
                </button>
                <button type="button"
                        class="automation-add-item"
                        data-act="toggle"
                        data-l-start="@Localizer["Start"]"
                        data-l-pause="@Localizer["Pause"]"
                        disabled="@(canEdit && Model.IsPublished ? null : "disabled")">
                    @(Model.IsActive ? Localizer["Pause"] : Localizer["Start"])
                </button>
                <button type="button" class="automation-add-item" data-act="settings" data-hub="settings" data-id="@Model.Id" data-hub-nested
                        disabled="@(canEdit ? null : "disabled")">
                    @Localizer["AutomationSettings"]
                </button>
                <button type="button"
                        class="automation-add-item"
                        data-act="connections"
                        data-hub="connections"
                        data-hub-nested
                        disabled="@(canConnections ? null : "disabled")">
                    @Localizer["AutomationConnections"]
                </button>
            </div>
        </div>
        <div class="automation-add" data-add-menu>
            <button type="button"
                    class="automation-add-toggle"
                    data-add-toggle
                    aria-expanded="false"
                    title="@Localizer["TriggerBlocksHelp"]">@Localizer["AddTrigger"]</button>
            <div class="automation-add-panel" data-palette-triggers hidden></div>
        </div>
        <div class="automation-add" data-add-menu>
            <button type="button"
                    class="automation-add-toggle"
                    data-add-toggle
                    aria-expanded="false"
                    title="@Localizer["ActionBlocksHelp"]">@Localizer["AddAction"]</button>
            <div class="automation-add-panel" data-palette-actions hidden></div>
        </div>
    </div>
</form>
