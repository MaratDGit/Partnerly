
<style>
.notification-item {
    position: relative;
    padding-right: 30px;
}

.delete-notification {
    position: absolute;
    top: 1px;
    right: 1px; 
    background-color: rgba(0, 0, 0, 0.05);
    border: none;
    border-radius: 50%;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease;
}

.delete-notification:hover {
    background-color: rgba(0, 0, 0, 0.15);
}

.delete-notification i {
    font-size: 16px;
    color: #333;
    pointer-events: none;
}

.notification-message {
    margin-top: 8px; 
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
}

.notification-full {
    margin-top: 8px;
    white-space: normal;
}


#markAllReadBtn {
    font-weight: 500;
    transition: background-color 0.2s ease;
}

#markAllReadBtn:hover {
    background-color: #0d6efd;
    color: #fff;
}

</style>

@if (ViewData["navbarFull"] != null)
{
<div class="navbar-brand app-brand demo d-none d-xl-flex py-0 me-4">
  <a asp-controller="Home" asp-action="Index" class="app-brand-link gap-2">
      <span class="app-brand-logo demo">
        @await Html.PartialAsync("../_Partials/_Macros")
      </span>
      <span class="app-brand-text demo menu-text fw-bold">@TempData.Peek("appName")</span>
    </a>
</div>
}

@if (ViewData["navbarHideToggle"] == null)
{
  <div class="layout-menu-toggle navbar-nav align-items-xl-center me-4 me-xl-0 d-xl-none">
    <a class="nav-item nav-link px-0 me-xl-6" data-no-loader="true" asp-controller="Home" asp-action="Index">
      <i class="bx bx-menu bx-md"></i>
    </a>
  </div>
}

<div class="navbar-nav-right d-flex align-items-center" id="navbar-collapse">

  <ul class="navbar-nav flex-row align-items-center ms-auto">
    
    <li class="nav-item dropdown me-4">
      <a class="btn btn-xs dropdown-toggle" href="#" id="notificationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bx bxs-bell-ring"></i>
        <span id="unreadCountBadge" class="badge bg-danger rounded-pill" style="display:none; position:relative; top:-10px; left:-5px;">0</span>
      </a>
        <div class="dropdown-menu dropdown-menu-end p-0" aria-labelledby="notificationDropdown"
             style="width: 320px; overflow: hidden;">
          <div id="notificationListWrapper" style="max-height: 380px; overflow-y: auto; overflow-x: hidden;" class="p-2">
            <ul id="notificationList" class="list-unstyled mb-0">
                <li class="text-center text-muted small py-2 no-notifications">Нет новых уведомлений</li>
            </ul>
          </div>
          <div class="p-2 border-top bg-light text-center" style="display:none;">
            <button id="markAllReadBtn" class="btn btn-sm btn-outline-primary w-100">
              Отметить все как прочитанные
            </button>
          </div>
        </div>
    </li>

    <li class="nav-item navbar-dropdown dropdown-user dropdown">
      <a class="nav-link dropdown-toggle hide-arrow p-0" href="javascript:void(0);" data-bs-toggle="dropdown">
        <div class="avatar avatar-online">
          <img src="@Url.Content(ViewBag?.UserPhotoUrl)" alt="Avatar" class="w-px-40 h-auto rounded-circle">
        </div>
      </a>
      <ul class="dropdown-menu dropdown-menu-end">
        <li>
          <a class="dropdown-item" asp-controller="Home" asp-action="Index">
            <div class="d-flex">
              <div class="flex-shrink-0 me-3">
                <div class="avatar avatar-online">
                  <img src="@Url.Content(ViewBag?.UserPhotoUrl)" alt="Avatar" class="w-px-40 h-auto rounded-circle">
                </div>
              </div>
              <div class="flex-grow-1">
                <h6 class="mb-0">@ViewBag?.UserFullName</h6>
                <small class="text-muted">@ViewBag?.UserRefCode</small>
              </div>
            </div>
          </a>
        </li>
        <li>
          <div class="dropdown-divider my-1"></div>
        </li>
        <li>
          <a class="dropdown-item" asp-controller="Dashboard" asp-action="MyProfile">
            <i class="bx bx-user bx-md me-2"></i>
            <span>Мой профиль</span>
          </a>
        </li>
        <li>
          <a class="dropdown-item" asp-controller="Dashboard" asp-action="Settings">
            <i class="bx bx-cog bx-md me-2"></i>
            <span>Настройки</span>
          </a>
        </li>
        <li>
          <a class="dropdown-item" asp-controller="Dashboard" asp-action="Payments">
            <span class="d-flex align-items-center align-middle">
              <i class="flex-shrink-0 bx bx-credit-card bx-md me-3"></i>
              <span class="flex-grow-1 align-middle">Платежи</span>
            </span>
          </a>
        </li>
        <li>
          <div class="dropdown-divider my-1"></div>
        </li>
        <li>
          <a class="dropdown-item" asp-controller="Account" asp-action="Logout">
            <i class="bx bx-power-off bx-md me-2"></i>
            <span>Выйти</span>
          </a>
        </li>
      </ul>
    </li>
  </ul>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const list = document.getElementById('notificationList');
    const badge = document.getElementById('unreadCountBadge');
    const markAllBtn = document.getElementById('markAllReadBtn');

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/notificationHub")
        .withAutomaticReconnect()
        .build();

    // 🔹 Обработка новых уведомлений
    connection.on("ReceiveNotification", function (notification) {

        const emptyItem = list.querySelector('.no-notifications');
        if (emptyItem) emptyItem.remove();

        const li = document.createElement('li');
        li.classList.add('dropdown-item', 'py-2', 'border-bottom', 'notification-item');
        li.innerHTML = `
            <div style="position: relative;">
                <small class="text-muted">${new Date(notification.createdDate).toLocaleString()}</small>
                <div class="notification-message" id="msg-${notification.id}">${notification.message}</div>

                <div class="d-flex justify-content-between align-items-center mt-1">
                    <button class="btn btn-link btn-sm p-0 text-primary toggle-details" data-id="${notification.id}">
                        Подробнее
                    </button>

                    ${
                        notification.link
                            ? `<a href="${notification.link}" class="btn btn-link btn-sm text-success p-0 ms-2">
                                   Посмотреть
                               </a>`
                            : ""
                    }
                </div>

                ${
                    notification.type === "I"
                        ? `<button class="delete-notification mark-read" data-id="${notification.id}">
                               <i class="bx bx-x"></i>
                           </button>`
                        : ""
                }
            </div>
        `;

        list.prepend(li);

        // Показываем кнопку "Отметить все как прочитанные"
        markAllBtn.closest('div').style.display = 'block';

        // Обновляем бейдж
        badge.textContent = list.querySelectorAll('li.dropdown-item').length;
        badge.style.display = 'inline-block';
    });

    // 🔹 Обновление счётчика уведомлений
    connection.on("UpdateUnreadCount", function (count) {
        if (count > 0) {
            badge.textContent = count;
            badge.style.display = 'inline-block';
            markAllBtn.closest('div').style.display = 'block';
        } else {
            badge.style.display = 'none';
            markAllBtn.closest('div').style.display = 'none';

            // Если уведомлений нет, показываем заглушку "Нет новых уведомлений"
            list.innerHTML = '<li class="text-center text-muted small py-2 no-notifications">Нет новых уведомлений</li>';
        }
    });

    // 🔹 Запуск подключения
    connection.start()
        .then(() => console.log("✅ Подключено к SignalR NotificationHub"))
        .catch(err => console.error("❌ Ошибка подключения SignalR:", err));

    // =============================
    // 🔹 Обработчики кликов по списку
    // =============================
    list.addEventListener('click', function (e) {
        const btn = e.target.closest('button');
        if (!btn) return;
        e.stopPropagation();

        // Удаление / отметка как прочитанное
        if (btn.classList.contains('mark-read')) {
            const li = btn.closest('li');
            const id = btn.dataset.id;

            fetch('/Notification/MarkAsRead?id=' + id, { method: 'POST' })
                .then(res => {
                    if (res.ok) {
                        li.remove();
                        updateBadge();
                    }
                });
        }

        // Показать / скрыть полное сообщение
        if (btn.classList.contains('toggle-details')) {
            const li = btn.closest('li');
            const msg = li.querySelector('.notification-message, .notification-full');
            if (!msg) return;

            msg.classList.toggle('notification-full');
            msg.classList.toggle('notification-message');
            btn.textContent = msg.classList.contains('notification-full') ? 'Скрыть' : 'Подробнее';
        }
    });

    // 🔹 Кнопка "Отметить все как прочитанные"
    markAllBtn.addEventListener('click', function() {
        fetch('/Notification/MarkAllAsRead', { method: 'POST' })
            .then(res => {});
    });

    function updateBadge() {
        const count = list.querySelectorAll('li.dropdown-item').length;
        badge.textContent = count;
        badge.style.display = count > 0 ? 'inline-block' : 'none';
        markAllBtn.style.display = count > 0 ? 'block' : 'none';
        markAllBtn.closest('div').style.display = count > 0 ? 'block' : 'none';

        if (count === 0) {
            list.innerHTML = '<li class="text-center text-muted small py-2 no-notifications">Нет новых уведомлений</li>';
        }
    }
});

</script>