
<style>
.notification-item {
    position: relative;
    padding-right: 30px;
    border-radius: 8px;
    background-color: #fff;
    transition: background-color 0.2s ease;
}

.notification-item:hover {
    background-color: #f8f9fa;
}

.notification-date {
    display: flex;
    align-items: center;
    font-size: 0.8rem;
    color: #6c757d;
    margin-bottom: 4px;
}

.notification-date i {
    font-size: 14px;
    margin-right: 4px;
    color: #6c757d;
}

.notification-message {
    margin-top: 6px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
}

.notification-full {
    margin-top: 6px;
    white-space: normal;
}

#markAllReadBtn {
    font-weight: 500;
}

#markAllReadBtn.btn-primary {
    background-color: #0b5ed7;
    border-color: #0a58ca;
    color: #fff;
}

#markAllReadBtn.btn-primary:hover {
    background-color: #0d6efd;
    border-color: #0d6efd;
}

.notification-actions {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
}


.delete-notification {
    position: absolute;
    top: 1px;
    right: 1px; 
    background-color: rgba(0, 0, 0, 0.05);
    border: none;
    border-radius: 50%;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease;
}

.delete-notification:hover {
    background-color: rgba(0, 0, 0, 0.15);
}

.delete-notification i {
    font-size: 16px;
    color: #333;
    pointer-events: none;
}

#notificationDropdown {
    outline: none !important;
    box-shadow: none !important;
    border: none !important;
}
#notificationDropdown:focus,
#notificationDropdown:active {
    outline: none !important;
    box-shadow: none !important;
    border: none !important;
}

@@keyframes pulseBadge {
    0% { transform: scale(1); box-shadow: 0 0 0 rgba(255,0,0,0); }
    30% { transform: scale(1.3); box-shadow: 0 0 10px rgba(255,0,0,0.6); }
    60% { transform: scale(0.9); box-shadow: 0 0 5px rgba(255,0,0,0.4); }
    100% { transform: scale(1); box-shadow: 0 0 0 rgba(255,0,0,0); }
}

.badge-animate {
    animation: pulseBadge 0.6s ease-in-out;
}
    .navbar-marquee {
        position: absolute;
        left: 0;
        right: 0;
        top: 100%;
        height: 32px;
        overflow: hidden;
        white-space: nowrap;
        display: flex;
        align-items: center;
        color: #0d6efd;
        z-index: 10;
    }

    .navbar-marquee-content {
        display: inline-block;
        flex-shrink: 0;
        padding-left: 100%;
        animation: marquee 20s linear infinite;
        font-size: 14px;
        font-weight: 500;
    }

    @@keyframes marquee {
        from

    {
        transform: translateX(0);
    }

    to {
        transform: translateX(-100%);
    }

    }
</style>

