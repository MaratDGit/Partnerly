<link rel="stylesheet"
      href="~/assets/css/navbar.css" />

<link rel="stylesheet"
      href="~/assets/css/partnerly-ai.css" />


<div class="partnerly-navbar-inner">

    <!-- =====================================================
         MOBILE MENU BUTTON
         ===================================================== -->

    <button type="button"
            class="partnerly-mobile-menu-button"
            data-mobile-toggle
            aria-label="Toggle menu">

        <i class="bx bx-menu"></i>

    </button>


    <!-- =====================================================
         LEFT SIDE
         ===================================================== -->

    <div class="partnerly-navbar-left">

        <div class="partnerly-site-search"
             data-site-search
             data-no-loader
             data-search-url="@Url.Action("Query", "Search")"
             data-empty="@Localizer["SiteSearchEmpty"]"
             data-no-results="@Localizer["SiteSearchNoResults"]">
            <i class="bx bx-search partnerly-site-search-icon"></i>
            <input type="search"
                   class="partnerly-site-search-input"
                   placeholder="@Localizer["SiteSearchPlaceholder"]"
                   autocomplete="off"
                   spellcheck="false"
                   aria-label="@Localizer["SiteSearchPlaceholder"]"
                   data-no-loader />
            <div class="partnerly-site-search-panel" hidden>
                <p class="partnerly-site-search-hint" data-site-search-hint>@Localizer["SiteSearchEmpty"]</p>
                <div class="partnerly-site-search-results" data-site-search-results></div>
            </div>
        </div>

    </div>


    <!-- =====================================================
         ACTIONS
         ===================================================== -->

    <div class="partnerly-navbar-actions">

        

        <!-- =================================================
             LANGUAGE
             ================================================= -->

        @await Html.PartialAsync("_LanguageSwitcher")

        <!-- =================================================
            THEME
            ================================================= -->

        <button type="button"
                class="partnerly-navbar-action partnerly-theme-button"
                id="partnerlyThemeButton"
                aria-label="Change theme"
                title="Change theme">

            <i class="bx bx-moon" id="partnerlyThemeIcon"></i>

        </button>


        @if (ViewBag.IsAiAssistantEnabled as bool? ?? true)
        {
        <!-- =================================================
        AI ASSISTANT
        ================================================= -->

        <button type="button"
                class="partnerly-navbar-action partnerly-ai-button"
                id="partnerlyAiButton"
                aria-label="AI Assistant"
                title="AI Assistant">

            <i class="bx bx-bot"></i>

        </button>
        }

        <!-- =================================================
             NOTIFICATIONS
             ================================================= -->

        <div class="dropdown">

            <button type="button"
                    class="partnerly-navbar-action partnerly-notification-button"
                    id="notificationDropdown"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    aria-label="Notifications">

                <i class="bx bx-bell"></i>

                <span id="unreadCountBadge"
                      class="badge bg-danger rounded-pill">
                    0
                </span>

            </button>


            <div class="dropdown-menu dropdown-menu-end partnerly-notification-dropdown"
                 aria-labelledby="notificationDropdown">


                <!-- Header -->

                <div class="partnerly-notification-header">

                    <div class="partnerly-notification-header-title">

                        <i class="bx bx-bell"></i>

                        <span>
                            @Localizer["Notifications"]
                        </span>

                    </div>

                </div>


                <!-- Notifications -->

                <div id="notificationListWrapper"
                     class="partnerly-notification-body">

                    <ul id="notificationList"
                        class="list-unstyled mb-0">

                        <li class="text-center small partnerly-no-notifications no-notifications">

                            @Localizer["NoNewNotifications"]

                        </li>

                    </ul>

                </div>


                <!-- Footer -->

                <div id="notificationFooter"
                     class="partnerly-notification-footer">

                    <button type="button"
                            id="markAllReadBtn"
                            class="btn btn-primary btn-sm w-100">

                        @Localizer["Markallasread"]

                    </button>

                </div>

            </div>

        </div>


        <!-- =================================================
             USER
             ================================================= -->

        <div class="dropdown">

            <button type="button"
                    class="nav-link dropdown-toggle hide-arrow partnerly-user-button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">

                <img src="@Url.Content(ViewBag?.UserPhotoUrl)"
                     alt="Avatar"
                     class="partnerly-user-avatar" />

            </button>


            <ul class="dropdown-menu dropdown-menu-end partnerly-user-menu">


                <!-- User Header -->

                <li>

                    <div class="partnerly-user-header">

                        <img src="@Url.Content(ViewBag?.UserPhotoUrl)"
                             alt="Avatar"
                             class="partnerly-user-header-avatar" />

                        <div class="partnerly-user-info">

                            <p class="partnerly-user-name">
                                @ViewBag?.UserFullName
                            </p>

                            <span class="partnerly-user-ref">
                                @ViewBag?.UserRefCode
                            </span>

                        </div>

                    </div>

                </li>


                <li>
                    <hr class="dropdown-divider my-1" />
                </li>


                <!-- Profile -->

                <li>

                    <a class="dropdown-item"
                       asp-controller="Dashboard"
                       asp-action="MyProfile">

                        <i class="bx bx-user"></i>

                        <span>
                            @Localizer["Myprofile"]
                        </span>

                    </a>

                </li>


                <!-- Settings -->

                <li>

                    <a class="dropdown-item"
                       asp-controller="Dashboard"
                       asp-action="Settings">

                        <i class="bx bx-cog"></i>

                        <span>
                            @Localizer["Settings"]
                        </span>

                    </a>

                </li>


                <li>
                    <hr class="dropdown-divider my-1" />
                </li>


                <!-- Logout -->

                <li>

                    <a class="dropdown-item partnerly-logout"
                       asp-controller="Account"
                       asp-action="Logout">

                        <i class="bx bx-power-off"></i>

                        <span>
                            @Localizer["Logout"]
                        </span>

                    </a>

                </li>

            </ul>

        </div>

    </div>

</div>

@if (ViewBag.IsAiAssistantEnabled as bool? ?? true)
{
<!-- =========================================================
     PARTNERLY AI ASSISTANT
     ========================================================= -->

<div id="partnerlyAiPanel"
     class="partnerly-ai-panel">

    <!-- Header -->

    <div class="partnerly-ai-header">

        <div class="partnerly-ai-header-left">

            <div class="partnerly-ai-icon">
                <i class="bx bx-bot"></i>
            </div>

            <div>

                <div class="partnerly-ai-title">
                    Partnerly AI
                </div>

                <div class="partnerly-ai-status">

                    <span class="partnerly-ai-status-dot"></span>

                    <span>AI Assistant</span>

                </div>

            </div>

        </div>


        <div class="partnerly-ai-header-actions">

            <button type="button"
                    id="partnerlyAiClear"
                    class="partnerly-ai-header-button"
                    title="Clear chat">

                <i class="bx bx-trash"></i>

            </button>

            <button type="button"
                    id="partnerlyAiClose"
                    class="partnerly-ai-header-button"
                    title="Close">

                <i class="bx bx-x"></i>

            </button>

        </div>

    </div>


    <!-- Chat -->

    <div id="partnerlyAiChat"
         class="partnerly-ai-chat">

        <div id="partnerlyAiWelcome"
             class="partnerly-ai-welcome">

            <div class="partnerly-ai-welcome-icon">

                <i class="bx bx-bot"></i>

            </div>

            <h5>
                How can I help you?
            </h5>

            <p>
                Ask Partnerly AI about your account,
                tickets, payments, teams and more.
            </p>


            <div class="partnerly-ai-suggestions">

                <button type="button"
                        class="partnerly-ai-suggestion"
                        data-message="Show me my open tickets">

                    <i class="bx bx-task"></i>

                    <span>
                        Show my open tickets
                    </span>

                </button>


                <button type="button"
                        class="partnerly-ai-suggestion"
                        data-message="Show my profile information">

                    <i class="bx bx-user"></i>

                    <span>
                        Show my profile
                    </span>

                </button>


                <button type="button"
                        class="partnerly-ai-suggestion"
                        data-message="Show my latest payments">

                    <i class="bx bx-credit-card"></i>

                    <span>
                        Show my latest payments
                    </span>

                </button>


                <button type="button"
                        class="partnerly-ai-suggestion"
                        data-message="Who is in my team?">

                    <i class="bx bx-group"></i>

                    <span>
                        Show my team
                    </span>

                </button>

            </div>

        </div>

    </div>


    <!-- Input -->

    <div class="partnerly-ai-input-wrapper">

        <div class="partnerly-ai-input-box">

            <textarea id="partnerlyAiInput"
                      rows="1"
                      maxlength="4000"
                      placeholder="Ask Partnerly AI..."></textarea>


            <button type="button"
                    id="partnerlyAiSend"
                    class="partnerly-ai-send"
                    disabled>

                <i class="bx bx-send"></i>

            </button>

        </div>


        <div class="partnerly-ai-input-footer">

            <span>
                AI can make mistakes. Check important information.
            </span>

            <span id="partnerlyAiCounter">
                0 / 4000
            </span>

        </div>

    </div>

</div>
}


<!-- =========================================================
SIGNALR
========================================================= -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

<script>

    const notificationLocalization = {

        noNotifications:
            '@Html.Raw(Localizer["NoNewNotifications"])',

        markAllAsRead:
            '@Html.Raw(Localizer["Markallasread"])',

        details:
            '@Html.Raw(Localizer["Details"])',

        hide:
            '@Html.Raw(Localizer["Hide"])',

        view:
            '@Html.Raw(Localizer["View"])',

        connected:
            '@Html.Raw(Localizer["ConnectedToNotificationHub"])',

        connectionError:
            '@Html.Raw(Localizer["ErrorConnectionSignalR"])'

    };

    const notificationTemplates = {
        UserRegistrationNotification: @Html.Raw(Json.Serialize(Localizer["UserRegistrationNotification"].Value)),
        NewTicketToEmployeeNotification: @Html.Raw(Json.Serialize(Localizer["NewTicketToEmployeeNotification"].Value)),
        TicketStartedNotification: @Html.Raw(Json.Serialize(Localizer["TicketStartedNotification"].Value)),
        TicketClosedNotification: @Html.Raw(Json.Serialize(Localizer["TicketClosedNotification"].Value)),
        TicketReopenedNotification: @Html.Raw(Json.Serialize(Localizer["TicketReopenedNotification"].Value))
    };

    function formatNotificationMessage(stored) {
        if (!stored || stored.indexOf("$N:") !== 0) {
            return stored || "";
        }

        var rest = stored.substring(3);
        var parts = rest.split("|");
        var template = notificationTemplates[parts[0]];
        if (!template) {
            return stored;
        }

        var text = template;
        for (var i = 1; i < parts.length; i++) {
            text = text.replace("{" + (i - 1) + "}", parts[i]);
        }

        return text;
    }

    function escapeNotificationHtml(value) {
        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
    }

    const currentCulture =
        '@CultureInfo.CurrentUICulture.Name';

    document.addEventListener('DOMContentLoaded', function () {

            const list =
                document.getElementById('notificationList');

            const badge =
                document.getElementById('unreadCountBadge');

            const markAllBtn =
                document.getElementById('markAllReadBtn');

            const notificationFooter =
                document.getElementById('notificationFooter');


            if (!list || !badge || !markAllBtn) {
                return;
            }


            /*
             * =================================================
             * SignalR Connection
             * =================================================
             */

            const connection =
                new signalR.HubConnectionBuilder()
                    .withUrl("/notificationHub")
                    .withAutomaticReconnect()
                    .build();


            /*
             * =================================================
             * New Notification
             * =================================================
             */

            connection.on(
                "ReceiveNotification",
                function (notification) {

                    const emptyItem =
                        list.querySelector('.no-notifications');

                    if (emptyItem) {
                        emptyItem.remove();
                    }


                    const li =
                        document.createElement('li');


                    /*
                     * Notification date
                     */

                    let date =
                        new Date(notification.createdDate);


                    const created =
                        date.toLocaleString(
                            currentCulture,
                            {
                                timeZone: window.partnerlyTimeZone || 'Asia/Yerevan',
                                day: '2-digit',
                                month: 'long',
                                year: 'numeric',
                                hour: '2-digit',
                                minute: '2-digit'
                            }
                        );


                    /*
                     * Notification item
                     */

                    li.classList.add(
                        'dropdown-item',
                        'py-2',
                        'border-bottom',
                        'notification-item'
                    );


                    li.innerHTML = `

                        <div>

                            <div class="notification-date">

                                <i class="bx bx-calendar"></i>

                                <span>
                                    ${created.replace(' г.', ' г.')}
                                </span>

                            </div>


                            <div class="notification-message"
                                 id="msg-${notification.id}">

                                ${escapeNotificationHtml(formatNotificationMessage(notification.message))}

                            </div>


                            <div class="notification-actions">

                                <button
                                    type="button"
                                    class="btn btn-link btn-sm p-0 text-primary toggle-details"
                                    data-id="${notification.id}">

                                    ${notificationLocalization.details}

                                </button>


                                ${
                                    notification.link
                                        ? `
                                            <a href="${notification.link}"
                                               class="btn btn-link btn-sm text-secondary p-0">

                                                ${notificationLocalization.view}

                                            </a>
                                          `
                                        : ""
                                }

                            </div>


                            ${
                                notification.type === "I"
                                    ? `
                                        <button
                                            type="button"
                                            class="delete-notification mark-read"
                                            data-id="${notification.id}">

                                            <i class="bx bx-x"></i>

                                        </button>
                                      `
                                    : ""
                            }

                        </div>

                    `;


                    list.prepend(li);


                    notificationFooter.style.display =
                        'block';


                    badge.textContent =
                        list.querySelectorAll(
                            'li.dropdown-item'
                        ).length;


                    badge.style.display =
                        'flex';


                    animateBadge(badge);

                }
            );


            /*
             * =================================================
             * Badge animation
             * =================================================
             */

            function animateBadge(element) {

                element.classList.remove(
                    "badge-animate"
                );


                void element.offsetWidth;


                element.classList.add(
                    "badge-animate"
                );

            }


            /*
             * =================================================
             * Periodic badge animation
             * =================================================
             */

            setInterval(
                function () {

                    const currentBadge =
                        document.getElementById(
                            "unreadCountBadge"
                        );


                    if (
                        currentBadge &&
                        currentBadge.textContent !== "0"
                    ) {

                        animateBadge(currentBadge);

                    }

                },
                5000
            );


            /*
             * =================================================
             * Update unread count
             * =================================================
             */

            connection.on(
                "UpdateUnreadCount",
                function (count) {

                    if (count > 0) {

                        badge.textContent =
                            count;

                        badge.style.display =
                            'flex';

                        notificationFooter.style.display =
                            'block';

                    }
                    else {

                        badge.style.display =
                            'none';

                        notificationFooter.style.display =
                            'none';


                        list.innerHTML = `

                            <li class="text-center small partnerly-no-notifications no-notifications">

                                ${notificationLocalization.noNotifications}

                            </li>

                        `;

                    }

                }
            );


            /*
             * =================================================
             * Start SignalR
             * ================================================= */

            connection.start()
                .then(function () {

                    console.log(
                        "SignalR connected"
                    );

                    console.log(
                        "Connection ID:",
                        connection.connectionId
                    );

                    console.log(
                        "State:",
                        connection.state
                    );

                })
                .catch(function (error) {

                    console.error(
                        "SignalR connection error:",
                        error
                    );

                });


            /*
             * =================================================
             * Notification actions
             * ================================================= */

            list.addEventListener(
                'click',
                function (event) {

                    const button =
                        event.target.closest('button');


                    if (!button) {
                        return;
                    }


                    event.stopPropagation();


                    /*
                     * Mark notification as read
                     */

                    if (
                        button.classList.contains(
                            'mark-read'
                        )
                    ) {

                        const li =
                            button.closest('li');

                        const id =
                            button.dataset.id;


                        fetch(
                            '/Notification/MarkAsRead?id=' +
                            id,
                            {
                                method: 'POST'
                            }
                        )
                        .then(function (response) {

                            if (response.ok) {

                                li.remove();

                                updateBadge();

                            }

                        });

                    }


                    /*
                     * Toggle notification details
                     */

                    if (
                        button.classList.contains(
                            'toggle-details'
                        )
                    ) {

                        const li =
                            button.closest('li');


                        const message =
                            li.querySelector(
                                '.notification-message, .notification-full'
                            );


                        if (!message) {
                            return;
                        }


                        message.classList.toggle(
                            'notification-full'
                        );

                        message.classList.toggle(
                            'notification-message'
                        );


                        button.textContent =
                            message.classList.contains(
                                'notification-full'
                            )
                                ? notificationLocalization.hide
                                : notificationLocalization.details;

                    }

                }
            );


            /*
             * =================================================
             * Mark all as read
             * ================================================= */

            markAllBtn.addEventListener(
                'click',
                function () {

                    fetch(
                        '/Notification/MarkAllAsRead',
                        {
                            method: 'POST'
                        }
                    )
                    .then(function () {

                        /*
                         * SignalR will update
                         * the unread counter.
                         */

                    });

                }
            );


            /*
             * =================================================
             * Update local badge
             * ================================================= */

            function updateBadge() {

                const count =
                    list.querySelectorAll(
                        'li.dropdown-item'
                    ).length;


                badge.textContent =
                    count;


                badge.style.display =
                    count > 0
                        ? 'flex'
                        : 'none';


                notificationFooter.style.display =
                    count > 0
                        ? 'block'
                        : 'none';


                if (count === 0) {

                    list.innerHTML = `

                        <li class="text-center small partnerly-no-notifications no-notifications">

                            ${notificationLocalization.noNotifications}

                        </li>

                    `;

                }

            }

        }
    );

    document.addEventListener("DOMContentLoaded", function () {

        const aiButton =
            document.getElementById("partnerlyAiButton");

        const aiPanel =
            document.getElementById("partnerlyAiPanel");

        const aiClose =
            document.getElementById("partnerlyAiClose");

        const aiClear =
            document.getElementById("partnerlyAiClear");

        const aiChat =
            document.getElementById("partnerlyAiChat");

        const aiWelcome =
            document.getElementById("partnerlyAiWelcome");

        const aiInput =
            document.getElementById("partnerlyAiInput");

        const aiSend =
            document.getElementById("partnerlyAiSend");

        const aiCounter =
            document.getElementById("partnerlyAiCounter");


        if (
            !aiButton ||
            !aiPanel ||
            !aiInput ||
            !aiSend
        ) {
            return;
        }


        /* =====================================================
           OPEN / CLOSE
           ===================================================== */

        function openAI() {

            aiPanel.classList.add("show");

            setTimeout(function () {
                aiInput.focus();
            }, 150);

        }


        function closeAI() {

            aiPanel.classList.remove("show");

        }


        aiButton.addEventListener(
            "click",
            function () {

                if (aiPanel.classList.contains("show")) {
                    closeAI();
                }
                else {
                    openAI();
                }

            }
        );


        aiClose?.addEventListener(
            "click",
            closeAI
        );


        /* =====================================================
           INPUT
           ===================================================== */

        function updateInput() {

            const length =
                aiInput.value.length;

            aiCounter.textContent =
                `${length} / 4000`;

            aiSend.disabled =
                aiInput.value.trim().length === 0;

            aiInput.style.height = "auto";

            aiInput.style.height =
                Math.min(
                    aiInput.scrollHeight,
                    110
                ) + "px";
        }


        aiInput.addEventListener(
            "input",
            updateInput
        );


        /* =====================================================
           SCROLL
           ===================================================== */

        function scrollToBottom() {

            aiChat.scrollTop =
                aiChat.scrollHeight;

        }


        /* =====================================================
           ADD MESSAGE
           ===================================================== */

        function addMessage(
            message,
            type
        ) {

            if (aiWelcome) {
                aiWelcome.style.display =
                    "none";
            }


            const wrapper =
                document.createElement("div");

            wrapper.className =
                `partnerly-ai-message ${type}`;


            const avatar =
                document.createElement("div");

            avatar.className =
                "partnerly-ai-message-avatar";


            avatar.innerHTML =
                type === "user"
                    ? '<i class="bx bx-user"></i>'
                    : '<i class="bx bx-bot"></i>';


            const content =
                document.createElement("div");

            content.className =
                "partnerly-ai-message-content";


            const name =
                document.createElement("div");

            name.className =
                "partnerly-ai-message-name";

            name.textContent =
                type === "user"
                    ? "You"
                    : "Partnerly AI";


            const text =
                document.createElement("div");

            text.className =
                "partnerly-ai-message-text";

            text.textContent =
                message;


            content.appendChild(name);
            content.appendChild(text);

            wrapper.appendChild(avatar);
            wrapper.appendChild(content);

            aiChat.appendChild(wrapper);

            scrollToBottom();

            return wrapper;
        }


        /* =====================================================
           TYPING
           ===================================================== */

        function showTyping() {

            const wrapper =
                document.createElement("div");

            wrapper.id =
                "partnerlyAiTyping";

            wrapper.className =
                "partnerly-ai-message assistant";


            wrapper.innerHTML = `

                <div class="partnerly-ai-message-avatar">
                    <i class="bx bx-bot"></i>
                </div>

                <div class="partnerly-ai-message-content">

                    <div class="partnerly-ai-message-name">
                        Partnerly AI
                    </div>

                    <div class="partnerly-ai-typing">

                        <span></span>
                        <span></span>
                        <span></span>

                    </div>

                </div>

            `;


            aiChat.appendChild(wrapper);

            scrollToBottom();

            return wrapper;
        }


        /* =====================================================
           SEND
           ===================================================== */

        async function sendMessage() {

            const message =
                aiInput.value.trim();


            if (!message) {
                return;
            }


            addMessage(
                message,
                "user"
            );


            aiInput.value = "";

            updateInput();


            const typing =
                showTyping();


            aiInput.disabled = true;
            aiSend.disabled = true;


            try {

                const response =
                    await fetch(
                        "/AI/Ask",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body: JSON.stringify({
                                message: message
                            })
                        }
                    );


                const data =
                    await response.json();


                typing.remove();


                if (
                    !response.ok ||
                    !data.success
                ) {

                    addMessage(
                        data.message ||
                        "Unable to process your request.",
                        "assistant"
                    );

                    return;
                }


                addMessage(
                    data.answer ||
                    "No response was returned.",
                    "assistant"
                );

            }
            catch (error) {

                console.error(
                    "Partnerly AI error:",
                    error
                );


                typing.remove();


                addMessage(
                    "Unable to connect to Partnerly AI.",
                    "assistant"
                );

            }
            finally {

                aiInput.disabled = false;

                updateInput();

                aiInput.focus();

            }
        }


        aiSend.addEventListener(
            "click",
            sendMessage
        );


        /* =====================================================
           ENTER
           ===================================================== */

        aiInput.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Enter" &&
                    !event.shiftKey
                ) {

                    event.preventDefault();

                    if (!aiSend.disabled) {
                        sendMessage();
                    }

                }

            }
        );


        /* =====================================================
           SUGGESTIONS
           ===================================================== */

        document
            .querySelectorAll(
                ".partnerly-ai-suggestion"
            )
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        aiInput.value =
                            this.dataset.message || "";

                        updateInput();

                        aiInput.focus();

                    }
                );

            });


        /* =====================================================
           CLEAR
           ===================================================== */

        aiClear?.addEventListener(
            "click",
            function () {

                aiChat.innerHTML = "";


                if (aiWelcome) {

                    aiWelcome.style.display =
                        "";

                    aiChat.appendChild(
                        aiWelcome
                    );

                }


                aiInput.value = "";

                updateInput();

                aiInput.focus();

            }
        );


        updateInput();

    });

</script>