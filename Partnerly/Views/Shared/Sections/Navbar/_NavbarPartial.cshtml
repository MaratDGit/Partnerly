<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>

            const notificationLocalization = {
            noNotifications: '@Html.Raw(Localizer["NoNewNotifications"])',
            markAllAsRead: '@Html.Raw(Localizer["Markallasread"])',
            details: '@Html.Raw(Localizer["Details"])',
            hide: '@Html.Raw(Localizer["Hide"])',
            view: '@Html.Raw(Localizer["View"])',
            connected: '@Html.Raw(Localizer["ConnectedToNotificationHub"])',
            connectionError: '@Html.Raw(Localizer["ErrorConnectionSignalR"])'
        };
        const currentCulture = '@CultureInfo.CurrentUICulture.Name';

    document.addEventListener('DOMContentLoaded', function() {
        const list = document.getElementById('notificationList');
        const badge = document.getElementById('unreadCountBadge');
        const markAllBtn = document.getElementById('markAllReadBtn');

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .withAutomaticReconnect()
            .build();

        // Processing new notifications
        connection.on("ReceiveNotification", function (notification) {

            const emptyItem = list.querySelector('.no-notifications');
            if (emptyItem) emptyItem.remove();

            const li = document.createElement('li');

            let date = new Date(notification.createdDate);
            date = new Date(date.getTime() + 4 * 60 * 60 * 1000);

            const created = date.toLocaleString(currentCulture, {
                day: '2-digit',
                month: 'long',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });

            li.classList.add(
                'dropdown-item',
                'py-2',
                'border-bottom',
                'notification-item'
            );

            li.innerHTML = `
                <div>
                    <div class="notification-date">
                        <i class="bx bx-calendar"></i>
                        <span>${created.replace(' г.', ' г.')}</span>
                    </div>

                    <div class="notification-message" id="msg-${notification.id}">
                        ${notification.message}
                    </div>

                    <div class="notification-actions">
                        <button
                            class="btn btn-link btn-sm p-0 text-primary toggle-details"
                            data-id="${notification.id}">
                            ${notificationLocalization.details}
                        </button>

                        ${
                            notification.link
                                ? `<a href="${notification.link}"
                                      class="btn btn-link btn-sm text-secondary p-0">
                                       ${notificationLocalization.view}
                                   </a>`
                                : ""
                        }
                    </div>

                    ${
                        notification.type === "I"
                            ? `<button
                                   class="delete-notification mark-read"
                                   data-id="${notification.id}">
                                   <i class="bx bx-x"></i>
                               </button>`
                            : ""
                    }
                </div>
            `;

            list.prepend(li);

            markAllBtn.closest('div').style.display = 'block';

            badge.textContent =
                list.querySelectorAll('li.dropdown-item').length;

            badge.style.display = 'inline-block';
        });

        function animateBadge(badge) {
            badge.classList.remove("badge-animate");

            void badge.offsetWidth;

            badge.classList.add("badge-animate");
        }

        setInterval(() => {
            const badge = document.getElementById("unreadCountBadge");

            if (badge && badge.textContent !== "0") {
                animateBadge(badge);
            }
        }, 5000);

        // Updating the notification counter
        connection.on("UpdateUnreadCount", function (count) {

            if (count > 0) {

                badge.textContent = count;
                badge.style.display = 'inline-block';

                markAllBtn.closest('div').style.display = 'block';

            } else {

                badge.style.display = 'none';
                markAllBtn.closest('div').style.display = 'none';

                list.innerHTML = `
                    <li class="text-center text-muted small py-2 no-notifications">
                        ${notificationLocalization.noNotifications}
                    </li>`;
            }
        });

        // Start Connection
        connection.start()
            .then(() =>
                console.log(notificationLocalization.connected)
            )
            .catch(err =>
                console.error(
                    notificationLocalization.connectionError,
                    err
                )
            );

        list.addEventListener('click', function(e) {

            const btn = e.target.closest('button');

            if (!btn) return;

            e.stopPropagation();

            if (btn.classList.contains('mark-read')) {

                const li = btn.closest('li');
                const id = btn.dataset.id;

                fetch('/Notification/MarkAsRead?id=' + id, {
                    method: 'POST'
                })
                .then(res => {

                    if (res.ok) {
                        li.remove();
                        updateBadge();
                    }

                });
            }

            if (btn.classList.contains('toggle-details')) {

                const li = btn.closest('li');

                const msg = li.querySelector(
                    '.notification-message, .notification-full'
                );

                if (!msg) return;

                msg.classList.toggle('notification-full');
                msg.classList.toggle('notification-message');

                btn.textContent =
                    msg.classList.contains('notification-full')
                        ? notificationLocalization.hide
                        : notificationLocalization.details;
            }
        });

        markAllBtn.addEventListener('click', function() {

            fetch('/Notification/MarkAllAsRead', {
                method: 'POST'
            })
            .then(res => {});
        });

        function updateBadge() {

            const count =
                list.querySelectorAll('li.dropdown-item').length;

            badge.textContent = count;

            badge.style.display =
                count > 0 ? 'inline-block' : 'none';

            markAllBtn.style.display =
                count > 0 ? 'block' : 'none';

            markAllBtn.closest('div').style.display =
                count > 0 ? 'block' : 'none';

            if (count === 0) {

                list.innerHTML = `
                    <li class="text-center text-muted small py-2 no-notifications">
                        ${notificationLocalization.noNotifications}
                    </li>`;
            }
        }
    });

</script>