@using System.Linq
@using Partnerly.Automation.Abstractions
@using Partnerly.Automation.Persistence
@using Partnerly.Automation.Persistence.Entities
@inject IAutomationStore AutomationStore
@inject IAutomationAccessService AutomationAccess
@{
    TempData.Keep();

    string currentPage = ViewContext.HttpContext.Request.Path.ToString();
    var permissions = ViewData["Permissions"] as HashSet<string> ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    bool Can(string code) => permissions.Contains(code);
    bool showSettings =
        Can("system_settings.view") ||
        Can("roles.view") ||
        Can("users.view") ||
        Can("user_groups.view") ||
        Can("support_tickets.view") ||
        Can("email_templates.view") ||
        Can("notifications.view") ||
        Can("logs.view") ||
        Can("attachments.view");
    Guid.TryParse(Context.Request.Query["edit"], out var editAgentId);
    var agentMenu = new List<(Guid Id, string Name, bool Live, string Ago)>();
    if (Can("automation.view") && AutomationAccess.CurrentUserId != Guid.Empty)
    {
        var agentsQuery = AutomationStore.QueryDefinitions().Where(item => !item.IsDeleted);
        if (!AutomationAccess.CanManage)
        {
            var owner = AutomationAccess.CurrentUserId;
            agentsQuery = agentsQuery.Where(item => item.OwnerUserId == owner);
        }

        var definitions = agentsQuery
            .OrderBy(item => item.Name)
            .Take(40)
            .Select(item => new { item.Id, item.Name, item.UpdatedDate, item.CreatedDate })
            .ToList();

        var agentIds = definitions.Select(item => item.Id).ToList();
        var liveIds = new HashSet<Guid>();
        var lastAction = new Dictionary<Guid, DateTime>();
        if (agentIds.Count > 0)
        {
            liveIds = AutomationStore.QueryRuns()
                .Where(run => agentIds.Contains(run.AutomationId)
                    && (run.Status == AutomationStatuses.Queued
                        || run.Status == AutomationStatuses.Running
                        || run.Status == AutomationStatuses.Waiting))
                .Select(run => run.AutomationId)
                .Distinct()
                .ToList()
                .ToHashSet();

            lastAction = AutomationStore.QueryRuns()
                .Where(run => agentIds.Contains(run.AutomationId))
                .GroupBy(run => run.AutomationId)
                .Select(group => new
                {
                    Id = group.Key,
                    At = group.Max(run => run.EndedAt ?? run.StartedAt ?? run.CreatedDate)
                })
                .ToList()
                .ToDictionary(item => item.Id, item => item.At);
        }

        string AgentAgo(DateTime at)
        {
            var utc = at.Kind == DateTimeKind.Local ? at.ToUniversalTime() : DateTime.SpecifyKind(at, DateTimeKind.Utc);
            var span = DateTime.UtcNow - utc;
            if (span.Ticks < 0)
            {
                span = TimeSpan.Zero;
            }

            if (span.TotalSeconds < 60)
            {
                return Math.Max(1, (int)span.TotalSeconds) + "s";
            }

            if (span.TotalMinutes < 60)
            {
                return (int)span.TotalMinutes + "m";
            }

            if (span.TotalHours < 24)
            {
                return (int)span.TotalHours + "h";
            }

            if (span.TotalDays < 7)
            {
                return (int)span.TotalDays + "d";
            }

            if (span.TotalDays < 30)
            {
                return (int)(span.TotalDays / 7) + "w";
            }

            if (span.TotalDays < 365)
            {
                return (int)(span.TotalDays / 30) + "mo";
            }

            return (int)(span.TotalDays / 365) + "y";
        }

        foreach (var item in definitions)
        {
            var at = lastAction.TryGetValue(item.Id, out var runAt)
                ? runAt
                : (item.UpdatedDate != default ? item.UpdatedDate : item.CreatedDate);
            agentMenu.Add((item.Id, item.Name, liveIds.Contains(item.Id), AgentAgo(at)));
        }
    }
}

