<script>

    document.addEventListener('DOMContentLoaded', function () {

        const STORAGE_KEY = 'partnerly-menu-sections';

        const sections = document.querySelectorAll(
            '[data-menu-section-group]'
        );


        let savedState = {};


        // Restore saved state

        try {

            savedState = JSON.parse(
                localStorage.getItem(STORAGE_KEY) || '{}'
            );

        }
        catch (error) {

            savedState = {};

        }


        function setSectionState(
            group,
            expanded,
            save = true
        ) {

            const button = group.querySelector(
                '[data-menu-section]'
            );

            const content = group.querySelector(
                '[data-menu-section-content]'
            );


            if (!button || !content) {
                return;
            }


            button.setAttribute(
                'aria-expanded',
                expanded ? 'true' : 'false'
            );


            group.classList.toggle(
                'is-collapsed',
                !expanded
            );


            if (save) {

                const key =
                    button.getAttribute(
                        'data-menu-section'
                    );


                savedState[key] = expanded;


                localStorage.setItem(
                    STORAGE_KEY,
                    JSON.stringify(savedState)
                );

            }

        }


        sections.forEach(function (group) {

            const button = group.querySelector(
                '[data-menu-section]'
            );


            if (!button) {
                return;
            }


            const key =
                button.getAttribute(
                    'data-menu-section'
                );


            // Default state = OPEN

            let expanded = true;


            // Restore user's choice

            if (
                Object.prototype.hasOwnProperty.call(
                    savedState,
                    key
                )
            ) {

                expanded = savedState[key];

            }


            // Find active menu item

            const activeItem =
                group.querySelector(
                    '.partnerly-menu-section-content .partnerly-menu-item.active'
                );


            // Always open section
            // containing current page

            if (activeItem) {

                expanded = true;

            }


            // Apply initial state

            setSectionState(
                group,
                expanded,
                false
            );


            // Click

            button.addEventListener(
                'click',
                function () {

                    if (
                        document.body.classList.contains(
                            'partnerly-sidebar-collapsed'
                        ) &&
                        window.innerWidth > 1199.98
                    ) {
                        return;
                    }

                    const isExpanded =
                        button.getAttribute(
                            'aria-expanded'
                        ) === 'true';


                    setSectionState(
                        group,
                        !isExpanded,
                        true
                    );

                }
            );


            // Keyboard support

            button.addEventListener(
                'keydown',
                function (event) {

                    if (
                        event.key === 'Enter' ||
                        event.key === ' '
                    ) {

                        event.preventDefault();

                        button.click();

                    }

                }
            );

        });


        const agentsGroup = document.querySelector(
            '[data-menu-section-group="agents"]'
        );

        if (agentsGroup) {

            const agentsOpenLink = agentsGroup.querySelector(
                '[data-agents-open]'
            );

            if (agentsOpenLink) {

                agentsOpenLink.addEventListener(
                    'click',
                    function (event) {

                        if (
                            document.body.classList.contains(
                                'partnerly-sidebar-collapsed'
                            ) &&
                            window.innerWidth > 1199.98
                        ) {
                            return;
                        }

                        const agentsButton = agentsGroup.querySelector(
                            '[data-menu-section="agents"]'
                        );

                        if (agentsButton) {
                            setSectionState(
                                agentsGroup,
                                true,
                                true
                            );
                        }

                        if (
                            window.location.pathname.indexOf(
                                '/Automation'
                            ) === 0
                        ) {
                            event.preventDefault();
                        }

                    }
                );

            }

            function agentNameOf(row) {

                const text = row.querySelector(
                    '.partnerly-menu-text'
                );
                return text ? text.textContent.trim() : '';

            }

            function sortAgentRows(list) {

                const rows = Array.prototype.slice.call(
                    list.querySelectorAll('[data-agent-id]')
                );

                rows.sort(function (left, right) {
                    return agentNameOf(left).localeCompare(
                        agentNameOf(right)
                    );
                });

                rows.forEach(function (row) {
                    list.appendChild(row);
                });

            }

            window.PartnerlyAgentsMenu = {

                add: function (item) {

                    if (!item || !item.id) {
                        return;
                    }

                    const list = agentsGroup.querySelector(
                        '[data-menu-section-content="agents"]'
                    );

                    if (!list) {
                        return;
                    }

                    const id = String(item.id);
                    const name = item.name || '';
                    let row = list.querySelector(
                        '[data-agent-id="' + id + '"]'
                    );

                    if (!row) {

                        row = document.createElement('li');
                        row.className =
                            'partnerly-menu-item partnerly-menu-agents-sub-item';
                        row.setAttribute('data-agent-id', id);
                        row.setAttribute(
                            'data-agent-active',
                            item.isActive === false ? 'false' : 'true'
                        );
                        row.innerHTML =
                            '<a href="/Automation/Builder/' +
                            encodeURIComponent(id) +
                            '" class="partnerly-menu-link" title="">' +
                            '<span class="partnerly-menu-agents-dot ' +
                            (item.isActive === false ? 'is-off' : 'is-on') +
                            '" aria-hidden="true"></span>' +
                            '<span class="partnerly-menu-text"></span>' +
                            '<span class="partnerly-menu-agents-ago">1s</span>' +
                            '</a>';
                        list.appendChild(row);

                    }

                    const link = row.querySelector('.partnerly-menu-link');
                    const text = row.querySelector('.partnerly-menu-text');

                    if (link) {
                        link.setAttribute('title', name);
                        link.setAttribute(
                            'href',
                            '/Automation/Builder/' + encodeURIComponent(id)
                        );
                    }

                    if (text) {
                        text.textContent = name;
                    }

                    if (item.isActive === false) {
                        this.setActive(id, false);
                    } else if (item.isActive === true) {
                        this.setActive(id, true);
                    }

                    sortAgentRows(list);
                    setSectionState(agentsGroup, true, true);

                },

                rename: function (id, name) {

                    if (!id) {
                        return;
                    }

                    this.add({ id: id, name: name });

                },

                remove: function (id) {

                    if (!id) {
                        return;
                    }

                    const row = agentsGroup.querySelector(
                        '[data-agent-id="' + String(id) + '"]'
                    );

                    if (row) {
                        row.remove();
                    }

                },

                setActive: function (id, isActive) {

                    if (!id) {
                        return;
                    }

                    const row = agentsGroup.querySelector(
                        '[data-agent-id="' + String(id) + '"]'
                    );

                    if (!row) {
                        return;
                    }

                    row.setAttribute(
                        'data-agent-active',
                        isActive ? 'true' : 'false'
                    );

                    const dot = row.querySelector(
                        '.partnerly-menu-agents-dot'
                    );

                    if (dot) {
                        dot.classList.toggle('is-on', !!isActive);
                        dot.classList.toggle('is-off', !isActive);
                    }

                }

            };

            const list = agentsGroup.querySelector(
                '[data-menu-section-content="agents"]'
            );
            const canEdit =
                agentsGroup.getAttribute('data-can-agent-edit') === 'true';
            const canDelete =
                agentsGroup.getAttribute('data-can-agent-delete') === 'true';

            if (list && (canEdit || canDelete)) {

                const context = document.createElement('div');
                context.className = 'partnerly-agents-context';
                context.hidden = true;
                context.innerHTML =
                    '<button type="button" data-agent-action="rename"></button>' +
                    '<button type="button" data-agent-action="pause"></button>' +
                    '<button type="button" data-agent-action="start"></button>' +
                    '<button type="button" data-agent-action="delete" class="is-danger"></button>';
                context.querySelector('[data-agent-action="rename"]').textContent =
                    agentsGroup.getAttribute('data-i18n-rename') || 'Rename';
                context.querySelector('[data-agent-action="pause"]').textContent =
                    agentsGroup.getAttribute('data-i18n-pause') || 'Pause';
                context.querySelector('[data-agent-action="start"]').textContent =
                    agentsGroup.getAttribute('data-i18n-start') || 'Start';
                context.querySelector('[data-agent-action="delete"]').textContent =
                    agentsGroup.getAttribute('data-i18n-delete') || 'Delete';
                document.body.appendChild(context);

                let contextRow = null;
                let renamingInput = null;

                function agentToken() {
                    const input = agentsGroup.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    );
                    return input ? input.value : '';
                }

                function hideContext() {
                    context.hidden = true;
                    contextRow = null;
                }

                function placeContext(x, y) {
                    context.hidden = false;
                    const width = context.offsetWidth;
                    const height = context.offsetHeight;
                    const left = Math.min(
                        x,
                        window.innerWidth - width - 8
                    );
                    const top = Math.min(
                        y,
                        window.innerHeight - height - 8
                    );
                    context.style.left = Math.max(8, left) + 'px';
                    context.style.top = Math.max(8, top) + 'px';
                }

                function postAgent(url, extra) {
                    const data = new FormData();
                    if (extra) {
                        Object.keys(extra).forEach(function (key) {
                            data.append(key, extra[key]);
                        });
                    }
                    return fetch(url, {
                        method: 'POST',
                        body: data,
                        credentials: 'same-origin',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'RequestVerificationToken': agentToken()
                        }
                    }).then(function (response) {
                        return response.text().then(function (text) {
                            let payload = {};
                            try {
                                payload = text ? JSON.parse(text) : {};
                            } catch (err) {
                                payload = { message: text };
                            }
                            if (!response.ok || payload.success === false) {
                                throw new Error(
                                    payload.message ||
                                    response.statusText ||
                                    'Error'
                                );
                            }
                            return payload;
                        });
                    });
                }

                function actionUrl(kind, id) {
                    const base =
                        agentsGroup.getAttribute('data-url-' + kind) || '';
                    return base.replace(/\/?$/, '/') + encodeURIComponent(id);
                }

                function finishRename(input, save) {
                    if (!input || input !== renamingInput) {
                        return;
                    }
                    const row = input.closest('[data-agent-id]');
                    const text = row
                        ? row.querySelector('.partnerly-menu-text')
                        : null;
                    const previous = input.getAttribute('data-previous') || '';
                    const next = (input.value || '').trim();
                    renamingInput = null;
                    input.remove();
                    if (text) {
                        text.hidden = false;
                    }
                    if (row) {
                        row.classList.remove('is-renaming');
                    }
                    if (!save || !row || !next || next === previous) {
                        if (text && !next) {
                            text.textContent = previous;
                        }
                        return;
                    }
                    if (text) {
                        text.textContent = next;
                    }
                    postAgent(actionUrl('rename', row.getAttribute('data-agent-id')), {
                        name: next
                    }).then(function (payload) {
                        window.PartnerlyAgentsMenu.rename(
                            payload.id,
                            payload.name || next
                        );
                        const form = document.getElementById(
                            'automationBuilderForm'
                        );
                        if (
                            form &&
                            form.getAttribute('data-builder-id') ===
                                String(payload.id)
                        ) {
                            const nameInput = form.querySelector(
                                'input[name="name"]'
                            );
                            if (nameInput) {
                                nameInput.value = payload.name || next;
                            }
                        }
                    }).catch(function () {
                        if (text) {
                            text.textContent = previous;
                        }
                    });
                }

                function startRename(row) {
                    if (!row || renamingInput) {
                        finishRename(renamingInput, true);
                    }
                    const text = row.querySelector('.partnerly-menu-text');
                    const link = row.querySelector('.partnerly-menu-link');
                    if (!text || !link) {
                        return;
                    }
                    const input = document.createElement('input');
                    input.type = 'text';
                    input.className = 'partnerly-menu-agents-rename';
                    input.maxLength = 200;
                    input.value = text.textContent.trim();
                    input.setAttribute('data-previous', input.value);
                    text.hidden = true;
                    link.insertBefore(input, text);
                    row.classList.add('is-renaming');
                    renamingInput = input;
                    input.focus();
                    input.select();
                    input.addEventListener('keydown', function (event) {
                        if (event.key === 'Enter') {
                            event.preventDefault();
                            input.blur();
                        } else if (event.key === 'Escape') {
                            event.preventDefault();
                            finishRename(input, false);
                        }
                    });
                    input.addEventListener('blur', function () {
                        finishRename(input, true);
                    });
                    link.addEventListener('click', function blockNav(event) {
                        if (row.classList.contains('is-renaming')) {
                            event.preventDefault();
                        } else {
                            link.removeEventListener('click', blockNav);
                        }
                    });
                }

                list.addEventListener('contextmenu', function (event) {
                    const row = event.target.closest('[data-agent-id]');
                    if (!row || !list.contains(row)) {
                        return;
                    }
                    event.preventDefault();
                    if (renamingInput) {
                        finishRename(renamingInput, true);
                    }
                    contextRow = row;
                    const active =
                        row.getAttribute('data-agent-active') !== 'false';
                    const renameBtn = context.querySelector(
                        '[data-agent-action="rename"]'
                    );
                    const pauseBtn = context.querySelector(
                        '[data-agent-action="pause"]'
                    );
                    const startBtn = context.querySelector(
                        '[data-agent-action="start"]'
                    );
                    const deleteBtn = context.querySelector(
                        '[data-agent-action="delete"]'
                    );
                    renameBtn.hidden = !canEdit;
                    pauseBtn.hidden = !canEdit || !active;
                    startBtn.hidden = !canEdit || active;
                    deleteBtn.hidden = !canDelete;
                    placeContext(event.clientX, event.clientY);
                });

                context.addEventListener('click', function (event) {
                    const button = event.target.closest('[data-agent-action]');
                    if (!button || !contextRow) {
                        return;
                    }
                    const action = button.getAttribute('data-agent-action');
                    const row = contextRow;
                    const id = row.getAttribute('data-agent-id');
                    hideContext();
                    if (action === 'rename') {
                        startRename(row);
                        return;
                    }
                    if (action === 'pause' || action === 'start') {
                        const nextActive = action === 'start';
                        postAgent(actionUrl('toggle', id), {
                            isActive: nextActive ? 'true' : 'false'
                        }).then(function (payload) {
                            const active = payload.isActive === true ||
                                payload.isActive === 'true' ||
                                nextActive;
                            window.PartnerlyAgentsMenu.setActive(id, active);
                            if (
                                window.PartnerlyAutomationHub &&
                                window.PartnerlyAutomationHub.setActive
                            ) {
                                window.PartnerlyAutomationHub.setActive(
                                    id,
                                    active
                                );
                            }
                        }).catch(function () { });
                        return;
                    }
                    if (action === 'delete') {
                        openAgentsDelete(id, agentNameOf(row));
                    }
                });

                const deleteRoot = document.getElementById(
                    'partnerlyAgentsDelete'
                );
                const deleteForm = deleteRoot
                    ? deleteRoot.querySelector('[data-agents-delete-form]')
                    : null;
                const deleteName = deleteRoot
                    ? deleteRoot.querySelector('[data-agents-delete-name]')
                    : null;
                const deleteIdInput = deleteRoot
                    ? deleteRoot.querySelector('[data-agents-delete-id]')
                    : null;

                function setAgentsDeleteOpen(open) {
                    if (!deleteRoot) {
                        return;
                    }
                    deleteRoot.hidden = !open;
                    deleteRoot.classList.toggle('is-open', open);
                    deleteRoot.setAttribute(
                        'aria-hidden',
                        open ? 'false' : 'true'
                    );
                    document.body.classList.toggle(
                        'is-agents-delete-open',
                        open
                    );
                }

                function openAgentsDelete(id, name) {
                    if (!deleteRoot || !deleteForm) {
                        return;
                    }
                    if (deleteIdInput) {
                        deleteIdInput.value = id;
                    }
                    if (deleteName) {
                        deleteName.textContent = name || '';
                    }
                    deleteForm.setAttribute('data-delete-id', id);
                    if (deleteRoot.parentNode !== document.body) {
                        document.body.appendChild(deleteRoot);
                    }
                    setAgentsDeleteOpen(true);
                }

                function closeAgentsDelete() {
                    setAgentsDeleteOpen(false);
                }

                if (deleteRoot) {
                    deleteRoot.addEventListener('click', function (event) {
                        if (
                            event.target === deleteRoot ||
                            event.target.closest('[data-agents-delete-close]')
                        ) {
                            event.preventDefault();
                            closeAgentsDelete();
                        }
                    });
                }

                if (deleteForm) {
                    deleteForm.addEventListener('submit', function (event) {
                        event.preventDefault();
                        const id =
                            (deleteIdInput && deleteIdInput.value) ||
                            deleteForm.getAttribute('data-delete-id');
                        if (!id) {
                            return;
                        }
                        const submitButton = deleteForm.querySelector(
                            'button[type="submit"]'
                        );
                        if (submitButton) {
                            submitButton.disabled = true;
                        }
                        postAgent(actionUrl('delete', id), { id: id })
                            .then(function () {
                                closeAgentsDelete();
                                window.PartnerlyAgentsMenu.remove(id);
                                if (
                                    window.PartnerlyAutomationHub &&
                                    window.PartnerlyAutomationHub.removeRow
                                ) {
                                    window.PartnerlyAutomationHub.removeRow(id);
                                }
                                const path = window.location.pathname || '';
                                if (
                                    path.indexOf(
                                        '/Automation/Builder/' + id
                                    ) === 0
                                ) {
                                    window.location.href = '/Automation';
                                }
                            })
                            .catch(function () { })
                            .then(function () {
                                if (submitButton) {
                                    submitButton.disabled = false;
                                }
                            });
                    });
                }

                document.addEventListener('mousedown', function (event) {
                    if (
                        !context.hidden &&
                        !context.contains(event.target)
                    ) {
                        hideContext();
                    }
                });

                document.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape') {
                        hideContext();
                        if (deleteRoot && deleteRoot.classList.contains('is-open')) {
                            closeAgentsDelete();
                        }
                    }
                });

                window.addEventListener('scroll', hideContext, true);
                window.addEventListener('resize', hideContext);

            }

        }

    });

</script>