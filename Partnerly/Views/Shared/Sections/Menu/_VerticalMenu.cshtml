@{
  TempData.Keep();
  string? currentPage = ViewContext.HttpContext.Request.Path;
}

<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">

  <div
    class='app-brand demo @((@ViewData["navbarFull"] != null && Convert.ToBoolean(@ViewData["navbarFull"])) ? "d-xl-none" : "")'>
    <a asp-controller="Home" asp-action="Index" class="app-brand-link">
      @* <span class="app-brand-logo demo">
          <img src="~/favicon.png" alt="Logo" width="32" height="32" class="me-2" />
      </span> *@
      <span class="app-brand-text demo menu-text fw-bold ms-2">@TempData.Peek("appName")</span>
    </a>

    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto d-block d-xl-none">
      <i class="bx bx-chevron-left bx-sm d-flex align-items-center justify-content-center"></i>
    </a>
  </div>

  <div class="menu-inner-shadow"></div>

  <ul class="menu-inner py-1">
    <li class='menu-item@(currentPage.EndsWith("/Dashboard") ? " active open" : "")'>
      <a asp-controller="Dashboard" asp-action="Index" class="menu-link">
        <i class="menu-icon tf-icons bx bx-home-smile"></i>
                <div class="text-truncate" data-i18n="Dashboards">@Localizer["Statistics"]</div>
      </a>
    </li>

        <li class="menu-header small text-uppercase"><span class="menu-header-text">@Localizer["Miscellaneous"]</span></li>
    <li class='menu-item@(currentPage.Contains("/SupportTickets/OpenNewCase") ? " active" : "")'>
      <a asp-controller="SupportTickets" asp-action="OpenNewCase" class="menu-link">
        <i class="menu-icon tf-icons bx bx-support"></i>
        <div>@Localizer["Support"]</div><div class="badge bg-label-primary fs-tiny rounded-pill ms-auto text-uppercase">24/7</div>
      </a>
    </li>
    <li class="menu-item">
      <a href='@TempData.Peek("documentation")' class="menu-link">
        <i class="menu-icon tf-icons bx bx-file"></i>
                <div>@Localizer["Documentation"]</div>
      </a>
    </li>
    @if (ViewBag?.RoleType == Partnerly.Descriptors.Attributes.RoleTypeAttribute.Delete || ViewBag?.RoleType == Partnerly.Descriptors.Attributes.RoleTypeAttribute.Update)
    {
        <li class="menu-header small text-uppercase"><span class="menu-header-text">@Localizer["Systemsettings"]</span></li>
        if (ViewBag?.RoleType == Partnerly.Descriptors.Attributes.RoleTypeAttribute.Delete)
        {
            <li class='menu-item@(currentPage.StartsWith("/SystemPreferences") ? " active" : "")'>
              <a asp-controller="SystemPreferences" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-slider"></i>
                        <div>@Localizer["Settings"]</div>
              </a>
            </li>
            <li class='menu-item@(currentPage.StartsWith("/Roles") ? " active" : "")'>
              <a asp-controller="Roles" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-paint-roll"></i>
                        <div>@Localizer["Userroles"]</div>
              </a>
            </li>
            <li class='menu-item@(currentPage.StartsWith("/EmailTemplates") ? " active" : "")'>
              <a asp-controller="EmailTemplates" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-sitemap"></i>
                        <div>@Localizer["Emailtemplates"]</div>
              </a>
            </li>
             <li class='menu-item@(currentPage.StartsWith("/LogRecords") ? " active" : "")'>
              <a asp-controller="LogRecords" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-file"></i>
                <div>@Localizer["Logs"]</div>
              </a>
            </li>
        }
        <li class='menu-item@(currentPage.StartsWith("/Users") ? " active" : "")'>
            <a asp-controller="Users" asp-action="Index" class="menu-link">
            <i class="menu-icon tf-icons bx bx-user"></i>
                    <div>@Localizer["Users"]</div>
            </a>
        </li>
        
        <li class='menu-item@(currentPage.StartsWith("/UserGroups") ? " active" : "")'>
            <a asp-controller="UserGroups" asp-action="Index" class="menu-link">
            <i class="menu-icon tf-icons bx bx-group"></i>
                    <div>@Localizer["Groups"]</div>
            </a>
        </li>
        
       
        <li class='menu-item@(currentPage.StartsWith("/SupportTickets") &&  !currentPage.Contains("/OpenNewCase") ? " active" : "")'>
            <a asp-controller="SupportTickets" asp-action="Index" class="menu-link">
            <i class="menu-icon tf-icons bx bx-pencil"></i>
                    <div>@Localizer["Tasks"]</div>
            </a>
        </li>    
    }
  </ul>
</aside>
