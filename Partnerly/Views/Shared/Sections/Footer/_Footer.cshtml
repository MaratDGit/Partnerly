@{
  TempData.Keep();
  ViewData["containerNav"] = (ViewData["containerNav"] ??= "container-fluid");
}

<footer class="content-footer footer bg-footer-theme">
  <div class="@ViewData["containerNav"]">
    <div class="footer-container d-flex align-items-center justify-content-between py-4 flex-md-row flex-column">
      <div class="text-body">
        © <script>
        document.write(new Date().getFullYear())
        </script>, @Localizer["madefrom"] <a href='@TempData.Peek("authorUrl")' class="footer-link fw-medium">@TempData.Peek("authorName")  @* <img src="~/favicon.png" alt="Logo" width="20" height="20" class="me-2" /> *@</a>
      </div>
      <div class="d-none d-lg-inline-block">
                <a href='@TempData.Peek("licenseUrl")' class="footer-link me-4">@Localizer["License"]</a>
                <a href='@TempData.Peek("documentation")' class="footer-link me-4">@Localizer["Documentation"]</a>
                <a asp-controller="SupportTickets" asp-action="OpenNewCase" class="footer-link d-none d-sm-inline-block">@Localizer["Support"]</a>
      </div>
    </div>
  </div>
</footer>
