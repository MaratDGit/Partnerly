@{
    TempData.Keep();
    ViewData["containerNav"] = (ViewData["containerNav"] ??= "container-fluid");
}

<footer class="partnerly-footer">

    <div class="@ViewData["containerNav"]">

        <div class="partnerly-footer-inner">

            <div class="partnerly-footer-left">

                @* <span>
                    © <span id="partnerlyFooterYear"></span>
                    @Localizer["madefrom"]
                </span>

                <a href="@TempData.Peek("authorUrl")"
                   target="_blank"
                   rel="noopener noreferrer">
                    @TempData.Peek("authorName")
                </a>

                <span class="partnerly-footer-separator">·</span> *@
            </div>


            <div class="partnerly-footer-links">

                <a href="@TempData.Peek("licenseUrl")"
                   target="_blank"
                   rel="noopener noreferrer">
                    @Localizer["License"]
                </a>

                <a href="@TempData.Peek("documentation")"
                   target="_blank"
                   rel="noopener noreferrer">
                    @Localizer["Documentation"]
                </a>

                <a asp-controller="SupportTickets"
                   asp-action="OpenNewCase">
                    @Localizer["Support"]
                </a>

            </div>

        </div>

    </div>

</footer>

<script>
    document.getElementById('partnerlyFooterYear').textContent =
        new Date().getFullYear();
</script>