@{
    var message = TempData["ToastMessage"] as string;
}

@if (!string.IsNullOrEmpty(message))
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="appToast" class="toast align-items-center text-bg-primary border-0"
             role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bx bx-check-circle me-1"></i> @message
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast" aria-label="Закрыть"></button>
            </div>
        </div>
    </div>

    // Чтобы не повторялось при F5
    TempData.Remove("ToastMessage");

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toastEl = document.getElementById('appToast');
            if (toastEl) {
                const toast = new bootstrap.Toast(toastEl, { delay: 3000 });
                toast.show();
            }
        });
    </script>
}
