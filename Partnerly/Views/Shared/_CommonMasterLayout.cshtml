@inject IHttpContextAccessor httpContextAccessor

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName"
      class="light-style layout-menu-fixed"
      data-theme="light"
      data-bs-theme="light"
      data-assets-path="@((httpContextAccessor.HttpContext?.Request.PathBase ?? "") + "/")"
      data-framework="aspnetcore-mvc"
      data-template="vertical-menu-aspnet-core-mvc-template-free">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />

    @{
        string title = ViewData["title"] as string ?? "";
        string appName = TempData.Peek("appName") as string ?? "";
        string productPage = TempData.Peek("productPage") as string ?? "";
    }

    <title>@title</title>
    <meta name="description" content="" />

    <link rel="canonical" href='@productPage'>
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/favicon.png" />

    <!-- Core Styles -->
    @await Html.PartialAsync("Sections/_Styles")

    <!-- Vendor Styles -->
    @RenderSection("VendorStyles", required: false)

    <!-- Page Styles -->
    @RenderSection("PageStyles", required: false)

    <link rel="stylesheet" href="~/assets/css/sticky-buttons.css" />
    <link rel="stylesheet" href="~/assets/css/delete-confirmation.css" />
    <link rel="stylesheet" href="~/assets/css/ticker.css" />
    <link rel="stylesheet" href="~/assets/css/partnerly-layout.css" asp-append-version="true" />

</head>

<body>
    <script>
        (function () {
            try {
                if (window.innerWidth > 1199.98 &&
                    localStorage.getItem('partnerly-sidebar-collapsed') === 'true') {
                    document.body.classList.add('partnerly-sidebar-collapsed');
                }
            } catch (error) {
                // Expanded sidebar remains the default.
            }
        })();
    </script>
    <link rel="stylesheet" href="~/assets/css/spiner.css" asp-append-version="true" />
    <!-- Global Loader-Spiner -->
    <div id="globalLoader" hidden style="display:none;" aria-hidden="true">
        <div class="loader-container">
            <div class="spinner"></div>
            <div class="loader-text">@Localizer["LookupLoading"]</div>
        </div>
    </div>

      <!-- Layout Content -->
      @RenderBody()

      <!-- Core Scripts -->
      @await Html.PartialAsync("Sections/_Scripts")

      <!-- Vendor Scripts -->
      @RenderSection("VendorScripts", required: false)

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.11/signalr.min.js"></script>
    <script src="~/assets/js/partnerly-layout.js" asp-append-version="true"></script>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

    <script>
         const dateLocalization = {
            culture: '@CultureInfo.CurrentUICulture.Name',
            justNow: '@Localizer["JustNow"]',
            minuteAgo: '@Localizer["MinuteAgo"]',
            minutesAgo: '@Localizer["MinutesAgo"]',
            hourAgo: '@Localizer["HourAgo"]',
            hoursAgo: '@Localizer["HoursAgo"]',
            yesterday: '@Localizer["Yesterday"]',
            daysAgo: '@Localizer["DaysAgo"]',
        };

        const dateLocalizationDataTable = {
            justNow: @Html.Raw(Json.Serialize(Localizer["JustNow"].Value)),
            minuteAgo: @Html.Raw(Json.Serialize(Localizer["MinuteAgo"].Value)),
            minutesAgo: @Html.Raw(Json.Serialize(Localizer["MinutesAgo"].Value)),
            hourAgo: @Html.Raw(Json.Serialize(Localizer["HourAgo"].Value)),
            hoursAgo: @Html.Raw(Json.Serialize(Localizer["HoursAgo"].Value)),
            yesterday: @Html.Raw(Json.Serialize(Localizer["Yesterday"].Value)),
            daysAgo: @Html.Raw(Json.Serialize(Localizer["DaysAgo"].Value))
        };

        const lookupLocalization = {
            selectRecord: @Html.Raw(Json.Serialize(Localizer["LookupSelectRecord"].Value)),
            search: @Html.Raw(Json.Serialize(Localizer["DataTableSearch"].Value)),
            loading: @Html.Raw(Json.Serialize(Localizer["LookupLoading"].Value)),
            noData: @Html.Raw(Json.Serialize(Localizer["LookupNoData"].Value)),
            loadError: @Html.Raw(Json.Serialize(Localizer["LookupLoadError"].Value))
        };

        const dataTableLocalization = {
            filters: @Html.Raw(Json.Serialize(Localizer["DataTableFilters"].Value)),
            close: @Html.Raw(Json.Serialize(Localizer["Close"].Value)),
            cancel: @Html.Raw(Json.Serialize(Localizer["Cancel"].Value)),
            apply: @Html.Raw(Json.Serialize(Localizer["DataTableApply"].Value)),
            reset: @Html.Raw(Json.Serialize(Localizer["DataTableReset"].Value)),
            exportExcel: @Html.Raw(Json.Serialize(Localizer["DataTableExportExcel"].Value)),
            exportAll: @Html.Raw(Json.Serialize(Localizer["DataTableExportAll"].Value)),
            exportSelected: @Html.Raw(Json.Serialize(Localizer["DataTableExportSelected"].Value)),
            search: @Html.Raw(Json.Serialize(Localizer["DataTableSearch"].Value)),
            filteredRecords: @Html.Raw(Json.Serialize(Localizer["DataTableFilteredRecords"].Value)),
            totalRecords: @Html.Raw(Json.Serialize(Localizer["DataTableTotalRecords"].Value)),
            shownRecords: @Html.Raw(Json.Serialize(Localizer["DataTableShownRecords"].Value)),
            filterActive: @Html.Raw(Json.Serialize(Localizer["DataTableFilterActive"].Value)),
            from: @Html.Raw(Json.Serialize(Localizer["DataTableFrom"].Value)),
            to: @Html.Raw(Json.Serialize(Localizer["DataTableTo"].Value)),
            all: @Html.Raw(Json.Serialize(Localizer["DataTableAll"].Value)),
            yes: @Html.Raw(Json.Serialize(Localizer["DataTableYes"].Value)),
            no: @Html.Raw(Json.Serialize(Localizer["DataTableNo"].Value)),
            actions: @Html.Raw(Json.Serialize(Localizer["DataTableActions"].Value))
        };

        const attachementLocalization = {
                ailedtoloadattachments: @Html.Raw(Json.Serialize(Localizer["Failedtoloadattachments"].Value)),
                Failedtoloadattachments: @Html.Raw(Json.Serialize(Localizer["Failedtoloadattachments"].Value)),
                Pleaseselectatleastonefile: @Html.Raw(Json.Serialize(Localizer["Pleaseselectatleastonefile"].Value)),
                ploadfailed: @Html.Raw(Json.Serialize(Localizer["Uploadfailed"].Value)),
                Faileduploadingfiles: @Html.Raw(Json.Serialize(Localizer["Faileduploadingfiles"].Value)),
                Areyousureyouwanttodeletethisfile: @Html.Raw(Json.Serialize(Localizer["ConfirmDelete"].Value)),
                Deletefailed: @Html.Raw(Json.Serialize(Localizer["Deletefailed"].Value)),
                Failedtodeletethefile: @Html.Raw(Json.Serialize(Localizer["Failedtodeletethefile"].Value)),
        };
    </script>

    <script src="~/assets/js/partnerly-theme.js" asp-append-version="true"></script>
    <script src="~/assets/js/spiner.js" asp-append-version="true"></script>
    <script src="~/assets/js/field-lookup.js"></script>
    <link rel="stylesheet" href="~/assets/css/field-lookup.css" />

    <!-- DataTable -->
    <link rel="stylesheet" href="~/assets/css/partnerly-data-table.css" />

    <script src="~/js/datatable/modules/core.js"></script>
    <script src="~/js/datatable/modules/state.js"></script>
    <script src="~/js/datatable/modules/utils.js"></script>
    <script src="~/js/datatable/modules/columns.js"></script>
    <script src="~/js/datatable/modules/resize.js"></script>
    <script src="~/js/datatable/modules/render.js"></script>
    <script src="~/js/datatable/modules/data.js"></script>
    <script src="~/js/datatable/modules/search.js"></script>
    <script src="~/js/datatable/modules/sorting.js"></script>
    <script src="~/js/datatable/modules/filters.js"></script>
    <script src="~/js/datatable/modules/pagination.js"></script>
    <script src="~/js/datatable/modules/inline.js"></script>
    <script src="~/js/datatable/modules/actions.js"></script>
    <script src="~/js/datatable/modules/export.js"></script>

    <script src="~/js/datatable/datatable.js"></script>
    <script src="~/js/datatable/datatable.init.js"></script>

    <!-- Page Scripts-->
    @RenderSection("PageScripts", required: false)

</body>

</html>