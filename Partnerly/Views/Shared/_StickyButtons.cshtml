@using Partnerly.Models.Authorization
@using Partnerly.Models.ViewModels
@model FormActionsViewModel

@{
    var stickyPermissions = ViewData["Permissions"] as HashSet<string>
        ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    bool CanSticky(string? code) =>
        string.IsNullOrWhiteSpace(code) || stickyPermissions.Contains(code);

    bool ShowSticky(FormActionBase? action) =>
        action?.Visible == true && CanSticky(action.Permission);

    var visibleMenuActions = (Model?.MenuActions ?? new List<MenuItemAction>())
        .Where(action => action.Visible == true && CanSticky(action.Permission))
        .ToList();

    var showMenu = ShowSticky(Model?.Menu) && visibleMenuActions.Count > 0;
    var showAttachments = ShowSticky(Model?.Attachements);
    var canUploadAttachments = showAttachments && CanSticky(Model?.Attachements?.UploadPermission);
    var canDeleteAttachments = showAttachments && CanSticky(
        string.IsNullOrWhiteSpace(Model?.Attachements?.DeletePermission)
            ? PermissionCodes.AttachmentsManage
            : Model!.Attachements.DeletePermission);
}

<div class="sticky-buttons mb-6">
    <div class="left-buttons">
        @if (ShowSticky(Model?.Back))
        {   
            <a asp-action="@Model.Back.ToAction" asp-controller="@Model.Back.ToController" class="btn btn-link p-0" title="@Model.Back.Title">
                <i class="@Model.Back.Icon me-1 fs-3"></i>
            </a>
        }
        @if (ShowSticky(Model?.Undo))
        {   
            <a asp-action="@Model.Undo.ToAction" asp-controller="@Model.Undo.ToController" class="btn btn-link p-0" title="@Model.Undo.Title">
                <i class="@Model.Undo.Icon me-1 fs-3"></i>
            </a>
        }
        @if (ShowSticky(Model?.Save))
        {   
            <button type="submit" id="btnSave" class="btn btn-link p-0" title="@Model.Save.Title">
                <i class="@Model.Save.Icon me-1 fs-3"></i>
            </button>
        }
        @if (ShowSticky(Model?.Create))
        {   
            <a asp-action="@Model.Create.ToAction" asp-controller="@Model.Create.ToController" class="btn btn-link p-0" title="@Model.Create.Title">
                <i class="@Model.Create.Icon me-1 fs-3"></i>
            </a>
        }
        @if (ShowSticky(Model?.Delete))
        {   
            <a asp-action="@Model.Delete.ToAction" asp-controller="@Model.Delete.ToController" asp-route-id="@Model.Delete.Id" class="btn btn-link p-0" title="@Model.Delete.Title">
                <i class="@Model.Delete.Icon me-1 fs-3"></i>
            </a>
        }
        @if (showMenu)
        {   
            <div class="btn-group">
                <button type="button" class="btn btn-link p-0" data-bs-toggle="dropdown" title="@Model.Menu.Title">
                    <i class="@Model.Menu.Icon fs-3"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    @foreach (var action in visibleMenuActions)
                    {
                            <li>
                                @if (action.IsModal == true)
                                {
                                    <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="@action.ModalTarget" onclick="@action.OnClick">
                                        <i class="@action.Icon me-1"></i> @action.DisplayName
                                    </a>
                                }
                                else
                                {
                                    <a class="dropdown-item"
                                       asp-action="@action.ToAction"
                                       asp-controller="@action.ToController"
                                       asp-route-id="@action.RouteID">
                                        <i class="@action.Icon me-1"></i> @action.DisplayName
                                    </a>
                                }
                            </li>
                    }
                </ul>
            </div>
        }
    </div>
    <div class="right-buttons">
        @if (showAttachments)
        {
            <button type="button"
                    id="attachmentsBtn"
                    class="btn btn-attachement"
                    title="@Localizer["Attachments"]"
                    data-bs-toggle="modal"
                    data-bs-target="#attachmentsModal">

                <i class="bx bx-paperclip me-1"></i>
            </button>
        }
        @if (ShowSticky(Model?.Note))
        {
            <button type="button" class="btn btn-note" title=@Localizer["Addanote"]
                    data-bs-toggle="modal" data-bs-target="#noteModal">
                <i class="bx bx-note fs-3"></i>
            </button>
        }
    </div>
</div>

@if (ShowSticky(Model?.Note))
{
<div class="modal fade" id="noteModal" tabindex="-1" aria-labelledby="noteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-3 shadow-lg">

            <div class="modal-header py-2">
                <h6 class="modal-title" id="noteModalLabel">
                    <span class="note-modal-icon">
                        <i class="bx bx-note"></i>
                    </span>
                    <span>@Localizer["Notetothedocument"]</span>
                </h6>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="@Localizer["Close"]">
                </button>
            </div>

            <div class="modal-body py-2">
                <div class="form-floating">
                    <textarea id="noteText"
                              asp-for="@Model.Note.Note"
                              class="form-control"
                              placeholder="@Localizer["Enteranote"]"
                              style="height: 120px; font-size: 0.9rem;"></textarea>
                </div>
            </div>

            <div class="modal-footer d-flex justify-content-between py-2">

                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        id="clearNoteBtn">
                    @Localizer["Clear"]
                </button>

                <div>
                    <button type="button"
                            class="btn btn-secondary btn-sm"
                            data-bs-dismiss="modal"
                            id="cancelNoteBtn">
                        @Localizer["Cancel"]
                    </button>

                    <button type="button"
                            class="btn btn-primary btn-sm"
                            id="saveNoteBtn"
                            data-bs-dismiss="modal">
                        @Localizer["OK"]
                    </button>
                </div>

            </div>

        </div>
    </div>
</div>
}

@if (showAttachments)
{
<div class="modal fade"
     id="attachmentsModal"
     tabindex="-1"
     aria-labelledby="attachmentsModalLabel"
     aria-hidden="true"
     data-can-upload="@canUploadAttachments.ToString().ToLowerInvariant()"
     data-can-delete="@canDeleteAttachments.ToString().ToLowerInvariant()">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="attachmentsModalLabel">
                    <i class="bx bx-paperclip me-1"></i>
                    @Localizer["Attachments"]
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="@Localizer["Close"]">
                </button>
            </div>

            <div class="modal-body">

                <div id="attachmentsForm">

                    <div id="attachmentsAntiForgeryToken">
                        @Html.AntiForgeryToken()
                    </div>

                    <input type="hidden"
                           id="attachmentEntityType"
                           value="@Model.Attachements.EntityType" />

                    <input type="hidden"
                           id="attachmentEntityId"
                           value="@Model.Attachements.EntityId" />

                    @if (canUploadAttachments)
                    {
                    <div class="mb-3">

                        <label for="attachmentFiles"
                               class="form-label">
                            @Localizer["Selectfiles"]
                        </label>

                        <input type="file"
                               id="attachmentFiles"
                               name="files"
                               class="form-control"
                               multiple />

                    </div>
                    }

                    @if (canUploadAttachments)
                    {
                    <div class="d-flex justify-content-end">

                        <button type="button"
                                id="uploadAttachmentsBtn"
                                class="btn btn-primary"
                                onclick="uploadAttachments()">

                            <i class="bx bx-upload me-1"></i>
                            @Localizer["Upload"]

                        </button>

                    </div>
                    }

                </div>

                <hr />

                <div id="attachmentsLoading"
                     class="text-center py-3"
                     style="display:none;">

                    <div class="spinner-border"></div>

                </div>

                <div id="attachmentsEmpty"
                     class="text-center text-muted py-4"
                     style="display:none;">

                    @Localizer["Noattachments"]

                </div>

                <div id="attachmentsList"
                     class="list-group">
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    @Localizer["Close"]

                </button>

            </div>

        </div>
    </div>
</div>
}

<script>

document.addEventListener('DOMContentLoaded', function () {
    const noteText = document.getElementById('noteText');
    const clearBtn = document.getElementById('clearNoteBtn');
    const saveNoteBtn = document.getElementById('saveNoteBtn');
    const cancelNoteBtn = document.getElementById('cancelNoteBtn');
    const noteBtn = document.querySelector('.btn-note');

    if (!noteText || !noteBtn) {
        updateAttachmentsButton();
        return;
    }

    let lastSavedNote = noteText.value.trim();
    const noteModalEl = document.getElementById('noteModal');

    if (noteModalEl && noteModalEl.parentElement !== document.body) {
        document.body.appendChild(noteModalEl);
    }

    function findNoteHiddenInputs() {
        return document.querySelectorAll(
            'input[type="hidden"]#hiddenNote, input[type="hidden"]#Note, input[type="hidden"][name="Note"], input[type="hidden"][name$=".Note"]'
        );
    }

    function closeNoteModal() {
        if (!noteModalEl) {
            return;
        }

        if (window.bootstrap && bootstrap.Modal) {
            bootstrap.Modal.getOrCreateInstance(noteModalEl).hide();
            return;
        }

        noteModalEl.classList.remove('show');
        noteModalEl.style.display = 'none';
        noteModalEl.setAttribute('aria-hidden', 'true');
        document.querySelectorAll('.modal-backdrop').forEach(function (backdrop) {
            backdrop.remove();
        });
        document.body.classList.remove('modal-open');
        document.body.style.removeProperty('overflow');
        document.body.style.removeProperty('padding-right');
    }

    function updateNoteButtonColor() {
        if (noteText.value.trim().length > 0) {
            noteBtn.classList.add('active');
        } else {
            noteBtn.classList.remove('active');
        }
    }

    if (clearBtn) {
        clearBtn.addEventListener('click', function () {
            noteText.value = '';
            noteText.focus();
            updateNoteButtonColor();
        });
    }

    if (saveNoteBtn) {
        saveNoteBtn.addEventListener('click', function (event) {
            event.preventDefault();
            try {
                const note = noteText.value.trim();
                lastSavedNote = note;
                findNoteHiddenInputs().forEach(function (input) {
                    input.value = note;
                });
                noteText.dispatchEvent(new Event('input', { bubbles: true }));
                updateNoteButtonColor();
            } finally {
                closeNoteModal();
            }
        });
    }

    if (cancelNoteBtn) {
        cancelNoteBtn.addEventListener('click', function () {
            noteText.value = lastSavedNote;
            updateNoteButtonColor();
        });
    }

    noteText.addEventListener('input', updateNoteButtonColor);
    updateNoteButtonColor();

    updateAttachmentsButton();
});

    async function updateAttachmentsButton() {

        const attachmentsBtn =
            document.getElementById("attachmentsBtn");

        if (!attachmentsBtn)
            return;

        try {

            const entityType =
                document.getElementById("attachmentEntityType").value;

            const entityId =
                document.getElementById("attachmentEntityId").value;

            const url =
                `/Attachments/Get?entityType=${encodeURIComponent(entityType)}&entityId=${encodeURIComponent(entityId)}`;

            const response = await fetch(url);

            if (!response.ok)
                return;

            const attachments =
                await response.json();

            if (attachments && attachments.length > 0) {
                attachmentsBtn.classList.add("active");
            }
            else {
                attachmentsBtn.classList.remove("active");
            }

        }
        catch (error) {

            console.error(error);

        }
    }

async function loadAttachments() {

    const list =
        document.getElementById("attachmentsList");

    const empty =
        document.getElementById("attachmentsEmpty");

    const loading =
        document.getElementById("attachmentsLoading");

    list.innerHTML = "";

    empty.style.display = "none";
    loading.style.display = "block";

    try {

        const entityType =
            document.getElementById("attachmentEntityType").value;

        const entityId =
            document.getElementById("attachmentEntityId").value;

        const url =
            `/Attachments/Get?entityType=${encodeURIComponent(entityType)}&entityId=${encodeURIComponent(entityId)}`;

        const response = await fetch(url);

        if (!response.ok)
            throw new Error(
                attachementLocalization.Failedtoloadattachments
            );

        const attachments = await response.json();

        const attachmentsBtn = document.getElementById("attachmentsBtn");

        if (attachmentsBtn) {
            if (attachments && attachments.length > 0) {
                attachmentsBtn.classList.add("active");
            } else {
                attachmentsBtn.classList.remove("active");
            }
        }

        if (!attachments || attachments.length === 0) {

            empty.style.display = "block";

            return;
        }

        attachments.forEach(attachment => {

            list.appendChild(
                createAttachmentElement(attachment)
            );

        });

    }
    catch (error) {

        console.error(error);

        alert(
            attachementLocalization.Failedtoloadattachments
        );

    }
    finally {

        loading.style.display = "none";
    }
}


function createAttachmentElement(attachment) {

    const item =
        document.createElement("div");

    item.className =
        "list-group-item d-flex align-items-center justify-content-between";


    const fileName =
        document.createElement("span");

    fileName.className =
        "fw-semibold";

    fileName.textContent =
        attachment.fileName;


    const actions =
        document.createElement("div");

    actions.className =
        "d-flex gap-1";


    const downloadButton =
        document.createElement("a");

    downloadButton.href =
        `/Attachments/Download/${attachment.id}`;

    downloadButton.className =
        "btn btn-sm btn-outline-primary";

    downloadButton.innerHTML =
        '<i class="bx bx-download"></i>';


    const deleteButton =
        document.createElement("button");

    deleteButton.type =
        "button";

    deleteButton.className =
        "btn btn-sm btn-outline-danger";

    deleteButton.innerHTML =
        '<i class="bx bx-trash"></i>';

    deleteButton.onclick = () =>
        deleteAttachment(attachment.id);


    actions.appendChild(downloadButton);

    const attachmentsModal = document.getElementById("attachmentsModal");
    const canDelete = attachmentsModal?.dataset?.canDelete === "true";
    if (canDelete) {
        actions.appendChild(deleteButton);
    }

    item.appendChild(fileName);
    item.appendChild(actions);

    return item;
}


async function uploadAttachments() {

    const fileInput =
        document.getElementById("attachmentFiles");

    const uploadButton =
        document.getElementById("uploadAttachmentsBtn");


    if (!fileInput || !fileInput.files.length) {

        alert(
            attachementLocalization.Pleaseselectatleastonefile
        );

        return;
    }

    const entityType =
        document.getElementById("attachmentEntityType").value;

    const entityId =
        document.getElementById("attachmentEntityId").value;


        const formData = new FormData();

    const tokenInput = document.querySelector(
        'input[name="__RequestVerificationToken"]'
    );

    if (!tokenInput) {
        console.error("Anti-forgery token not found.");
        return;
    }

    formData.append(
        "__RequestVerificationToken",
        tokenInput.value
    );

    formData.append(
        "entityType",
        entityType
    );

    formData.append(
        "entityId",
        entityId
    );

    for (const file of fileInput.files) {
        formData.append("files", file);
    }

    uploadButton.disabled = true;

    try {

        const response = await fetch(
            "@Url.Action("Upload", "Attachments")",
            {
                method: "POST",
                body: formData
            });


        if (!response.ok)
            throw new Error(
                attachementLocalization.Uploadfailed
            );


        const result =
            await response.json();


        if (!result.success)
            throw new Error(
                attachementLocalization.Uploadfailed
            );


        fileInput.value = "";

        await loadAttachments();

    }
    catch (error) {

        console.error(error);

        alert(
            attachementLocalization.Faileduploadingfiles
        );

    }
    finally {

        uploadButton.disabled = false;
    }
}


async function deleteAttachment(id) {

    if (!confirm(
        attachementLocalization.Areyousureyouwanttodeletethisfile
    ))
        return;


    const tokenInput = document.querySelector(
        'input[name="__RequestVerificationToken"]'
    );

    if (!tokenInput) {
        console.error("Anti-forgery token not found.");
        return;
    }

    const token = tokenInput.value;


    const formData =
        new FormData();

    formData.append(
        "id",
        id
    );

    formData.append(
        "__RequestVerificationToken",
        token
    );


    try {

        const response = await fetch(
            "@Url.Action("Delete", "Attachments")",
            {
                method: "POST",
                body: formData
            });


        if (!response.ok)
            throw new Error(
                attachementLocalization.Deletefailed
            );


        const result =
            await response.json();


        if (!result.success)
            throw new Error(
                attachementLocalization.Deletefailed
            );


        await loadAttachments();

    }
    catch (error) {

        console.error(error);

        alert(
            attachementLocalization.Failedtodeletethefile
        );
    }
}


document.addEventListener(
        "DOMContentLoaded",
        function () {

            const modal =
                document.getElementById("attachmentsModal");

            if (!modal)
                return;


            modal.addEventListener(
                "shown.bs.modal",
                function () {

                    loadAttachments();

                });
        });
</script>


