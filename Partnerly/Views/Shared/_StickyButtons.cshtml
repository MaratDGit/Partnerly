@model  Partnerly.Models.ViewModels.FormActionsViewModel;

@{
    bool hasRole = ViewBag?.RoleType == Partnerly.Descriptors.Attributes.RoleTypeAttribute.Delete || ViewBag?.RoleType == Partnerly.Descriptors.Attributes.RoleTypeAttribute.Update;
    bool hasAdminRole = ViewBag?.RoleType == Partnerly.Descriptors.Attributes.RoleTypeAttribute.Delete;
}

<style>
.sticky-buttons {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #ddd; /* линия под всей панелью */
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
    position: sticky;
    top: 0; /* Приклеивается к верху экрана */
    background: #fff; /* Чтобы кнопки не "просвечивали" при прокрутке */
    z-index: 100; /* Чтобы оставались поверх формы */
    padding: 10px 0;
    border-bottom: 1px solid #dee2e6;
}

.sticky-buttons .left-buttons {
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.sticky-buttons .right-buttons {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.sticky-buttons .btn-note i {
    font-size: 1.6rem;
    transition: color 0.2s ease, transform 0.2s ease;
}
.sticky-buttons .btn-note:hover i {
    transform: scale(1.15);
}

.sticky-buttons .btn-note {
    border: none;
    background: none;
    box-shadow: none;
    outline: none;
    padding: 0;
    color: #ccc;
    transition: color 0.2s ease, transform 0.2s ease;
}
.sticky-buttons .btn-note.active {
    color: #ffc107; /* жёлтая, если есть заметка */
}
.sticky-buttons .btn-note:hover {
    transform: scale(1.15);
}

.sticky-buttons .btn-attachement i {
    font-size: 1.6rem;
    transition: color 0.2s ease, transform 0.2s ease;
}

.sticky-buttons .btn-attachement:hover i {
    transform: scale(1.15);
}

.sticky-buttons .btn-attachement {
    border: none;
    background: none;
    box-shadow: none;
    outline: none;
    padding: 0;
    color: #ccc;
    transition: color 0.2s ease, transform 0.2s ease;
}

.sticky-buttons .btn-attachement.active {
    color: #ffc107; /* жёлтая, если есть attachement */
}

.sticky-buttons .btn-attachement:hover {
    transform: scale(1.15);
}
</style>


<div class="sticky-buttons mb-6">
    <div class="left-buttons">
        @if (Model?.Back?.Visible == true)
        {   
            <a asp-action="@Model.Back.ToAction" asp-controller="@Model.Back.ToController" class="btn btn-link p-0" title="@Model.Back.Title">
                <i class="@Model.Back.Icon me-1 fs-3"></i>
            </a>
        }
        @if (Model?.Undo?.Visible == true)
        {   
            <a asp-action="@Model.Undo.ToAction" asp-controller="@Model.Undo.ToController" class="btn btn-link p-0" title="@Model.Undo.Title">
                <i class="@Model.Undo.Icon me-1 fs-3"></i>
            </a>
        }
        @if (Model?.Save?.Visible == true)
        {   
            <button type="submit" id="btnSave" class="btn btn-link p-0" title="@Model.Save.Title">
                <i class="@Model.Save.Icon me-1 fs-3"></i>
            </button>
        }
        @if (Model?.Create?.Visible == true && hasAdminRole)
        {   
            <a asp-action="@Model.Create.ToAction" asp-controller="@Model.Create.ToController" class="btn btn-link p-0" title="@Model.Create.Title">
                <i class="@Model.Create.Icon me-1 fs-3"></i>
            </a>
        }
        @if (Model?.Delete?.Visible == true && hasAdminRole)
        {   
            <a asp-action="@Model.Delete.ToAction" asp-controller="@Model.Delete.ToController" asp-route-id="@Model.Delete.Id" class="btn btn-link p-0" title="@Model.Delete.Title">
                <i class="@Model.Delete.Icon me-1 fs-3"></i>
            </a>
        }
        @if (Model?.Menu?.Visible == true)
        {   
            <div class="btn-group">
                <button type="button" class="btn btn-link p-0" data-bs-toggle="dropdown" title="@Model.Menu.Title">
                    <i class="@Model.Menu.Icon fs-3"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    @foreach (var action in Model.MenuActions)
                    {
                        @if(action.Visible == true)
                        {
                            <li>
                                @if (action.IsModal == true)
                                {
                                    <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="@action.ModalTarget" onclick="@action.OnClick">
                                        <i class="@action.Icon me-1"></i> @action.DisplayName
                                    </a>
                                }
                                else
                                {
                                    <a class="dropdown-item"
                                       asp-action="@action.ToAction"
                                       asp-controller="@action.ToController"
                                       asp-route-id="@action.RouteID">
                                        <i class="@action.Icon me-1"></i> @action.DisplayName
                                    </a>
                                }
                            </li>
                        }
                    }
                </ul>
            </div>
        }
    </div>
    <div class="right-buttons">
        @if (Model?.Attachements?.Visible == true)
        {
            <button type="button"
                    id="attachmentsBtn"
                    class="btn btn-attachement"
                    title="@Localizer["Attachments"]"
                    data-bs-toggle="modal"
                    data-bs-target="#attachmentsModal">

                <i class="bx bx-paperclip me-1"></i>
            </button>
        }
        @if (Model?.Note?.Visible == true)
        {
            <button type="button" class="btn btn-note" title=@Localizer["Addanote"]
                    data-bs-toggle="modal" data-bs-target="#noteModal">
                <i class="bx bx-note fs-3"></i>
            </button>
        }
    </div>
</div>

<div class="modal fade" id="noteModal" tabindex="-1" aria-labelledby="noteModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-3 shadow-lg">
      <div class="modal-header py-2">
                <h6 class="modal-title" id="noteModalLabel">@Localizer["Notetothedocument"]</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label=@Localizer["Close"]></button>
      </div>

      <div class="modal-body py-2">
        <div class="form-floating">
             <textarea id="noteText" asp-for="@Model.Note.Note" class="form-control" placeholder=@Localizer["Enteranote"] style="height: 120px; font-size: 0.9rem;"></textarea>
        </div>
      </div>

      <div class="modal-footer d-flex justify-content-between py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="clearNoteBtn">@Localizer["Clear"]</button>
        <div>
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" id="cancelNoteBtn">@Localizer["Cancel"]</button>
                    <button type="button" class="btn btn-primary btn-sm" id="saveNoteBtn">@Localizer["OK"]</button>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade"
     id="attachmentsModal"
     tabindex="-1"
     aria-labelledby="attachmentsModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="attachmentsModalLabel">
                    <i class="bx bx-paperclip me-1"></i>
                    @Localizer["Attachments"]
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="@Localizer["Close"]">
                </button>
            </div>

            <div class="modal-body">

                <div id="attachmentsForm">

                    <div id="attachmentsAntiForgeryToken">
                        @Html.AntiForgeryToken()
                    </div>

                    <input type="hidden"
                           id="attachmentEntityType"
                           value="@Model.Attachements.EntityType" />

                    <input type="hidden"
                           id="attachmentEntityId"
                           value="@Model.Attachements.EntityId" />

                    <div class="mb-3">

                        <label for="attachmentFiles"
                               class="form-label">
                            @Localizer["Selectfiles"]
                        </label>

                        <input type="file"
                               id="attachmentFiles"
                               name="files"
                               class="form-control"
                               multiple />

                    </div>

                    <div class="d-flex justify-content-end">

                        <button type="button"
                                id="uploadAttachmentsBtn"
                                class="btn btn-primary"
                                onclick="uploadAttachments()">

                            <i class="bx bx-upload me-1"></i>
                            @Localizer["Upload"]

                        </button>

                    </div>

                </div>

                <hr />

                <div id="attachmentsLoading"
                     class="text-center py-3"
                     style="display:none;">

                    <div class="spinner-border"></div>

                </div>

                <div id="attachmentsEmpty"
                     class="text-center text-muted py-4"
                     style="display:none;">

                    @Localizer["Noattachments"]

                </div>

                <div id="attachmentsList"
                     class="list-group">
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    @Localizer["Close"]

                </button>

            </div>

        </div>
    </div>
</div>


<script>

document.addEventListener('DOMContentLoaded', function () {
    const noteText = document.getElementById('noteText');
    const clearBtn = document.getElementById('clearNoteBtn');
    const saveNoteBtn = document.getElementById('saveNoteBtn');
    const cancelNoteBtn = document.getElementById('cancelNoteBtn');
    const noteBtn = document.querySelector('.btn-note');

    let lastSavedNote = noteText.value.trim();

    function updateNoteButtonColor() {
        if (noteText.value.trim().length > 0) {
            noteBtn.classList.add('active');
        } else {
            noteBtn.classList.remove('active');
        }
    }

    clearBtn.addEventListener('click', function () {
        noteText.value = '';
        noteText.focus();
        updateNoteButtonColor();
    });

    saveNoteBtn.addEventListener('click', function () {
        const note = noteText.value.trim();
        lastSavedNote = note;
        const hiddenNote = document.getElementById('hiddenNote');
        hiddenNote.value = note;
        noteText.dispatchEvent(new Event('input', { bubbles: true }));

        updateNoteButtonColor();
        const modal = bootstrap.Modal.getInstance(document.getElementById('noteModal'));
        modal.hide();
    });

    cancelNoteBtn.addEventListener('click', function () {
        noteText.value = lastSavedNote;
        updateNoteButtonColor();
    });

    noteText.addEventListener('input', updateNoteButtonColor);
    updateNoteButtonColor();

    updateAttachmentsButton();
});

    async function updateAttachmentsButton() {

        const attachmentsBtn =
            document.getElementById("attachmentsBtn");

        if (!attachmentsBtn)
            return;

        try {

            const entityType =
                document.getElementById("attachmentEntityType").value;

            const entityId =
                document.getElementById("attachmentEntityId").value;

            const url =
                `/Attachments/Get?entityType=${encodeURIComponent(entityType)}&entityId=${encodeURIComponent(entityId)}`;

            const response = await fetch(url);

            if (!response.ok)
                return;

            const attachments =
                await response.json();

            if (attachments && attachments.length > 0) {
                attachmentsBtn.classList.add("active");
            }
            else {
                attachmentsBtn.classList.remove("active");
            }

        }
        catch (error) {

            console.error(error);

        }
    }

async function loadAttachments() {

    const list =
        document.getElementById("attachmentsList");

    const empty =
        document.getElementById("attachmentsEmpty");

    const loading =
        document.getElementById("attachmentsLoading");

    list.innerHTML = "";

    empty.style.display = "none";
    loading.style.display = "block";

    try {

        const entityType =
            document.getElementById("attachmentEntityType").value;

        const entityId =
            document.getElementById("attachmentEntityId").value;

        const url =
            `/Attachments/Get?entityType=${encodeURIComponent(entityType)}&entityId=${encodeURIComponent(entityId)}`;

        const response = await fetch(url);

        if (!response.ok)
            throw new Error(
                attachementLocalization.Failedtoloadattachments
            );

        const attachments = await response.json();

        const attachmentsBtn = document.getElementById("attachmentsBtn");

        if (attachmentsBtn) {
            if (attachments && attachments.length > 0) {
                attachmentsBtn.classList.add("active");
            } else {
                attachmentsBtn.classList.remove("active");
            }
        }

        if (!attachments || attachments.length === 0) {

            empty.style.display = "block";

            return;
        }

        attachments.forEach(attachment => {

            list.appendChild(
                createAttachmentElement(attachment)
            );

        });

    }
    catch (error) {

        console.error(error);

        alert(
            attachementLocalization.Failedtoloadattachments
        );

    }
    finally {

        loading.style.display = "none";
    }
}


function createAttachmentElement(attachment) {

    const item =
        document.createElement("div");

    item.className =
        "list-group-item d-flex align-items-center justify-content-between";


    const fileName =
        document.createElement("span");

    fileName.className =
        "fw-semibold";

    fileName.textContent =
        attachment.fileName;


    const actions =
        document.createElement("div");

    actions.className =
        "d-flex gap-1";


    const downloadButton =
        document.createElement("a");

    downloadButton.href =
        `/Attachments/Download/${attachment.id}`;

    downloadButton.className =
        "btn btn-sm btn-outline-primary";

    downloadButton.innerHTML =
        '<i class="bx bx-download"></i>';


    const deleteButton =
        document.createElement("button");

    deleteButton.type =
        "button";

    deleteButton.className =
        "btn btn-sm btn-outline-danger";

    deleteButton.innerHTML =
        '<i class="bx bx-trash"></i>';

    deleteButton.onclick = () =>
        deleteAttachment(attachment.id);


    actions.appendChild(downloadButton);
    actions.appendChild(deleteButton);

    item.appendChild(fileName);
    item.appendChild(actions);

    return item;
}


async function uploadAttachments() {

    const fileInput =
        document.getElementById("attachmentFiles");

    const uploadButton =
        document.getElementById("uploadAttachmentsBtn");


    if (!fileInput.files.length) {

        alert(
            attachementLocalization.Pleaseselectatleastonefile
        );

        return;
    }

    const entityType =
        document.getElementById("attachmentEntityType").value;

    const entityId =
        document.getElementById("attachmentEntityId").value;


        const formData = new FormData();

    const tokenInput = document.querySelector(
        'input[name="__RequestVerificationToken"]'
    );

    if (!tokenInput) {
        console.error("Anti-forgery token not found.");
        return;
    }

    formData.append(
        "__RequestVerificationToken",
        tokenInput.value
    );

    formData.append(
        "entityType",
        entityType
    );

    formData.append(
        "entityId",
        entityId
    );

    for (const file of fileInput.files) {
        formData.append("files", file);
    }

    uploadButton.disabled = true;

    try {

        const response = await fetch(
            "@Url.Action("Upload", "Attachments")",
            {
                method: "POST",
                body: formData
            });


        if (!response.ok)
            throw new Error(
                attachementLocalization.Uploadfailed
            );


        const result =
            await response.json();


        if (!result.success)
            throw new Error(
                attachementLocalization.Uploadfailed
            );


        fileInput.value = "";

        await loadAttachments();

    }
    catch (error) {

        console.error(error);

        alert(
            attachementLocalization.Faileduploadingfiles
        );

    }
    finally {

        uploadButton.disabled = false;
    }
}


async function deleteAttachment(id) {

    if (!confirm(
        attachementLocalization.Areyousureyouwanttodeletethisfile
    ))
        return;


    const tokenInput = document.querySelector(
        'input[name="__RequestVerificationToken"]'
    );

    if (!tokenInput) {
        console.error("Anti-forgery token not found.");
        return;
    }

    const token = tokenInput.value;


    const formData =
        new FormData();

    formData.append(
        "id",
        id
    );

    formData.append(
        "__RequestVerificationToken",
        token
    );


    try {

        const response = await fetch(
            "@Url.Action("Delete", "Attachments")",
            {
                method: "POST",
                body: formData
            });


        if (!response.ok)
            throw new Error(
                attachementLocalization.Deletefailed
            );


        const result =
            await response.json();


        if (!result.success)
            throw new Error(
                attachementLocalization.Deletefailed
            );


        await loadAttachments();

    }
    catch (error) {

        console.error(error);

        alert(
            attachementLocalization.Failedtodeletethefile
        );
    }
}


document.addEventListener(
        "DOMContentLoaded",
        function () {

            const modal =
                document.getElementById("attachmentsModal");

            if (!modal)
                return;


            modal.addEventListener(
                "shown.bs.modal",
                function () {

                    loadAttachments();

                });
        });
</script>


