@using Partnerly.Models.DataTable
@model Partnerly.Models.DataTable.DataTableOptions


<div id="@Model.Id"
     class="data-table-wrapper"
     data-datatable="true">

@Html.AntiForgeryToken()

    <div class="data-table-header">

        @if (
                !string.IsNullOrWhiteSpace(Model.Name) ||
                !string.IsNullOrWhiteSpace(Model.Icon)
                )
        {
            <div class="data-table-title">

                @if (!string.IsNullOrWhiteSpace(Model.Icon))
                {
                    <span class="data-table-title-icon">
                        <i class="@Model.Icon"></i>
                    </span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Name))
                {
                    <span class="data-table-title-text">
                        @Model.Name
                    </span>
                }

            </div>
        }

        <div class="data-table-toolbar">

        <div class="data-table-toolbar-left">

          @* =========================================================
           TOOLBAR ACTIONS
           ========================================================= *@

            @if (Model.Actions.Enabled)
            {
                foreach (var action in Model.Actions.Items.Where(x => x.Placement == DataTableActionPlacement.Toolbar))
                {
                    if (action.Type == DataTableActionType.Link)
                    {
                        <a href="@action.Url"
                           class="@(string.IsNullOrWhiteSpace(action.CssClass)
                                                      ? "btn btn-primary"
                                                      : action.CssClass)"
                            data-table-action="@action.Name"
                            title="@action.Title">

                            @if (!string.IsNullOrWhiteSpace(action.Icon))
                            {
                                <i class="@action.Icon"></i>
                            }
                            else if (!string.IsNullOrWhiteSpace(action.Title))
                            {
                                <span>
                                    @action.Title
                                </span>
                            }

                        </a>
                    }
                    else
                    {
                        <button type="button"
                                class="@(string.IsNullOrWhiteSpace(action.CssClass)
                                                                ? "btn btn-primary"
                                                                : action.CssClass)"
                            data-table-action="@action.Name"
                            title="@action.Title">

                            @if (!string.IsNullOrWhiteSpace(action.Icon))
                            {
                                <i class="@action.Icon"></i>
                            }
                            else if (!string.IsNullOrWhiteSpace(action.Title))
                            {
                                <span>
                                    @action.Title
                                </span>
                            }

                        </button>
                    }
                }
            }


            @* =========================================================
           RELOAD
           ========================================================= *@

            @if (Model.ReloadEnabled)
            {
                <button type="button"
                        class="data-table-grid-action"
                        data-table-reload
                        title="@Localizer["Reload"]"
                        aria-label="Reload">

                    <span class="data-table-grid-action-icon">
                        <i class="bx bx-refresh"></i>
                    </span>

                </button>
            }


            @* =========================================================
           EXPORT
           ========================================================= *@

            @if (Model.Export.Enabled)
            {
                <div class="data-table-grid-action-dropdown">

                    <button type="button"
                            class="data-table-grid-action"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            title="@Localizer["DataTableExportAll"]"
                            aria-label="Export">

                        <span class="data-table-grid-action-icon">
                            <i class="bx bx-download"></i>
                        </span>

                    </button>

                    <ul class="dropdown-menu data-table-export-menu">

                        @if (Model.Export.Csv)
                        {
                            <li>
                                <button type="button"
                                        class="dropdown-item"
                                        data-table-export="csv">

                                    <i class="bx bx-file"></i>

                                    <span>
                                        CSV
                                    </span>

                                </button>
                            </li>
                        }

                        @if (Model.Export.Excel)
                        {
                            <li>
                                <button type="button"
                                        class="dropdown-item"
                                        data-table-export="excel">

                                    <i class="bx bx-spreadsheet"></i>

                                    <span>
                                        Excel
                                    </span>

                                </button>
                            </li>
                        }

                        @if (Model.Export.Print)
                        {
                            <li>
                                <button type="button"
                                        class="dropdown-item"
                                        data-table-export="print">

                                    <i class="bx bx-printer"></i>

                                    <span>
                                       @Localizer["Print"]
                                    </span>

                                </button>
                            </li>
                        }

                    </ul>

                </div>
            }


            @* =========================================================
           FILTERS
           ========================================================= *@

            @if (Model.Filters.Enabled)
            {
                <button type="button"
                        class="data-table-grid-action"
                        data-table-filter-button
                        title="@Localizer["DataTableFilters"]"
                        aria-label="Filters">

                    <span class="data-table-grid-action-icon">
                        <i class="bx bx-filter-alt"></i>
                    </span>

                    <span class="data-table-filter-count"
                          data-table-filter-count>
                        0
                    </span>

                </button>
            }

        </div>


        @* =============================================================
       SEARCH
       ============================================================= *@

        @if (Model.Search.Enabled)
        {
                <div class="data-table-toolbar-search">

                    <div class="data-table-search-wrapper">

                        <input type="text"
                               id="@Model.Id-search"
                               class="form-control data-table-search-input"
                               placeholder="@Model.Search.Placeholder"
                               autocomplete="off" />

                        <button type="button"
                                class="data-table-search-clear"
                                data-table-search-clear
                                aria-label="Clear search"
                                title="Clear search"
                                hidden>

                            <i class="bx bx-x"></i>

                        </button>

                    </div>

                </div>
        }

    </div>

    </div>

    <div class="table-responsive">

        <table class="table @(Model.Rows.Striped ? "table-striped" : "")">

            <thead>

                <tr>

                    @foreach (var column in Model.Columns)
                    {
                        @if (!column.Visible)
                        {
                            continue;
                        }

                        <th data-field="@column.Field" style="@(string.IsNullOrWhiteSpace(column.Width) ? "" : "width:" + column.Width + ";")">

                            @if (
                                Model.Rows.Selectable &&
                                string.Equals(
                                column.Field,
                                "Selected",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="data-table-selected-header">

                                    <input type="checkbox"
                                           class="data-table-select-all"
                                           aria-label="Select all rows" />

                                    @if (column.Sortable && Model.Sorting.Enabled)
                                    {
                                        <button type="button"
                                                class="data-table-sort"
                                                data-field="@column.Field"
                                                title="Sort by selection">

                                            <span class="data-table-sort-icon"></span>

                                        </button>
                                    }

                                </div>
                            }
                            else if (column.Sortable && Model.Sorting.Enabled)
                            {
                                <button type="button"
                                        class="data-table-sort"
                                        data-field="@column.Field">

                                    <span>
                                        @column.Title
                                    </span>

                                    <span class="data-table-sort-icon"></span>

                                </button>
                            }
                            else
                            {
                                @column.Title
                            }

                        </th>
                    }

                    @if
                                        (
                                        (
                                        Model.Actions.Enabled &&
                                        Model.Actions.Items.Any(
                                        x =>
                                        x.Placement ==
                                        DataTableActionPlacement.Row
                                        )
                                        )
                                        ||
                                        (
                                        Model.InlineEditing &&
                                        Model.Columns.Any(
                                        x =>
                                        x.Visible &&
                                        x.Editable
                                        )
                                        )
                                        )
                    {
                        <th data-field="__actions">
                            @Localizer["DataTableActions"]
                        </th>
                    }

                </tr>

            </thead>

            <tbody id="@Model.Id-body">

                <tr>
                    <td colspan="@Model.Columns.Count">
                        @Localizer["LookupLoading"]
                    </td>
                </tr>

            </tbody>

        </table>

    </div>

    <div class="data-table-footer">

        <div id="@Model.Id-info"></div>

        @if (Model.Paging.ShowPageSize)
        {
            <div class="data-table-page-size">

                <label for="@Model.Id-page-size">
                    @Localizer["Pagesize"]
                </label>

                <select id="@Model.Id-page-size"
                        class="form-select"
                        style="width: auto; display: inline-block;">

                    @foreach (var size in Model.Paging.PageSizeOptions)
                    {
                        <option value="@size"
                                selected="@(size == Model.Paging.PageSize ? "selected" : null)">
                            @size
                        </option>
                    }

                </select>

            </div>
        }

        <div id="@Model.Id-pagination"></div>

    </div>

    @if (Model.Filters.Enabled)
    {
        <div class="modal fade"
             id="@Model.Id-filter-modal"
             tabindex="-1"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered modal-lg">

                <div class="modal-content data-table-filter-modal">

                    <div class="modal-header">

                        <div>

                            <div class="data-table-filter-modal-title">

                                <span class="data-table-filter-modal-title-icon">
                                    <i class="bx bx-filter-alt"></i>
                                </span>

                                <span>
                                    @Localizer["DataTableFilters"]
                                </span>

                            </div>

                        </div>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>

                    <div class="modal-body">

                        <div id="@Model.Id-filter-modal-body"
                             class="data-table-filter-modal-body">

                            @foreach (var filter in Model.Filters.Items)
                            {
                                <div class="data-table-modal-filter"
                                     data-filter-field="@filter.Field">

                                    <label class="data-table-modal-filter-label">
                                        @filter.Label
                                    </label>

                                    @if (filter.Type == DataTableFilterType.Text)
                                    {
                                        <input type="text"
                                               class="form-control data-table-modal-filter-control"
                                               data-field="@filter.Field"
                                               data-filter-type="text"
                                               placeholder="@filter.Placeholder" />
                                    }

                                    @if (filter.Type == DataTableFilterType.Boolean)
                                    {
                                        <select class="form-select data-table-modal-filter-control"
                                                data-field="@filter.Field"
                                                data-filter-type="boolean">

                                            <option value="">@Localizer["DataTableAll"]</option>
                                            <option value="true">@Localizer["DataTableYes"]</option>
                                            <option value="false">@Localizer["DataTableNo"]</option>

                                        </select>
                                    }

                                    @if (filter.Type == DataTableFilterType.Select)
                                    {
                                        <select class="form-select data-table-modal-filter-control"
                                                data-field="@filter.Field"
                                                data-filter-type="select">

                                            <option value="">@Localizer["DataTableAll"]</option>

                                            @foreach (var option in filter.Options)
                                            {
                                                <option value="@option.Value">
                                                    @option.Label
                                                </option>
                                            }

                                        </select>
                                    }

                                    @if (filter.Type == DataTableFilterType.MultiSelect)
                                    {
                                        <div class="data-table-modal-multiselect"
                                             data-field="@filter.Field">

                                            <button type="button"
                                                    class="data-table-modal-multiselect-button">

                                                <span class="data-table-modal-multiselect-text">
                                                    @Localizer["DataTableAll"]
                                                </span>

                                                <i class="bx bx-chevron-down"></i>

                                            </button>

                                            <div class="data-table-modal-multiselect-dropdown">

                                                @foreach (var option in filter.Options)
                                                {
                                                    <label class="data-table-modal-multiselect-option">

                                                        <input type="checkbox"
                                                               value="@option.Value" />

                                                        <span>
                                                            @option.Label
                                                        </span>

                                                    </label>
                                                }

                                            </div>

                                        </div>
                                    }

                                    @if (filter.Type == DataTableFilterType.Number)
                                    {
                                        <input type="number"
                                               class="form-control data-table-modal-filter-control"
                                               data-field="@filter.Field"
                                               data-filter-type="number"
                                               placeholder="@filter.Placeholder" />
                                    }

                                    @if (filter.Type == DataTableFilterType.NumberRange)
                                    {
                                        <div class="data-table-modal-range">

                                            <div class="data-table-modal-range-item">

                                                <input type="number"
                                                       class="form-control data-table-modal-range-control"
                                                       data-field="@filter.Field"
                                                       data-range="min"
                                                       placeholder="@(filter.Placeholder ?? Localizer["DataTableFrom"])" />

                                            </div>

                                            <span class="data-table-modal-range-separator">
                                                —
                                            </span>

                                            <div class="data-table-modal-range-item">

                                                <input type="number"
                                                       class="form-control data-table-modal-range-control"
                                                       data-field="@filter.Field"
                                                       data-range="max"
                                                       placeholder="@(filter.Placeholder ?? Localizer["DataTableTo"])" />

                                            </div>

                                        </div>
                                    }

                                    @if (filter.Type == DataTableFilterType.Date)
                                    {
                                        <input type="date"
                                               class="form-control data-table-modal-filter-control"
                                               data-field="@filter.Field"
                                               data-filter-type="date" />
                                    }

                                    @if (filter.Type == DataTableFilterType.DateRange)
                                    {
                                        <div class="data-table-modal-range">

                                            <div class="data-table-modal-range-item">

                                                <input type="date"
                                                       class="form-control data-table-modal-range-control"
                                                       data-field="@filter.Field"
                                                       data-range="min"
                                                       placeholder="@(filter.Placeholder ?? Localizer["DataTableFrom"])" />

                                            </div>

                                            <span class="data-table-modal-range-separator">
                                                —
                                            </span>

                                            <div class="data-table-modal-range-item">

                                                <input type="date"
                                                       class="form-control data-table-modal-range-control"
                                                       data-field="@filter.Field"
                                                       data-range="max"
                                                       placeholder="@(filter.Placeholder ?? Localizer["DataTableTo"])" />

                                            </div>

                                        </div>
                                    }

                                </div>
                            }

                        </div>

                    </div>

                    <div class="modal-footer data-table-filter-modal-footer">

                        <button type="button"
                                class="btn btn-light"
                                data-table-filter-reset>

                            <i class="bx bx-undo"></i>
                            @Localizer["DataTableReset"]

                        </button>

                        <div class="data-table-filter-modal-footer-right">

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    data-bs-dismiss="modal">

                                @Localizer["Cancel"]

                            </button>

                            <button type="button"
                                    class="btn btn-primary"
                                    data-table-filter-apply>

                                <i class="bx bx-check"></i>
                                @Localizer["DataTableApply"]

                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    }

    @* 
        =========================================================
        DATATABLE CONFIGURATION
        =========================================================
    *@


    <script type="application/json"
            id="@Model.Id-config">

        @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                    new
                    {
                            id = Model.Id,
                            ajaxUrl = Model.AjaxUrl,
                            keyField = Model.KeyField,
                            exportUrl = Model.ExportUrl,
                            autoLoad = Model.AutoLoad,
                            rememberState = Model.RememberState,
                            columnResizeEnabled = Model.ColumnResizeEnabled,
                            columnResizeMinWidth = Model.ColumnResizeMinWidth,

                            inlineEditing = Model.InlineEditing,
                            inlineUpdateUrl = Model.InlineUpdateUrl,
                            @* inlineCreateUrl = Model.InlineCreateUrl,
                            inlineDeleteUrl = Model.InlineDeleteUrl, *@

                            paging = new
                            {
                                    enabled = Model.Paging.Enabled,
                                    pageSize = Model.Paging.PageSize,
                                    pageSizeOptions = Model.Paging.PageSizeOptions,
                                    showInfo = Model.Paging.ShowInfo,
                                    showPageSize = Model.Paging.ShowPageSize
                            },

                            search = new
                            {
                                    enabled = Model.Search.Enabled,
                                    placeholder = Model.Search.Placeholder,
                                    minLength = Model.Search.MinLength,
                                    debounceMs = Model.Search.DebounceMs
                            },

                            rows = new
                            {
                                    selectable = Model.Rows.Selectable,
                                    clickable = Model.Rows.Clickable,
                                    hover = Model.Rows.Hover,
                                    striped = Model.Rows.Striped
                            },

                            sorting = new
                            {
                                    enabled = Model.Sorting.Enabled,
                                    defaultField = Model.Sorting.DefaultField,
                                    defaultDirection = Model.Sorting.DefaultDirection
                            },

                            columnCount =
                                Model.Columns.Count(x => x.Visible) +
                                (
                                    (
                                        Model.Actions.Enabled &&
                                        Model.Actions.Items.Any(
                                                x =>
                                                        x.Placement ==
                                                        DataTableActionPlacement.Row
                                        )
                                    )
                                    ||
                                    (
                                        Model.InlineEditing &&
                                        Model.Columns.Any(
                                                x =>
                                                        x.Visible &&
                                                        x.Editable
                                        )
                                    )
                                    ? 1
                                    : 0
                                ),

                            columns = Model.Columns.Select(column => new
                            {
                                    field = column.Field,
                                    title = column.Title,
                                    type = column.Type.ToString(),

                                    visible = column.Visible,
                                    required = column.Required,
                                    sortable = column.Sortable,
                                    searchable = column.Searchable,
                                    exportable = column.Exportable,
                                    editable = column.Editable,
                                    resizable = column.Resizable,
                                    width = column.Width,
                                    format = column.Format,
                                    urlTemplate = column.UrlTemplate,
                                    isKey = column.IsKey,

                                    emptyText = column.EmptyText,

                                    alignment = column.Alignment.ToString(),
                                    cssClass = column.CssClass,

                                    valueMappings = column.ValueMappings.Select(option => new
                                            {
                                                    value = option.Value,
                                                    label = option.Label
                                            }),

                                    conditionalStyles = column.ConditionalStyles == null
                                    ? null
                                    : column.ConditionalStyles.Select(x => new
                                    {
                                        conditions = x.Conditions == null
                                        ? null
                                        : x.Conditions.Select(condition => new
                                        {
                                                operatorName = condition.Operator.ToString(),
                                                value = condition.Value
                                        }).ToList(),

                                        cssClass = x.CssClass,
                                        style = x.Style

                                    }).ToList(),

                            }),

                            actions = new
                            {
                                enabled = Model.Actions.Enabled,

                                items = Model.Actions.Items.Select(action => new
                                {
                                        name = action.Name,
                                        title = action.Title,
                                        icon = action.Icon,
                                        type = action.Type.ToString(),
                                        placement = action.Placement.ToString(),
                                        url = action.Url,
                                        method = action.Method,
                                        confirm = action.Confirm,
                                        confirmMessage = action.ConfirmMessage,
                                        cssClass = action.CssClass,
                                        requiresSelection = action.RequiresSelection
                                }).ToList(),
                            },
                            
                            filters = new
                            {
                                    enabled = Model.Filters.Enabled,

                                    items = Model.Filters.Items.Select(filter => new
                                    {
                                            field = filter.Field,
                                            label = filter.Label,
                                            type = filter.Type.ToString(),
                                            placeholder = filter.Placeholder,
                                            defaultValue = filter.DefaultValue,

                                            options = filter.Options.Select(option => new
                                            {
                                                    value = option.Value,
                                                    label = option.Label
                                            })
                                    })
                            },
                    }
            )
                )

    </script>

</div>