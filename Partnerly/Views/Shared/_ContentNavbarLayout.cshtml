@await Html.PartialAsync("Sections/_Variables")

@{
    TempData.Keep();

    Layout = "_CommonMasterLayout";

    ViewData["contentNavbar"] = true;
    ViewData["isNavbar"] = (ViewData["isNavbar"] ??= true);
    ViewData["isMenu"] = (ViewData["isMenu"] ??= true);
    ViewData["isFlex"] = (ViewData["isFlex"] ??= false);
    ViewData["isFooter"] = (ViewData["isFooter"] ??= true);

    ViewData["navbarDetached"] = (ViewData["navbarDetached"] ?? "navbar-detached");

    ViewData["container"] = (ViewData["container"] ?? "container-xxl");
    ViewData["containerNav"] = (ViewData["containerNav"] ?? "container-fluid");
}

@section VendorStyles {
    @RenderSection("VendorStyles", required: false)
}

@section PageStyles {
    @RenderSection("PageStyles", required: false)
}

@section VendorScripts {
    @RenderSection("VendorScripts", required: false)
}

@section PageScripts {
    @RenderSection("PageScripts", required: false)
}

@{
    bool isMenu =
        ViewData["isMenu"] != null &&
        Convert.ToBoolean(ViewData["isMenu"]);

    bool isNavbar =
        ViewData["isNavbar"] != null &&
        Convert.ToBoolean(ViewData["isNavbar"]);

    bool isFooter =
        ViewData["isFooter"] != null &&
        Convert.ToBoolean(ViewData["isFooter"]);
}

<div class="partnerly-layout-page">

    @if (isMenu)
    {
        @await Html.PartialAsync("Sections/Menu/_VerticalMenu")
    }

    <!-- Main page -->
    <div class="partnerly-layout-main">

        <!-- Scrolling ticker -->
        @if (ViewData["ScrollingText"] is string navbarMessage &&
                !string.IsNullOrWhiteSpace(navbarMessage))
        {
            <div class="navbar-marquee">
                <div class="navbar-marquee-content">
                    <i class="bx bx-info-circle me-2"></i>
                    <span>@navbarMessage</span>
                </div>
            </div>
        }

        <!-- Navbar -->
        @if (isNavbar)
        {
            <nav class="partnerly-navbar" id="partnerlyNavbar">
                @await Html.PartialAsync("Sections/Navbar/_NavbarPartial")
            </nav>
        }

        <!-- Content -->
        <main class="partnerly-layout-content">

            <div class="@ViewData["container"] @(Convert.ToBoolean(ViewData["isFlex"]) ? "d-flex align-items-stretch flex-grow-1 p-0" : "container-p-y")">

                @RenderBody()

            </div>

        </main>

        <!-- Footer -->
        @if (isFooter)
        {
            @await Html.PartialAsync("Sections/Footer/_Footer")
        }

    </div>

</div>