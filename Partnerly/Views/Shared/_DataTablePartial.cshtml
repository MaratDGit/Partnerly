<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5>@ViewData["TableName"]</h5>

        @if (ViewData["NewRecordControler"] != null)
        { 
            <a id="btnAddNew" class="btn btn-sm btn-outline-primary" 
               asp-action="Create" asp-controller="@ViewData["NewRecordControler"]">
                <i class="bx bx-plus me-1 fs-6"></i> Создать
            </a>
        }
    </div>

    <div class="table-custom-a custom-datatable-wrapper"> 
        <table id="@ViewData["TableId"]"></table>
    </div>

    <div class="custom-datatable-pagination"></div> 
</div>
