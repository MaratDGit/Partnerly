@model Partnerly.Models.ViewModels.LogsViewModel;

@{
    ViewData["Title"] = "Log";
    Layout = "_ContentNavbarLayout";
}

<div class="log-details-page">

    <div class="card log-details-card">

        <div class="card-header log-details-header">
            <div class="log-details-title">
                <div class="log-details-title-icon">
                    <i class="bx bx-file-find"></i>
                </div>

                <div>
                    <span>@Localizer["Details"]</span>
                </div>
            </div>
        </div>

        <div class="card-body log-details-body">

            <form id="logViewForm" asp-action="">

                @await Html.PartialAsync("_StickyButtons", new Partnerly.Models.ViewModels.FormActionsViewModel {
                Back = new Partnerly.Models.ViewModels.ActionBack(
                id: Model.Id,
                visible: true,
                fromController: "LogRecords",
                toController: "LogRecords",
                fromAction: "View",
                toAction: "Index"
                ),
                                })

                <input type="hidden" asp-for="Id" />

                <div class="log-section">

                    <div class="log-section-title">
                        <i class="bx bx-info-circle"></i>
                        <span>@Localizer["Information"]</span>
                    </div>

                    <div class="log-fields">

                        <div class="form-floating log-field">
                            <input asp-for="ActionView"
                                   class="form-control"
                                   id="action"
                                   name="action"
                                   readonly />
                            <label asp-for="Action"></label>
                        </div>

                        <div class="form-floating log-field">
                            <input asp-for="TypeView"
                                   class="form-control"
                                   id="type"
                                   name="type"
                                   readonly />
                            <label asp-for="Type"></label>
                        </div>

                        <div class="form-floating log-field">
                            <input asp-for="FilePath"
                                   class="form-control"
                                   id="filePath"
                                   name="filePath"
                                   readonly />
                            <label asp-for="FilePath"></label>
                        </div>

                        <div class="form-floating log-field">
                            <input asp-for="Method"
                                   class="form-control"
                                   id="method"
                                   name="method"
                                   readonly />
                            <label asp-for="Method"></label>
                        </div>

                        <div class="form-floating log-field">
                            <input asp-for="LineNumber"
                                   class="form-control"
                                   id="lineNumber"
                                   name="lineNumber"
                                   readonly />
                            <label asp-for="LineNumber"></label>
                        </div>

                        <div class="form-floating log-field">
                            <input asp-for="CreatedByUserName"
                                   class="form-control"
                                   id="createdByUserName"
                                   name="createdByUserName"
                                   readonly />
                            <label asp-for="CreatedByUserName"></label>
                        </div>

                        <div class="form-floating log-field">
                            <input asp-for="CreatedDate"
                                   class="form-control"
                                   id="createdDate"
                                   name="createdDate"
                                   readonly />
                            <label asp-for="CreatedDate"></label>
                        </div>

                    </div>

                </div>

                <div class="log-section log-message-section">

                    <div class="log-section-title">
                        <i class="bx bx-message-detail"></i>
                        <span>@Localizer["Message"]</span>
                    </div>

                    <div class="form-floating">
                        <textarea asp-for="LogMessage"
                                  id="logMessage"
                                  class="form-control log-message"
                                  rows="10"
                                  readonly></textarea>
                        <label asp-for="LogMessage"></label>
                    </div>

                </div>

            </form>

        </div>

    </div>

</div>

<style>
    .log-details-page {
        padding: 0;
    }

    .log-details-card {
        border: 1px solid rgba(67, 89, 113, 0.10);
        border-radius: 14px;
        box-shadow: 0 4px 16px rgba(67, 89, 113, 0.06);
        overflow: hidden;
    }

    /* Header */

    .log-details-header {
        display: flex;
        align-items: center;
        min-height: 68px;
        padding: 14px 20px;
        border-bottom: 1px solid rgba(67, 89, 113, 0.08);
        background: #fff;
    }

    .log-details-title {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .log-details-title-icon {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 36px;
        border-radius: 10px;
        background: rgba(105, 108, 255, 0.10);
        color: #696cff;
    }

        .log-details-title-icon i {
            font-size: 20px;
            line-height: 1;
        }

    .log-details-title h5 {
        margin: 0;
        color: #384551;
        font-size: 16px;
        font-weight: 600;
        line-height: 1.3;
    }

    .log-details-title span {
        display: block;
        margin-top: 2px;
        color: #a1acb8;
        font-size: 12px;
        line-height: 1.3;
    }

    /* Body */

    .log-details-body {
        padding: 0 24px 24px;
    }

        /* Sticky buttons */

        .log-details-body .sticky-buttons {
            margin: 0 -24px 24px;
            padding: 10px 24px;
            border-bottom: 1px solid rgba(67, 89, 113, 0.08);
            background: #fff;
        }

    /* Sections */

    .log-section {
        margin-bottom: 24px;
    }

        .log-section:last-child {
            margin-bottom: 0;
        }

    .log-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
        color: #566a7f;
        font-size: 13px;
        font-weight: 600;
    }

        .log-section-title i {
            color: #696cff;
            font-size: 18px;
        }

    /* Fields */

    .log-fields {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .log-field {
        max-width: none !important;
        margin-bottom: 0 !important;
    }

        .log-field .form-control {
            min-height: 52px;
            border-color: rgba(67, 89, 113, 0.16);
            background: #f8f8fa;
            color: #566a7f;
            font-size: 13px;
            cursor: default;
        }

            .log-field .form-control:focus {
                border-color: rgba(105, 108, 255, 0.25);
                box-shadow: none;
            }

        .log-field label {
            color: #8592a3;
            font-size: 12px;
        }

    /* Message */

    .log-message-section {
        padding-top: 4px;
    }

    .log-message {
        min-height: 220px !important;
        resize: vertical;
        border-color: rgba(67, 89, 113, 0.16);
        background: #f8f8fa;
        color: #566a7f;
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: 13px;
        line-height: 1.6;
    }

        .log-message:focus {
            border-color: rgba(105, 108, 255, 0.25);
            box-shadow: none;
        }

    /* Responsive */

    @@media (max-width: 767.98px) {
        .log-details-body

    {
        padding: 0 16px 18px;
    }

    .log-details-body .sticky-buttons {
        margin-left: -16px;
        margin-right: -16px;
        padding-left: 16px;
        padding-right: 16px;
    }

    .log-fields {
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .log-section {
        margin-bottom: 20px;
    }

    }

    @@media (max-width: 575.98px) {
        .log-details-header

    {
        padding: 12px 16px;
    }

    .log-details-title-icon {
        width: 34px;
        height: 34px;
        flex-basis: 34px;
    }

    .log-details-body {
        padding-left: 12px;
        padding-right: 12px;
    }

        .log-details-body .sticky-buttons {
            margin-left: -12px;
            margin-right: -12px;
            padding-left: 12px;
            padding-right: 12px;
        }

    }
</style>