@model Partnerly.Models.ViewModels.LogsViewModel;

@{
    ViewData["Title"] = "Сообщение";
    Layout = "_ContentNavbarLayout";
}

<div class="card">
    <div class="card-header justify-content-between">
        <h5>@ViewData["Title"]</h5>
    </div>

    <div class="card-body">
        <form id="logViewForm" asp-action="">
            
            @await Html.PartialAsync("_StickyButtons", new Partnerly.Models.ViewModels.FormActionsViewModel {
                Back = new Partnerly.Models.ViewModels.ActionBack(id:Model.Id, visible: true, fromController: "LogRecords", toController: "LogRecords", fromAction: "View", toAction: "Index"),
            })
            <input type="hidden" asp-for="Id" />

            <div class="form-floating mb-1 max-w-600">
                <input asp-for="ActionView" class="form-control" id="action" name="action" readonly/>
                <label asp-for="Action"></label>
            </div>
            <div class="form-floating mb-1 max-w-600">
                <input asp-for="TypeView" class="form-control" id="type" name="type" readonly />
                <label asp-for="Type"></label>
            </div>
            <div class="form-floating mb-1 max-w-600">
                <input asp-for="FilePath" class="form-control" id="filePath" name="filePath" readonly />
                <label asp-for="FilePath"></label>
            </div>
            <div class="form-floating mb-1 max-w-600">
                <input asp-for="Method" class="form-control" id="method" name="method" readonly />
                <label asp-for="Method"></label>
            </div>
            <div class="form-floating mb-1 max-w-600">
                <input asp-for="LineNumber" class="form-control" id="lineNumber" name="lineNumber" readonly />
                <label asp-for="LineNumber"></label>
            </div>
            <div class="form-floating mb-1 max-w-600">
                <input asp-for="CreatedBy" class="form-control" id="createdBy" name="createdBy" readonly />
                <label asp-for="CreatedBy"></label>
            </div>
            <div class="form-floating mb-1 max-w-600">
                <input asp-for="CreatedDate" class="form-control" id="createdDate" name="createdDate" readonly />
                <label asp-for="CreatedDate"></label>
            </div>
            <div class="form-floating mb-1">
               <textarea asp-for="LogMessage"  id="logMessage" class="form-control" style="height: 300px" rows="10" readonly></textarea>
               <label asp-for="LogMessage"></label>
            </div>
        </form>
    </div>
</div>



