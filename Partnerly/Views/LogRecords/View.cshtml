@model Partnerly.Models.ViewModels.LogsViewModel;

@{
    ViewData["Title"] = "Сообщение";
    Layout = "_ContentNavbarLayout";
}

<div class="card">
    <div class="card-header justify-content-between">
        <h5>@ViewData["Title"]</h5>
    </div>

    <div class="card-body">
        <form id="logViewForm" asp-action="">
            <div class="sticky-buttons justify-content-between mb-6">
                 <a asp-action="Index" class="btn btn-sm btn-outline-primary">
                    <i class="bx bx-arrow-back me-1"></i> 
                </a>
            </div>

            <input type="hidden" asp-for="Id" />

            <div class="form-floating mb-1 max-w-600">
                <input asp-for="ActionView" class="form-control" id="action" name="action" readonly/>
                <label asp-for="Action"></label>
            </div>
            <div class="form-floating mb-1">
               <textarea asp-for="LogMessage"  id="logMessage" class="form-control" style="height: 300px" rows="10" readonly></textarea>
               <label asp-for="LogMessage"></label>
            </div>
        </form>
    </div>
</div>



