@model Partnerly.Controllers.RolePermissionsViewModel

@{
    ViewData["Title"] = "Role Permissions";
    Layout = "_ContentNavbarLayout";

    var groups = Model.Permissions
        .GroupBy(p => p.Module)
        .OrderBy(g => g.Key);
}

<div class="card">
    <div class="container-fluid py-4">
    <h2>Permissions: @Model.RoleName</h2>

    <p class="text-muted">
        Select the actions available to this role.
    </p>

    <div asp-validation-summary="All"
         class="text-danger mb-3"></div>

    <form asp-action="SaveRolePermissions"
          asp-route-id="@Model.RoleId"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="RoleId" type="hidden" />
        <input asp-for="RoleName" type="hidden" />

        @for (var i = 0; i < Model.Permissions.Count; i++)
        {
            <input asp-for="Permissions[i].PermissionId"
                   type="hidden" />

            <input asp-for="Permissions[i].Code"
                   type="hidden" />

            <input asp-for="Permissions[i].Name"
                   type="hidden" />

            <input asp-for="Permissions[i].Module"
                   type="hidden" />
        }

        @foreach (var group in groups)
        {
            <section class="card mb-3">
                <div class="card-header">
                    <strong>@group.Key</strong>
                </div>

                <div class="card-body">
                    @foreach (var permission in group)
                    {
                        var index = Model.Permissions.IndexOf(permission);

                        <div class="form-check mb-2">
                            <input class="form-check-input"
                                   asp-for="Permissions[index].Selected" />

                            <label class="form-check-label"
                                   asp-for="Permissions[index].Selected">
                                @permission.Code
                            </label>
                        </div>
                    }
                </div>
            </section>
        }

        <button type="submit" class="btn btn-primary">
            Save permissions
        </button>

        <a asp-action="Roles" class="btn btn-outline-secondary">
            Cancel
        </a>
    </form>
</div>
</div>