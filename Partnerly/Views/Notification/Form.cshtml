@model Partnerly.Models.ViewModels.NotificationsViewModel
@await Html.PartialAsync("_Toast")

@{
    bool isEdit = Model.Id != Guid.Empty;

    ViewData["Title"] = Model.Title;
    Layout = "_ContentNavbarLayout";
}

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="mb-0">
            @(isEdit
                        ? Localizer["Editnotification"]
                        : Localizer["Createanotification"])
        </h5>

        @if (isEdit)
        {
            @await Html.PartialAsync("_AuditInfo", Model)
        }
    </div>

    <div class="card-body">
        <form id="notificationForm"
              asp-action="@(isEdit ? "Edit" : "Create")"
              method="post">

            @await Html.PartialAsync("_StickyButtons", Model.StickyButtons)

            <input type="hidden" asp-for="Id" />

            @if (isEdit)
            {
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Type" />
                <input type="hidden" asp-for="Note" />

                <div class="form-floating mb-1 max-w-600">
                    <input asp-for="CreatorName"
                           id="creatorName"
                           class="form-control"
                           readonly />

                    <label asp-for="CreatorName"></label>
                </div>

                <div class="form-floating mb-1 max-w-600">
                    <input asp-for="OwnerName"
                           id="ownerUserFullName"
                           class="form-control"
                           readonly />

                    <label asp-for="OwnerName"></label>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="UserId" id="assignedTo" />

                <div class="form-floating mb-1 max-w-600 position-relative">
                    <input asp-for="OwnerName"
                           id="ownerName"
                           name="OwnerName"
                           type="text"
                           class="form-control lookup-input pe-5"
                           placeholder=" "
                           data-lookup="true"
                           data-lookup-source="/Users/GetLookupList"
                           data-lookup-title="@Localizer["Users"]"
                           data-edit-url-base=""
                           data-lookup-column-names="name:@Localizer["Name"],email:@Localizer["Email"]"
                           data-lookup-display-field="OwnerName"
                           data-lookup-param="fieldName"
                           data-lookup-param-value="Name"
                           data-lookup-target-id="assignedTo"
                           readonly />

                    <label asp-for="OwnerName"></label>

                    <i class="bx bx-search lookup-icon"></i>

                    <span asp-validation-for="UserId"
                          class="text-danger"></span>
                </div>
            }

            <div class="form-floating mb-1 max-w-600">
                <textarea asp-for="Message"
                          id="message"
                          class="form-control"
                          style="height: 200px"
                          rows="10"></textarea>

                <label asp-for="Message"></label>

                <span asp-validation-for="Message"
                      class="text-danger"></span>
            </div>

            <div class="form-floating mb-1 max-w-600">
                <textarea asp-for="Link"
                          id="link"
                          class="form-control"
                          style="height: 100px"
                          rows="10"></textarea>

                <label asp-for="Link"></label>

                <span asp-validation-for="Link"
                      class="text-danger"></span>
            </div>

            @if (isEdit)
            {
                <div class="form-check form-switch mb-2">
                    <input asp-for="IsReadBool"
                           class="form-check-input"
                           type="checkbox"
                           id="isRead" />

                    <label class="form-check-label" asp-for="IsRead" for="isRead"></label>
                </div>
            }
        </form>
    </div>
</div>

<script src="~/assets/js/form-change-tracker.js"></script>

<script>
    enableSaveOnChange("#notificationForm", "#btnSave");
</script>