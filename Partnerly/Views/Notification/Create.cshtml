@model Partnerly.Models.ViewModels.NotificationsViewModel;
@await Html.PartialAsync("_Toast")

@{
    ViewData["Title"] = "Create a notification";
    Layout = "_ContentNavbarLayout";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5>@Localizer["Createanotification"]</h5>
    </div>

    <div class="card-body">
        <form id="notificationForm" asp-action="Create">

            @await Html.PartialAsync("_StickyButtons", new Partnerly.Models.ViewModels.FormActionsViewModel {
                Back = new Partnerly.Models.ViewModels.ActionBack(id: Model.Id, visible: true, fromController: "Notification", toController: "Notification", fromAction: "Create", toAction: "Index"),
                Undo = new Partnerly.Models.ViewModels.ActionUndo(id: Model.Id, visible: true, fromController: "Notification", toController: "Notification", fromAction: "Create", toAction: "Create"),
                Save = new Partnerly.Models.ViewModels.ActionSave(id: Model.Id, visible: true, fromController: "Notification", toController: "Notification", fromAction: "Edit", toAction: "Edit"),
                        
            })

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" id="assignedTo" />

            <div class="form-floating mb-1 max-w-600 position-relative">
                <input asp-for="OwnerName"
                       id="ownerName"
                       name="ownerName"
                       type="text"
                       class="form-control lookup-input pe-5"
                       placeholder=" "
                       data-lookup="true"
                       data-lookup-source="/Users/GetLookupList"
                       data-lookup-title=@Localizer["Users"]
                       data-edit-url-base=""
                       data-lookup-column-names="name:@Localizer["Name"],email:@Localizer["Email"]"
                       data-lookup-display-field="OwnerName"
                       data-lookup-param="fieldName"
                       data-lookup-param-value="Name"
                       data-lookup-target-id="assignedTo"
                       readonly />
                <label asp-for="OwnerName"></label>
                <i class='bx bx-search lookup-icon'></i>
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>
            <div class="form-floating mb-1 max-w-600">
                <textarea asp-for="Message" id="bodyHtml" class="form-control" style="height: 200px" rows="10"></textarea>
                <label asp-for="Message"></label>
                <span asp-validation-for="Message" class="text-danger"></span>
            </div>
            <div class="form-floating mb-1 max-w-600">
                <textarea asp-for="Link" id="link" class="form-control" style="height: 100px" rows="10"></textarea>
                <label asp-for="Link"></label>
                <span asp-validation-for="Link" class="text-danger"></span>
            </div>
        </form>
    </div>
</div>

<script src="~/js/form-change-tracker.js"></script>
<script>
    enableSaveOnChange("#notificationForm", "#btnSave");
</script>