@model Partnerly.Models.ViewModels.NotificationsViewModel;
@await Html.PartialAsync("_Toast")

@{
    ViewData["Title"] = "Deleting the notification";
    Layout = "_ContentNavbarLayout";
}

@await Html.PartialAsync(
"_DeleteConfirmation",
    new Partnerly.Models.ViewModels.DeleteConfirmationViewModel
    {
        Id = Model.Id,
        Title = Localizer["Deletingthenotification"],
        Message = Localizer["Areyousureyouwanttodeletethisfile"],
        DeleteAction = "DeleteConfirmed",
        DeleteController = "Notification",
        CancelAction = "Index",
        CancelController = "Notification"
    })