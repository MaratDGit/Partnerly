@model Partnerly.Integrations.Web.IntegrationsViewModel
@{
    ViewData["Title"] = Localizer["Integrations"].Value;
}

@section PageStyles {
    <link rel="stylesheet" href="~/assets/css/integrations.css" asp-append-version="true" />
}

<div class="container-xxl flex-grow-1 container-p-y integrations-page"
     id="integrationsRoot"
     data-confirm-delete="@Localizer["IntegrationDeleteConfirm"]"
     data-no-chats="@Localizer["IntegrationNoChats"]"
     data-use-chat="@Localizer["IntegrationUseChat"]"
     data-copied="@Localizer["Copied"]"
     data-confirm-renew="@Localizer["ComputerRenewConfirm"]">
    @Html.AntiForgeryToken()

    <header class="integrations-head">
        <a class="btn btn-outline-primary integrations-head-link" asp-controller="Automation" asp-action="Index">
            <i class="bx bx-bot" aria-hidden="true"></i> @Localizer["Agents"]
        </a>
    </header>

    @if (!string.IsNullOrEmpty(Model.Flash))
    {
        <div class="integrations-flash @(Model.FlashIsError ? "is-error" : "is-ok")" role="status">@Model.Flash</div>
    }
    <div class="integrations-toast" data-int-toast role="status" aria-live="polite" hidden></div>

    <div class="integrations-grid">
        @* ---------- Computer ---------- *@
        <section class="integrations-card" data-service="computer">
            <button type="button" class="btn btn-primary integrations-connect" data-int-open="computer">
                <i class="bx bx-plus" aria-hidden="true"></i> @Localizer["IntegrationConnect"]
            </button>
            <div class="integrations-card-head">
                <span class="integrations-logo is-computer"><i class="bx bx-desktop" aria-hidden="true"></i></span>
                <div>
                    <h2>@Localizer["ComputerTitle"]</h2>
                    <p>@Localizer["IntegrationComputerIntro"]</p>
                </div>
            </div>
            <ul class="integrations-features">
                <li><i class="bx bx-folder-open" aria-hidden="true"></i> @Localizer["IntegrationComputerFeature1"]</li>
                <li><i class="bx bx-bell" aria-hidden="true"></i> @Localizer["IntegrationComputerFeature2"]</li>
                <li><i class="bx bx-shield-quarter" aria-hidden="true"></i> @Localizer["IntegrationComputerFeature3"]</li>
            </ul>
            @await Html.PartialAsync("~/Views/Integrations/_ConnectionList.cshtml", Model.Computers)
        </section>

        @* ---------- Telegram ---------- *@
        <section class="integrations-card" data-service="telegram">
            <button type="button" class="btn btn-primary integrations-connect" data-int-open="telegram">
                <i class="bx bx-plus" aria-hidden="true"></i> @Localizer["IntegrationConnect"]
            </button>
            <div class="integrations-card-head">
                <span class="integrations-logo is-telegram"><i class="bx bxl-telegram" aria-hidden="true"></i></span>
                <div>
                    <h2>Telegram</h2>
                    <p>@Localizer["IntegrationTelegramIntro"]</p>
                </div>
            </div>
            <ul class="integrations-features">
                <li>@Localizer["IntegrationTelegramFeature1"]</li>
                <li>@Localizer["IntegrationTelegramFeature2"]</li>
            </ul>
            @await Html.PartialAsync("~/Views/Integrations/_ConnectionList.cshtml", Model.Telegram)
        </section>

        @* ---------- Google ---------- *@
        <section class="integrations-card" data-service="google">
            <button type="button" class="btn btn-primary integrations-connect" data-int-open="google" disabled="@(Model.GoogleConfigured ? null : "disabled")">
                <i class="bx bx-plus" aria-hidden="true"></i> @Localizer["IntegrationConnect"]
            </button>
            <div class="integrations-card-head">
                <span class="integrations-logo is-google"><i class="bx bxl-google" aria-hidden="true"></i></span>
                <div>
                    <h2>Google</h2>
                    <p>@Localizer["IntegrationGoogleIntro"]</p>
                </div>
            </div>
            <ul class="integrations-features">
                <li><i class="bx bx-spreadsheet" aria-hidden="true"></i> Google Sheets</li>
                <li><i class="bx bx-envelope" aria-hidden="true"></i> Gmail</li>
                <li><i class="bx bxl-google-cloud" aria-hidden="true"></i> Google Drive</li>
            </ul>
            @if (!Model.GoogleConfigured)
            {
                <div class="integrations-note is-warn">@Localizer["IntegrationGoogleNotConfigured"]</div>
            }
            @await Html.PartialAsync("~/Views/Integrations/_ConnectionList.cshtml", Model.Google)
        </section>

        @* ---------- Microsoft (Outlook) ---------- *@
        <section class="integrations-card" data-service="microsoft">
            <button type="button" class="btn btn-primary integrations-connect" data-int-open="microsoft" disabled="@(Model.MicrosoftConfigured ? null : "disabled")">
                <i class="bx bx-plus" aria-hidden="true"></i> @Localizer["IntegrationConnect"]
            </button>
            <div class="integrations-card-head">
                <span class="integrations-logo is-microsoft"><i class="bx bxl-microsoft" aria-hidden="true"></i></span>
                <div>
                    <h2>Outlook</h2>
                    <p>@Localizer["IntegrationMicrosoftIntro"]</p>
                </div>
            </div>
            <ul class="integrations-features">
                <li><i class="bx bx-envelope" aria-hidden="true"></i> Outlook Mail</li>
                <li><i class="bx bx-calendar" aria-hidden="true"></i> Outlook Calendar</li>
            </ul>
            @if (!Model.MicrosoftConfigured)
            {
                <div class="integrations-note is-warn">@Localizer["IntegrationMicrosoftNotConfigured"]</div>
            }
            @await Html.PartialAsync("~/Views/Integrations/_ConnectionList.cshtml", Model.Microsoft)
        </section>

        @* ---------- GitHub ---------- *@
        <section class="integrations-card" data-service="github">
            <button type="button" class="btn btn-primary integrations-connect" data-int-open="@(Model.GitHubConfigured ? "github" : "github-token")">
                <i class="bx bx-plus" aria-hidden="true"></i> @Localizer["IntegrationConnect"]
            </button>
            <div class="integrations-card-head">
                <span class="integrations-logo is-github"><i class="bx bxl-github" aria-hidden="true"></i></span>
                <div>
                    <h2>GitHub</h2>
                    <p>@Localizer["IntegrationGitHubIntro"]</p>
                </div>
            </div>
            <ul class="integrations-features">
                <li>@Localizer["IntegrationGitHubFeature1"]</li>
                <li>@Localizer["IntegrationGitHubFeature2"]</li>
            </ul>
            @if (!Model.GitHubConfigured)
            {
                <div class="integrations-note is-warn">@Localizer["IntegrationGitHubNotConfigured"]</div>
            }
            @await Html.PartialAsync("~/Views/Integrations/_ConnectionList.cshtml", Model.GitHub)
        </section>

        @* ---------- WhatsApp ---------- *@
        <section class="integrations-card" data-service="whatsapp">
            <button type="button" class="btn btn-primary integrations-connect" data-int-open="whatsapp">
                <i class="bx bx-plus" aria-hidden="true"></i> @Localizer["IntegrationConnect"]
            </button>
            <div class="integrations-card-head">
                <span class="integrations-logo is-whatsapp"><i class="bx bxl-whatsapp" aria-hidden="true"></i></span>
                <div>
                    <h2>WhatsApp</h2>
                    <p>@Localizer["IntegrationWhatsAppIntro"]</p>
                </div>
            </div>
            <ul class="integrations-features">
                <li>@Localizer["IntegrationWhatsAppFeature1"]</li>
                <li>@Localizer["IntegrationWhatsAppFeature2"]</li>
            </ul>
            @await Html.PartialAsync("~/Views/Integrations/_ConnectionList.cshtml", Model.WhatsApp)
        </section>

    </div>

    @* ---------- Dialogs ---------- *@
    <div class="integrations-overlay" data-int-dialog="telegram" hidden aria-hidden="true">
        <form class="integrations-dialog" method="post" asp-action="ConnectTelegram" data-int-form>
            <header>
                <span class="integrations-logo is-telegram"><i class="bx bxl-telegram" aria-hidden="true"></i></span>
                <h3>@Localizer["IntegrationConnectTelegram"]</h3>
                <button type="button" class="integrations-close" data-int-close aria-label="@Localizer["Close"]"><i class="bx bx-x"></i></button>
            </header>
            <ol class="integrations-steps">
                <li>@Localizer["IntegrationTelegramStep1"]</li>
                <li>@Localizer["IntegrationTelegramStep2"]</li>
                <li>@Localizer["IntegrationTelegramStep3"]</li>
            </ol>
            <label class="form-label" for="tgName">@Localizer["Name"]</label>
            <input class="form-control" id="tgName" name="name" placeholder="@Localizer["IntegrationNameOptional"]" />
            <label class="form-label" for="tgToken">@Localizer["IntegrationBotToken"]</label>
            <input class="form-control" id="tgToken" name="botToken" required autocomplete="off" spellcheck="false" placeholder="123456:ABC-DEF..." />
            <label class="form-label" for="tgChat">@Localizer["IntegrationDefaultChat"]</label>
            <input class="form-control" id="tgChat" name="defaultChatId" placeholder="@Localizer["IntegrationDefaultChatHelp"]" />
            <footer>
                <button type="button" class="btn btn-outline-secondary" data-int-close>@Localizer["Cancel"]</button>
                <button type="submit" class="btn btn-primary">@Localizer["IntegrationConnect"]</button>
            </footer>
        </form>
    </div>

    <div class="integrations-overlay" data-int-dialog="google" hidden aria-hidden="true">
        <form class="integrations-dialog" method="post" asp-action="ConnectGoogle" data-int-form>
            <header>
                <span class="integrations-logo is-google"><i class="bx bxl-google" aria-hidden="true"></i></span>
                <h3>@Localizer["IntegrationConnectGoogle"]</h3>
                <button type="button" class="integrations-close" data-int-close aria-label="@Localizer["Close"]"><i class="bx bx-x"></i></button>
            </header>
            <p class="integrations-muted">@Localizer["IntegrationGoogleChoose"]</p>
            <div class="integrations-checks">
                <label class="integrations-check"><input type="checkbox" name="sheets" value="true" checked /> <i class="bx bx-spreadsheet"></i> Google Sheets</label>
                <label class="integrations-check"><input type="checkbox" name="gmail" value="true" /> <i class="bx bx-envelope"></i> Gmail</label>
                <label class="integrations-check"><input type="checkbox" name="drive" value="true" /> <i class="bx bxl-google-cloud"></i> Google Drive</label>
                <label class="integrations-check is-sub"><input type="checkbox" name="driveFull" value="true" /> @Localizer["IntegrationDriveFull"]</label>
            </div>
            <label class="form-label" for="gName">@Localizer["Name"]</label>
            <input class="form-control" id="gName" name="name" placeholder="@Localizer["IntegrationNameOptional"]" />
            <div class="integrations-note">
                @Localizer["IntegrationGoogleRedirect"]
                <code data-int-copy>@Model.GoogleRedirectUri</code>
            </div>
            <footer>
                <button type="button" class="btn btn-outline-secondary" data-int-close>@Localizer["Cancel"]</button>
                <button type="submit" class="btn btn-primary"><i class="bx bxl-google"></i> @Localizer["IntegrationContinueGoogle"]</button>
            </footer>
        </form>
    </div>

    <div class="integrations-overlay" data-int-dialog="microsoft" hidden aria-hidden="true">
        <form class="integrations-dialog" method="post" asp-action="ConnectMicrosoft" data-int-form>
            <header>
                <span class="integrations-logo is-microsoft"><i class="bx bxl-microsoft" aria-hidden="true"></i></span>
                <h3>@Localizer["IntegrationConnectMicrosoft"]</h3>
                <button type="button" class="integrations-close" data-int-close aria-label="@Localizer["Close"]"><i class="bx bx-x"></i></button>
            </header>
            <p class="integrations-muted">@Localizer["IntegrationMicrosoftChoose"]</p>
            <div class="integrations-checks">
                <label class="integrations-check"><input type="checkbox" name="mail" value="true" checked /> <i class="bx bx-envelope"></i> Outlook Mail</label>
                <label class="integrations-check"><input type="checkbox" name="calendar" value="true" /> <i class="bx bx-calendar"></i> Outlook Calendar</label>
            </div>
            <label class="form-label" for="msName">@Localizer["Name"]</label>
            <input class="form-control" id="msName" name="name" placeholder="@Localizer["IntegrationNameOptional"]" />
            <div class="integrations-note">
                @Localizer["IntegrationMicrosoftRedirect"]
                <code data-int-copy>@Model.MicrosoftRedirectUri</code>
            </div>
            <footer>
                <button type="button" class="btn btn-outline-secondary" data-int-close>@Localizer["Cancel"]</button>
                <button type="submit" class="btn btn-primary"><i class="bx bxl-microsoft"></i> @Localizer["IntegrationContinueMicrosoft"]</button>
            </footer>
        </form>
    </div>

    <div class="integrations-overlay" data-int-dialog="github" hidden aria-hidden="true">
        <form class="integrations-dialog" method="post" asp-action="ConnectGitHub" data-int-form>
            <header>
                <span class="integrations-logo is-github"><i class="bx bxl-github" aria-hidden="true"></i></span>
                <h3>@Localizer["IntegrationConnectGitHub"]</h3>
                <button type="button" class="integrations-close" data-int-close aria-label="@Localizer["Close"]"><i class="bx bx-x"></i></button>
            </header>
            <p class="integrations-muted">@Localizer["IntegrationGitHubChoose"]</p>
            <div class="integrations-checks">
                <label class="integrations-check"><input type="checkbox" name="privateRepos" value="true" checked /> <i class="bx bx-lock-alt"></i> @Localizer["IntegrationGitHubPrivate"]</label>
                <label class="integrations-check"><input type="checkbox" name="workflows" value="true" /> <i class="bx bx-cog"></i> @Localizer["IntegrationGitHubWorkflows"]</label>
            </div>
            <label class="form-label" for="ghName">@Localizer["Name"]</label>
            <input class="form-control" id="ghName" name="name" placeholder="@Localizer["IntegrationNameOptional"]" />
            <div class="integrations-note">
                @Localizer["IntegrationGitHubRedirect"]
                <code data-int-copy>@Model.GitHubRedirectUri</code>
            </div>
            <footer>
                <button type="button" class="btn btn-link me-auto" data-int-open="github-token">@Localizer["IntegrationGitHubUseToken"]</button>
                <button type="button" class="btn btn-outline-secondary" data-int-close>@Localizer["Cancel"]</button>
                <button type="submit" class="btn btn-primary"><i class="bx bxl-github"></i> @Localizer["IntegrationContinueGitHub"]</button>
            </footer>
        </form>
    </div>

    <div class="integrations-overlay" data-int-dialog="github-token" hidden aria-hidden="true">
        <form class="integrations-dialog" method="post" asp-action="ConnectGitHubToken" data-int-form>
            <header>
                <span class="integrations-logo is-github"><i class="bx bxl-github" aria-hidden="true"></i></span>
                <h3>@Localizer["IntegrationConnectGitHubToken"]</h3>
                <button type="button" class="integrations-close" data-int-close aria-label="@Localizer["Close"]"><i class="bx bx-x"></i></button>
            </header>
            <ol class="integrations-steps">
                <li>@Localizer["IntegrationGitHubTokenStep1"]</li>
                <li>@Localizer["IntegrationGitHubTokenStep2"]</li>
                <li>@Localizer["IntegrationGitHubTokenStep3"]</li>
            </ol>
            <label class="form-label" for="ghtName">@Localizer["Name"]</label>
            <input class="form-control" id="ghtName" name="name" placeholder="@Localizer["IntegrationNameOptional"]" />
            <label class="form-label" for="ghtToken">@Localizer["IntegrationGitHubToken"]</label>
            <input class="form-control" id="ghtToken" name="token" type="password" required autocomplete="off" spellcheck="false" placeholder="ghp_... / github_pat_..." />
            <footer>
                <button type="button" class="btn btn-outline-secondary" data-int-close>@Localizer["Cancel"]</button>
                <button type="submit" class="btn btn-primary">@Localizer["IntegrationConnect"]</button>
            </footer>
        </form>
    </div>

    <div class="integrations-overlay" data-int-dialog="whatsapp" hidden aria-hidden="true">
        <form class="integrations-dialog" method="post" asp-action="ConnectWhatsApp" data-int-form>
            <header>
                <span class="integrations-logo is-whatsapp"><i class="bx bxl-whatsapp" aria-hidden="true"></i></span>
                <h3>@Localizer["IntegrationConnectWhatsApp"]</h3>
                <button type="button" class="integrations-close" data-int-close aria-label="@Localizer["Close"]"><i class="bx bx-x"></i></button>
            </header>
            <ol class="integrations-steps">
                <li>@Localizer["IntegrationWhatsAppStep1"]</li>
                <li>@Localizer["IntegrationWhatsAppStep2"]</li>
                <li>@Localizer["IntegrationWhatsAppStep3"]</li>
            </ol>
            <label class="form-label" for="waName">@Localizer["Name"]</label>
            <input class="form-control" id="waName" name="name" placeholder="@Localizer["IntegrationNameOptional"]" />
            <label class="form-label" for="waPhone">Phone number ID</label>
            <input class="form-control" id="waPhone" name="phoneNumberId" required autocomplete="off" />
            <label class="form-label" for="waToken">Access token</label>
            <input class="form-control" id="waToken" name="accessToken" required autocomplete="off" spellcheck="false" />
            <label class="form-label" for="waSecret">App secret</label>
            <input class="form-control" id="waSecret" name="appSecret" type="password" required autocomplete="new-password" />
            <footer>
                <button type="button" class="btn btn-outline-secondary" data-int-close>@Localizer["Cancel"]</button>
                <button type="submit" class="btn btn-primary">@Localizer["IntegrationConnect"]</button>
            </footer>
        </form>
    </div>

    <div class="integrations-overlay" data-int-dialog="computer" hidden aria-hidden="true">
        <form class="integrations-dialog" method="post" asp-action="ConnectComputer" data-int-form>
            <header>
                <span class="integrations-logo is-computer"><i class="bx bx-desktop" aria-hidden="true"></i></span>
                <h3>@Localizer["IntegrationConnectComputer"]</h3>
                <button type="button" class="integrations-close" data-int-close aria-label="@Localizer["Close"]"><i class="bx bx-x"></i></button>
            </header>
            <ol class="integrations-steps">
                <li>@Localizer["IntegrationComputerStep1"]</li>
                <li>@Localizer["IntegrationComputerStep2"]</li>
                <li>@Localizer["IntegrationComputerStep3"]</li>
            </ol>
            <label class="form-label" for="pcName">@Localizer["Name"]</label>
            <input class="form-control" id="pcName" name="name" placeholder="@Localizer["ComputerDefaultName"]" />
            <div class="integrations-note">
                @Localizer["ComputerAgentRequirements"]
                @if (Model.AgentAvailable)
                {
                    <a class="integrations-link" asp-action="DownloadAgent" download="Partnerly-Agent.zip" data-no-loader><i class="bx bx-download" aria-hidden="true"></i> @Localizer["ComputerDownloadAgent"]</a>
                }
                else
                {
                    <span class="integrations-error">@Localizer["ComputerAgentMissing"]</span>
                }
            </div>
            <footer>
                <button type="button" class="btn btn-outline-secondary" data-int-close>@Localizer["Cancel"]</button>
                <button type="submit" class="btn btn-primary">@Localizer["IntegrationComputerCreate"]</button>
            </footer>
        </form>
    </div>

    <div class="integrations-overlay" data-int-dialog="computer-token" hidden aria-hidden="true">
        <div class="integrations-dialog" data-connected-text="@Localizer["ComputerConnectedOk"]" data-wait-long-text="@Localizer["ComputerWaitLong"]">
            <header>
                <span class="integrations-logo is-computer"><i class="bx bx-key" aria-hidden="true"></i></span>
                <h3>@Localizer["ComputerTokenTitle"]</h3>
                <button type="button" class="integrations-close" data-int-close aria-label="@Localizer["Close"]"><i class="bx bx-x"></i></button>
            </header>
            <ol class="integrations-steps">
                <li>@Localizer["ComputerTokenStep1"]</li>
                <li>@Localizer["ComputerTokenStep2"]</li>
                <li>@Localizer["ComputerTokenStep3"]</li>
                <li>@Localizer["ComputerTokenStep4"]</li>
            </ol>
            <div class="integrations-wait" data-int-wait role="status">
                <i class="bx bx-loader-alt bx-spin" aria-hidden="true"></i> <span data-int-wait-text>@Localizer["ComputerWait"]</span>
            </div>
            <p class="integrations-muted">@Localizer["ComputerTokenHelp"]</p>
            <div class="integrations-webhook">
                <div><span>@Localizer["ComputerServerUrl"]</span><code data-int-copy data-int-server-url></code></div>
                <div><span>@Localizer["ComputerToken"]</span><code data-int-copy data-int-token></code></div>
            </div>
            <footer>
                @if (Model.AgentAvailable)
                {
                    <button type="button" class="btn btn-outline-primary" data-int-download>
                        <i class="bx bx-download" aria-hidden="true"></i> @Localizer["ComputerDownloadWithSettings"]
                    </button>
                }
                <button type="button" class="btn btn-primary" data-int-close>@Localizer["Close"]</button>
            </footer>
        </div>
    </div>

    <div class="integrations-overlay" data-int-dialog="chats" hidden aria-hidden="true">
        <div class="integrations-dialog">
            <header>
                <span class="integrations-logo is-telegram"><i class="bx bxl-telegram" aria-hidden="true"></i></span>
                <h3>@Localizer["IntegrationRecentChats"]</h3>
                <button type="button" class="integrations-close" data-int-close aria-label="@Localizer["Close"]"><i class="bx bx-x"></i></button>
            </header>
            <p class="integrations-muted">@Localizer["IntegrationRecentChatsHelp"]</p>
            <ul class="integrations-chats" data-int-chats></ul>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/js/integrations/integrations.js" asp-append-version="true"></script>
}
