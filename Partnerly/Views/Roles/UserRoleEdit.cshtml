@model Partnerly.Models.ViewModels.UserRolesViewModel;
@await Html.PartialAsync("_Toast")

@{
    ViewData["Title"] = Model.Title;
    Layout = "_ContentNavbarLayout";
}

<div class="card">
    <div class="card-header justify-content-between">
        <h5>@Localizer["Changerole"]</h5>
    </div>

    <div class="card-body">
        <form id="userRoleForm" asp-action="UserRoleEdit">
            
            @await Html.PartialAsync("_StickyButtons", Model.StickyButtons)

            <input type="hidden" asp-for="Id" />
            <input type="hidden" id="hiddenNote" asp-for="Note" />

            <div class="form-floating mb-1 max-w-400 position-relative">
                <input asp-for="UserName"
                        id="userName"
                        name="userName"
                        type="text"
                        class="form-control lookup-input pe-5"
                        placeholder=" "
                        data-lookup="true"
                        data-lookup-source="/Roles/GetLookupList"
                        data-lookup-title=@Localizer["Users"]
                       data-edit-url-base="/Roles/UserRoleEdit/"
                       data-lookup-column-names="name:@Localizer["User"],role:@Localizer["Role"]"
                        data-lookup-display-field="UserName"
                        data-lookup-param="fieldName"
                        data-lookup-param-value="Name" readonly/>
                <label asp-for="UserName"></label>
                <i class='bx bx-search lookup-icon'></i>
            </div>
        
            <div class="form-floating mb-1 max-w-400">
                <input asp-for="OldRoleName" id="oldRoleName" class="form-control" readonly/>
                <label asp-for="OldRoleName"></label>
            </div>

            <div class="form-floating mb-1 max-w-400 position-relative">
                <input asp-for="NewRoleName"
                       id="newRoleName"
                       name="newRoleName"
                       type="text"
                       class="form-control lookup-input pe-5"
                       placeholder=" "
                       data-lookup="true"
                       data-lookup-source="/Roles/GetLookupList"
                       data-lookup-title="@Localizer["Roles"]"
                       
                       data-lookup-column-names="name:@Localizer["Name"],isActive:@Localizer["IsActive"]"
                       data-lookup-display-field="Name"
                       data-lookup-param="fieldName"
                       data-lookup-param-value="RoleName" readonly/>

                <label asp-for="NewRoleName"></label>

                <i class="bx bx-search lookup-icon"></i>

                <span asp-validation-for="NewRoleName"
                      class="text-danger"></span>
            </div>
        </form>
    </div>
</div>

<script src="~/assets/js/form-change-tracker.js"></script>
<script>
    enableSaveOnChange("#userRoleForm", "#btnSave");
</script>


