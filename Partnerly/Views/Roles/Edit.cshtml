@model Partnerly.Models.ViewModels.UserRolesViewModel;
@await Html.PartialAsync("_Toast")

@{
    ViewData["Title"] = "Change role";
    Layout = "_ContentNavbarLayout";
}

<div class="card">
    <div class="card-header justify-content-between">
        <h5>@Localizer["Changerole"]</h5>
    </div>

    <div class="card-body">
        <form id="emailTemplateForm" asp-action="Edit">
            
            @await Html.PartialAsync("_StickyButtons", new Partnerly.Models.ViewModels.FormActionsViewModel {
                Back = new Partnerly.Models.ViewModels.ActionBack(id: Model.Id, visible: true, fromController: "Roles", toController: "Roles", fromAction: "Edit", toAction: "Index"),
                Undo = new Partnerly.Models.ViewModels.ActionUndo(id: Model.Id, visible: true, fromController: "Roles", toController: "Roles", fromAction: "Edit", toAction: "Edit"),
                Save = new Partnerly.Models.ViewModels.ActionSave(id: Model.Id, visible: true, fromController: "Roles", toController: "Roles", fromAction: "Edit", toAction: "Edit"),
                Attachements = new Partnerly.Models.ViewModels.ActionAttachements(entityType: "Role", entityId: Model.Id, visible: true),
                Note = new Partnerly.Models.ViewModels.ActionNote(visible: true, note: Model.Note, id: Model.Id),
                Menu = new Partnerly.Models.ViewModels.ActionMenu(visible: true),
                MenuActions = new List<Partnerly.Models.ViewModels.MenuItemAction> {
                        new Partnerly.Models.ViewModels.MenuItemAction(visible: true, icon: "bx bx-show", displayName: Localizer["Viewuser"], toController: "Users", toAction: "Edit", routID: Model.Id),
                }
            })

            <input type="hidden" asp-for="Id" />
            <input type="hidden" id="hiddenNote" asp-for="Note" />

            <div class="form-floating mb-1 max-w-600 position-relative">
                <input asp-for="UserName"
                        id="userName"
                        name="userName"
                        type="text"
                        class="form-control lookup-input pe-5"
                        placeholder=" "
                        data-lookup="true"
                        data-lookup-source="/Roles/GetLookupList"
                        data-lookup-title=@Localizer["Users"]
                        data-edit-url-base="/Roles/Edit/"
                       data-lookup-column-names="name:@Localizer["User"],role:@Localizer["Role"]"
                        data-lookup-display-field="UserName"
                        data-lookup-param="fieldName"
                        data-lookup-param-value="Name" readonly/>
                <label asp-for="UserName"></label>
                <i class='bx bx-search lookup-icon'></i>
            </div>
        
            <div class="form-floating mb-1 max-w-600">
                <input asp-for="OldRoleName" id="oldRoleName" class="form-control" readonly/>
                <label asp-for="OldRoleName"></label>
            </div>
            <div class="form-floating mb-1 max-w-600">
               <select asp-for="NewRoleName"
                            asp-items="Model.RoleNamesList"
                            class="form-select"
                            id="newRoleName">
                    <option value="">-- @Localizer["Selectarole"] --</option>
                    </select>
                    <label asp-for="NewRoleName"></label>
                    <span asp-validation-for="NewRoleName" class="text-danger"></span>
            </div>
        </form>
    </div>
</div>

<script src="~/js/form-change-tracker.js"></script>
<script>
    enableSaveOnChange("#emailTemplateForm", "#btnSave");
</script>


