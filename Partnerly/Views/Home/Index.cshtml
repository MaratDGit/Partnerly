@using System.Collections.Generic
@{
    var appName = TempData.Peek("appName") as string ?? Partnerly.Helpers.SystemSettingsDefaults.ApplicationName;
    var authPanel = ViewBag.AuthPanel as string;
    var infoPanel = ViewBag.InfoPanel as string;
    ViewData["Title"] = infoPanel == "privacy"
        ? Localizer["PrivacyPolicyandTerms"].Value
        : authPanel switch
        {
            "login" => Localizer["Login"].Value,
            "register" => Localizer["Signup"].Value,
            "forgot" => Localizer["ForgotPassword"].Value,
            "register-ok" => Localizer["AccountCreated"].Value,
            "forgot-ok" => Localizer["EmailSent"].Value,
            "email-ok" => Localizer["EmailVerified"].Value,
            _ => appName
        };
    Layout = "_LandingLayout";
    var googleEnabled = ViewBag.GoogleLoginEnabled as bool? ?? true;
    var typePhrases = new[]
    {
        Localizer["LandingType1"].Value,
        Localizer["LandingType2"].Value,
        Localizer["LandingType3"].Value,
        Localizer["LandingType4"].Value
    };
    var chatReplies = new[]
    {
        Localizer["LandingChatReply1"].Value,
        Localizer["LandingChatReply2"].Value,
        Localizer["LandingChatReply3"].Value
    };
    var chatPrompts = new object[]
    {
        new Dictionary<string, object?>
        {
            ["id"] = "what",
            ["label"] = Localizer["LandingPromptWhat"].Value,
            ["kind"] = "text",
            ["text"] = Localizer["LandingAnswerWhat"].Value
        },
        new Dictionary<string, object?>
        {
            ["id"] = "start",
            ["label"] = Localizer["LandingPromptStart"].Value,
            ["kind"] = "text",
            ["text"] = Localizer["LandingAnswerStart"].Value,
            ["auth"] = true
        },
        new Dictionary<string, object?>
        {
            ["id"] = "example",
            ["label"] = Localizer["LandingPromptExample"].Value,
            ["kind"] = "slider",
            ["slides"] = new object[]
            {
                new Dictionary<string, string>
                {
                    ["title"] = Localizer["LandingSlideExample1Title"].Value,
                    ["body"] = Localizer["LandingSlideExample1Body"].Value,
                    ["icon"] = "bx-envelope"
                },
                new Dictionary<string, string>
                {
                    ["title"] = Localizer["LandingSlideExample2Title"].Value,
                    ["body"] = Localizer["LandingSlideExample2Body"].Value,
                    ["icon"] = "bx-message-dots"
                },
                new Dictionary<string, string>
                {
                    ["title"] = Localizer["LandingSlideExample3Title"].Value,
                    ["body"] = Localizer["LandingSlideExample3Body"].Value,
                    ["icon"] = "bx-news"
                }
            }
        },
        new Dictionary<string, object?>
        {
            ["id"] = "how",
            ["label"] = Localizer["LandingPromptHow"].Value,
            ["kind"] = "slider",
            ["slides"] = new object[]
            {
                new Dictionary<string, string>
                {
                    ["title"] = Localizer["LandingSlideHow1Title"].Value,
                    ["body"] = Localizer["LandingSlideHow1Body"].Value,
                    ["icon"] = "bx-edit-alt"
                },
                new Dictionary<string, string>
                {
                    ["title"] = Localizer["LandingSlideHow2Title"].Value,
                    ["body"] = Localizer["LandingSlideHow2Body"].Value,
                    ["icon"] = "bx-play-circle"
                },
                new Dictionary<string, string>
                {
                    ["title"] = Localizer["LandingSlideHow3Title"].Value,
                    ["body"] = Localizer["LandingSlideHow3Body"].Value,
                    ["icon"] = "bx-check-circle"
                }
            }
        }
    };
}

<section class="landing-stage">
    <canvas id="landingDots" aria-hidden="true"></canvas>

    <div class="landing-hero-search">
        <div class="landing-hero-copy">
            <h1 class="landing-hero-title">@Localizer["LandingHeroTitle"]</h1>
            <p class="landing-hero-sub">@Localizer["LandingHeroSub"]</p>
        </div>

        <div class="landing-chat">
            <div class="landing-chat-thread" data-landing-thread></div>
        </div>

        <form class="landing-search"
              action="#"
              method="get"
              data-type-phrases="@System.Text.Json.JsonSerializer.Serialize(typePhrases)"
              data-chat-replies="@System.Text.Json.JsonSerializer.Serialize(chatReplies)"
              data-chat-prompts="@System.Text.Json.JsonSerializer.Serialize(chatPrompts)"
              data-slider-prev="@Localizer["LandingSliderPrev"]"
              data-slider-next="@Localizer["LandingSliderNext"]"
              data-google-url="@(googleEnabled ? Url.Action("GoogleLogin", "Account") : "")"
              data-apple-url="@Url.Action("AppleLogin", "Account")"
              data-google-label="@Localizer["ContinuewithGoogle"]"
              data-apple-label="@Localizer["ContinuewithApple"]"
              data-login-label="@Localizer["Login"]"
              data-signup-label="@Localizer["Signup"]">
            <input type="search"
                   name="q"
                   class="landing-search-input"
                   autocomplete="off"
                   spellcheck="false"
                   aria-label="@Localizer["LandingType1"]" />
            <span class="landing-search-type" aria-hidden="true"></span>
            <button type="submit"
                    class="landing-search-submit"
                    aria-label="@Localizer["LandingSearchSubmit"]">
                <i class="bx bx-search landing-search-submit-find"></i>
                <i class="bx bx-send landing-search-submit-send"></i>
            </button>
        </form>

        <div class="landing-prompts" data-landing-prompts>
            <button type="button" class="landing-prompt" data-landing-prompt="what">
                @Localizer["LandingPromptWhat"]
            </button>
            <button type="button" class="landing-prompt" data-landing-prompt="start">
                @Localizer["LandingPromptStart"]
            </button>
            <button type="button" class="landing-prompt" data-landing-prompt="example">
                @Localizer["LandingPromptExample"]
            </button>
            <button type="button" class="landing-prompt" data-landing-prompt="how">
                @Localizer["LandingPromptHow"]
            </button>
        </div>

        <div class="landing-hero-actions">
            <button type="button" class="landing-hero-cta" data-auth="register">
                <span class="landing-hero-cta-orbit is-glow" aria-hidden="true"></span>
                <span class="landing-hero-cta-orbit" aria-hidden="true"></span>
                <span class="landing-hero-cta-glass" aria-hidden="true"></span>
                <span class="landing-hero-cta-label">@Localizer["LandingHeroCta"]</span>
            </button>
        </div>
    </div>
</section>

@await Html.PartialAsync("_LandingAuthModal")
@await Html.PartialAsync("_LandingInfoModal")

@section Scripts {
    <script src="~/assets/js/landing-dots.js" asp-append-version="true"></script>
    <script src="~/assets/js/landing-search.js" asp-append-version="true"></script>
    <script src="~/assets/js/landing-auth.js" asp-append-version="true"></script>
    <script src="~/assets/js/landing-info.js" asp-append-version="true"></script>
}
