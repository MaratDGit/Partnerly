<section class="videos-section section-no-flex" id="videos">
    <div class="container section-no-flex">
        <div class="section-header">
            <h2 class="section-title">@Localizer["Educationalvideos"]</h2>
            <p class="section-subtitle">@Localizer["Seehowourplatformworks"]</p>
        </div>

        <div class="videos-grid">
            <div class="video-card">
                <iframe src="" title="Video 1" frameborder="0" allowfullscreen></iframe>
                <p class="video-title">@Localizer["Howtoregisterandgetstarted"]</p>
            </div>
            <div class="video-card">
                <iframe src="" title="Video 2" frameborder="0" allowfullscreen></iframe>
                <p class="video-title">@Localizer["Invitefriendsandearn"]</p>
            </div>
            <div class="video-card">
                <iframe src="" title="Video 3" frameborder="0" allowfullscreen></iframe>
                <p class="video-title">@Localizer["Ratesandbonuslevels"]</p>
            </div>
        </div>
    </div>
</section>





