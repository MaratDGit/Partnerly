@{
    ViewData["Title"] = "Policyand and Terms";
    Layout = "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @TempData.Peek("appName")</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/css/landing.css" />
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
</head>
<body>
    <header class="landing-header">
        <div class="container">
            <div class="logo">
                <a asp-controller="Home" asp-action="Index" class="app-brand-link gap-2">
                    <span><img src="~/favicon.png" alt="Logo" width="32" height="32" class="me-2" /></span>
                    <span>@TempData.Peek("appName")</span>
                </a>
            </div>
        </div>
    </header>

    <div class="referral-program" style="max-width: 800px; margin: 0 auto; padding: 20px;">
        <h2 style="text-align: center; margin-bottom: 20px;">@Localizer["PrivacyPolicyandTerms"]</h2>
</div>
</body>
</html>

