@{
  Layout = "_BlankLayout";
  ViewData["Title"] = "На обслуживании";
}

@section PageStyles {
    <link rel="stylesheet" href="~/assets/vendor/css/pages/page-misc.css">
}

<div class="container-xxl container-p-y">
  <div class="misc-wrapper">
        <h3 class="mb-2 mx-2">@Localizer["Undermaintenance"] 🚧</h3>
    <p class="mb-6 mx-2">
            @Localizer["Technicalmaintenanceunderway"]
    </p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">@Localizer["Back"]</a>
    <div class="mt-6">
      <img src="~/assets/img/illustrations/Maintenance.svg" alt="girl-doing-yoga-light" width="500" class="img-fluid" data-app-light-img="illustrations/girl-doing-yoga-light.png" data-app-dark-img="illustrations/girl-doing-yoga-dark.png">
    </div>
  </div>
</div>