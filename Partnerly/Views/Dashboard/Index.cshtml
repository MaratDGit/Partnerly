@{
  ViewData["Title"] = "Dashboard";
}

@section PageScripts {
   <script src="~/assets/vendor/libs/apex-charts/chart.js"></script>
}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

@* ************** Content ************** *@
<!-- STATS CARDS -->
    <div class="row text-center mb-4">
        <div class="col-md-3 mb-3">
            <div class="card stat-card shadow-sm">
                <div class="card-body">
                    <h6>Сыграно игр</h6>
                    <h2>128</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card stat-card shadow-sm">
                <div class="card-body">
                    <h6>Победы</h6>
                    <h2 class="text-success">74</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card stat-card shadow-sm">
                <div class="card-body">
                    <h6>Поражения</h6>
                    <h2 class="text-danger">54</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card stat-card shadow-sm">
                <div class="card-body">
                    <h6>Win Rate</h6>
                    <h2>57%</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- CHARTS -->
    <div class="row">
        <div class="col-md-8 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="mb-3">📈 Игры по дням</h5>
                    <canvas id="gamesChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="mb-3">🏆 Победы / Поражения</h5>
                    <canvas id="winLoseChart"></canvas>
                </div>
            </div>
        </div>
    </div>

