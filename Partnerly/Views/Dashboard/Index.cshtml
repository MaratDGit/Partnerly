@model Partnerly.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = Localizer["Statistics"].Value;
}

@section PageStyles {
    <link rel="stylesheet" href="~/assets/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/dashboards.css" asp-append-version="true" />
}

@section PageScripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        window.dashboardCulture =
            @Html.Raw(Json.Serialize(
                System.Globalization.CultureInfo.CurrentUICulture.Name
                ));
        window.dashboardData = {
            gamesByDay: @Html.Raw(Json.Serialize(Model.GamesByDay)),
            victories: @Model.Victories,
            defeats: @Model.Defeats
        };
        window.dashboardTranslations = {
            games: @Html.Raw(Json.Serialize(Localizer["Games"].Value)),
            victories: @Html.Raw(Json.Serialize(Localizer["Victories"].Value)),
            defeats: @Html.Raw(Json.Serialize(Localizer["Defeats"].Value))
        };

        window.dashboardDateTranslations = {
        days: [
            @Html.Raw(Json.Serialize(Localizer["Monday"].Value)),
            @Html.Raw(Json.Serialize(Localizer["Tuesday"].Value)),
            @Html.Raw(Json.Serialize(Localizer["Wednesday"].Value)),
            @Html.Raw(Json.Serialize(Localizer["Thursday"].Value)),
            @Html.Raw(Json.Serialize(Localizer["Friday"].Value)),
            @Html.Raw(Json.Serialize(Localizer["Saturday"].Value)),
            @Html.Raw(Json.Serialize(Localizer["Sunday"].Value))
        ],
        months: [
            @Html.Raw(Json.Serialize(Localizer["January"].Value)),
            @Html.Raw(Json.Serialize(Localizer["February"].Value)),
            @Html.Raw(Json.Serialize(Localizer["March"].Value)),
            @Html.Raw(Json.Serialize(Localizer["April"].Value)),
            @Html.Raw(Json.Serialize(Localizer["May"].Value)),
            @Html.Raw(Json.Serialize(Localizer["June"].Value)),
            @Html.Raw(Json.Serialize(Localizer["July"].Value)),
            @Html.Raw(Json.Serialize(Localizer["August"].Value)),
            @Html.Raw(Json.Serialize(Localizer["September"].Value)),
            @Html.Raw(Json.Serialize(Localizer["October"].Value)),
            @Html.Raw(Json.Serialize(Localizer["November"].Value)),
            @Html.Raw(Json.Serialize(Localizer["December"].Value))
        ]
    };
    </script>

    <script src="~/assets/js/dashboard.js" asp-append-version="true"></script>
    <script src="~/assets/js/dashboards.js" asp-append-version="true"></script>
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="dashboards-page dashboards" data-dashboards>
        @{
            var insights = Model.Insights ?? new Partnerly.Models.ViewModels.DashboardsViewModel();
        }
        <nav class="dashboards-tabs" role="tablist" aria-label="@Localizer["Statistics"]">
            <button type="button"
                    class="dashboards-tab is-active"
                    role="tab"
                    aria-selected="true"
                    data-dash-tab="games">
                <i class="bx bx-game"></i>
                <span class="dashboards-tab-label">@Localizer["Games"]</span>
                <span class="dashboards-tab-count">@Model.GamesPlayed</span>
            </button>
            @if (insights.CanUsers)
            {
                <button type="button"
                        class="dashboards-tab"
                        role="tab"
                        aria-selected="false"
                        data-dash-tab="users">
                    <i class="bx bx-user"></i>
                    <span class="dashboards-tab-label">@Localizer["Users"]</span>
                    <span class="dashboards-tab-count">@insights.UsersTotal</span>
                </button>
            }
            @if (insights.CanTasks)
            {
                <button type="button"
                        class="dashboards-tab"
                        role="tab"
                        aria-selected="false"
                        data-dash-tab="tasks">
                    <i class="bx bx-task"></i>
                    <span class="dashboards-tab-label">@Localizer["Tasks"]</span>
                    <span class="dashboards-tab-count">@insights.TasksTotal</span>
                </button>
            }
            @if (insights.CanRoles)
            {
                <button type="button"
                        class="dashboards-tab"
                        role="tab"
                        aria-selected="false"
                        data-dash-tab="roles">
                    <i class="bx bx-shield-quarter"></i>
                    <span class="dashboards-tab-label">@Localizer["Roles"]</span>
                    <span class="dashboards-tab-count">@insights.RolesTotal</span>
                </button>
            }
            @if (insights.CanGroups)
            {
                <button type="button"
                        class="dashboards-tab"
                        role="tab"
                        aria-selected="false"
                        data-dash-tab="groups">
                    <i class="bx bx-group"></i>
                    <span class="dashboards-tab-label">@Localizer["Groups"]</span>
                    <span class="dashboards-tab-count">@insights.GroupsTotal</span>
                </button>
            }
            @if (insights.CanNotifications)
            {
                <button type="button"
                        class="dashboards-tab"
                        role="tab"
                        aria-selected="false"
                        data-dash-tab="notifications">
                    <i class="bx bx-bell"></i>
                    <span class="dashboards-tab-label">@Localizer["Notifications"]</span>
                    <span class="dashboards-tab-count">@insights.NotificationsTotal</span>
                </button>
            }
        </nav>

        <section class="dashboards-panel" data-dash-panel="games" role="tabpanel">
    <div class="dashboard">

    <!-- ==================== STAT CARDS ==================== -->
    <div class="row g-4 mb-4">

        <!-- Games -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="dashboard-stat-card games-card">
                <div class="stat-card-content">

                    <div>
                        <span class="stat-label">
                            @Localizer["Gamesplayed"]
                        </span>

                        <h2 class="stat-value">@Model.GamesPlayed</h2>

                        <div class="stat-description">
                            <span class="@(Model.GamesPlayedImprovement
                                          ? "stat-positive"
                                          : "stat-negative")">

                                <i class="bx @(Model.GamesPlayedChange >= 0
                                               ? "bx-up-arrow-alt"
                                               : "bx-down-arrow-alt")"></i>

                                @Math.Abs(Model.GamesPlayedChange)%
                            </span>

                            <span>@Localizer["VsLastMonth"]</span>
                        </div>
                    </div>

                    <div class="stat-icon">
                        <i class="bx bx-game"></i>
                    </div>
                </div>
                <button type="button"
                        class="btn btn-sm btn-icon dashboard-card-refresh"
                        data-card="gamesPlayed"
                        title="@Localizer["Refresh"]">

                    <i class="bx bx-refresh"></i>
                </button>
            </div>
        </div>

        <!-- Victories -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="dashboard-stat-card victories-card">
                <div class="stat-card-content">

                    <div>
                        <span class="stat-label">
                            @Localizer["Victories"]
                        </span>

                        <h2 class="stat-value">@Model.Victories</h2>

                        <div class="stat-description">
                            <span class="@(Model.VictoriesImprovement
                                          ? "stat-positive"
                                          : "stat-negative")">

                                <i class="bx @(Model.VictoriesChange >= 0
                                               ? "bx-up-arrow-alt"
                                               : "bx-down-arrow-alt")"></i>

                                @Math.Abs(Model.VictoriesChange)%
                            </span>

                            <span>@Localizer["VsLastMonth"]</span>
                        </div>
                    </div>

                    <div class="stat-icon">
                        <i class="bx bx-trophy"></i>
                    </div>

                </div>
                <button type="button"
                        class="btn btn-sm btn-icon dashboard-card-refresh"
                        data-card="victories"
                        title="@Localizer["Refresh"]">

                    <i class="bx bx-refresh"></i>
                </button>
            </div>
        </div>

        <!-- Defeats -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="dashboard-stat-card defeats-card">
                <div class="stat-card-content">

                    <div>
                        <span class="stat-label">
                            @Localizer["Defeats"]
                        </span>

                        <h2 class="stat-value">@Model.Defeats</h2>

                        <div class="stat-description">
                            <span class="@(Model.DefeatsImprovement
                                          ? "stat-positive"
                                          : "stat-negative")">

                                <i class="bx @(Model.DefeatsChange <= 0
                                               ? "bx-down-arrow-alt"
                                               : "bx-up-arrow-alt")"></i>

                                @Math.Abs(Model.DefeatsChange)%
                            </span>

                            <span>@Localizer["VsLastMonth"]</span>
                        </div>
                    </div>

                    <div class="stat-icon">
                        <i class="bx bx-x-circle"></i>
                    </div>

                </div>
                <button type="button"
                        class="btn btn-sm btn-icon dashboard-card-refresh"
                        data-card="defeats"
                        title="@Localizer["Refresh"]">

                    <i class="bx bx-refresh"></i>
                </button>
            </div>
        </div>

        <!-- Win Rate -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="dashboard-stat-card rate-card">
                <div class="stat-card-content">

                    <div>
                        <span class="stat-label">
                            @Localizer["WinRate"]
                        </span>

                        <h2 class="stat-value">@Model.WinRate%</h2>

                        <div class="stat-description">
                            <span class="@(Model.WinRateImprovement
                                          ? "stat-positive"
                                          : "stat-negative")">

                                <i class="bx @(Model.WinRateChange >= 0
                                               ? "bx-up-arrow-alt"
                                               : "bx-down-arrow-alt")"></i>

                                @Math.Abs(Model.WinRateChange)%
                            </span>

                            <span>@Localizer["VsLastMonth"]</span>
                        </div>
                    </div>

                    <div class="stat-icon">
                        <i class="bx bx-bar-chart-alt-2"></i>
                    </div>

                </div>
                <button type="button"
                        class="btn btn-sm btn-icon dashboard-card-refresh"
                        data-card="winRate"
                        title="@Localizer["Refresh"]">

                    <i class="bx bx-refresh"></i>
                </button>
            </div>
        </div>

    </div>


    <!-- ==================== CHARTS ==================== -->
    <div class="row g-4 dashboard-charts-row">

        <!-- Games by day -->
        <div class="col-12 col-lg-8">

            <div class="dashboard-card h-100">
                
                <button type="button"
                        class="btn btn-sm btn-icon dashboard-card-refresh"
                        data-card="gamesChart"
                        title="@Localizer["Refresh"]">

                    <i class="bx bx-refresh"></i>
                </button>

                <div class="dashboard-card-header">

                    <div>
                        <h5>
                            <i class="bx bx-line-chart"></i>
                            <span id="gamesChartTitle">
                                @Localizer["Gamesbyday"]
                            </span>
                        </h5>

                        <span id="gamesChartSubtitle" class="dashboard-card-subtitle"></span>
                    </div>

                    <div class="chart-menu dropdown">
                        <button class="btn btn-sm btn-light dropdown-toggle"
                                type="button"
                                id="gamesPeriodDropdown"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">

                            <span id="selectedGamesPeriod">
                                @Localizer["Last7Days"]
                            </span>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <button class="dropdown-item games-period-option active"
                                        type="button"
                                        data-period="7days"
                                        data-label="@Localizer["Last7Days"]"
                                        data-title="@Localizer["Gamesbyday"]">

                                    @Localizer["Last7Days"]
                                </button>
                            </li>

                            <li>
                                <button class="dropdown-item games-period-option"
                                        type="button"
                                        data-period="30days"
                                        data-label="@Localizer["Last30Days"]"
                                        data-title="@Localizer["Gamesbyday"]">

                                    @Localizer["Last30Days"]
                                </button>
                            </li>

                            <li>
                                <button class="dropdown-item games-period-option"
                                        type="button"
                                        data-period="3months"
                                        data-label="@Localizer["Last3Months"]"
                                        data-title="@Localizer["Gamesbymonth"]">

                                    @Localizer["Last3Months"]
                                </button>
                            </li>

                            <li>
                                <button class="dropdown-item games-period-option"
                                        type="button"
                                        data-period="year"
                                        data-label="@Localizer["ThisYear"]"
                                        data-title="@Localizer["Gamesbymonth"]">

                                    @Localizer["ThisYear"]
                                </button>
                            </li>
                        </ul>
                    </div>

                </div>

                <div class="chart-container">
                    <div class="chart-scroll">
                        <div class="chart-inner">
                            <canvas id="gamesChart"></canvas>
                        </div>
                    </div>
                </div>

            </div>

        </div>


        <!-- Wins / Losses -->
        <div class="col-12 col-lg-4">

            <div class="dashboard-card h-100">

                <button type="button"
                        class="btn btn-sm btn-icon dashboard-card-refresh"
                        data-card="winLoseChart"
                        title="@Localizer["Refresh"]">

                    <i class="bx bx-refresh"></i>
                </button>

                <div class="dashboard-card-header">

                    <div>
                        <h5>
                            <i class="bx bx-trophy"></i>
                            @Localizer["WinsLosses"]
                        </h5>

                        <span class="dashboard-card-subtitle">
                            @Localizer["OverallGameResults"]
                        </span>
                    </div>

                </div>

                <div class="donut-container">
                    <canvas id="winLoseChart"></canvas>
                </div>

                <div class="chart-summary">

                    <div class="summary-item">
                        <span class="summary-dot wins"></span>

                        <div>
                            <span class="summary-label">
                                @Localizer["Victories"]
                            </span>

                            <strong>
                                @Model.Victories
                            </strong>
                        </div>
                    </div>

                    <div class="summary-item">
                        <span class="summary-dot losses"></span>

                        <div>
                            <span class="summary-label">
                                @Localizer["Defeats"]
                            </span>

                            <strong>
                                @Model.Defeats
                            </strong>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>
    </div>
        </section>

        @await Html.PartialAsync("_InsightsPanels", insights)
    </div>
</div>