@model Partnerly.Models.ViewModels.MyProfileViewModel
@using System.Globalization

@{
    ViewData["Title"] = "My Profile";
    Layout = "_ContentNavbarLayout";

    string joinedText = "";

    if (Model.CreatedDate.HasValue)
    {
        var month = Model.CreatedDate.Value.ToString(
            "MMMM",
            CultureInfo.CurrentUICulture);

        var year = Model.CreatedDate.Value.Year;

        joinedText = $"{Localizer["Joinedin"]} {month} {year}";
    }

    var totalMembers = Model.Refferals?.Count() ?? 0;

    // TODO:
    // Replace these values with real calculations
    // when the corresponding data becomes available.
    var activeMembers = totalMembers;
    var directReferrals = totalMembers;
}

<link rel="stylesheet"
      href="~/assets/vendor/css/pages/page-myprofile.css" />

<!-- Cropper.js -->
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css" />


<div class="container-xxl flex-grow-1 container-p-y profile-page">

    <!-- =====================================================
         PROFILE HEADER
         ===================================================== -->

    <div class="card profile-header-card mb-4">

        <div class="profile-cover"></div>

        <div class="profile-header-content">

            <!-- Avatar -->
            <div class="profile-avatar-wrapper">

                <label for="profilePhotoInput"
                       class="profile-avatar-upload"
                       title="@Localizer["Changephoto"]">

                    @if (!string.IsNullOrEmpty(Model?.PhotoUrl))
                    {
                        <img src="@Url.Content(Model.PhotoUrl)"
                             alt="User avatar"
                             class="profile-avatar"
                             id="profileAvatar" />
                    }
                    else
                    {
                        <div class="profile-avatar profile-avatar-placeholder"
                             id="profileAvatar">

                            <i class="bx bx-user"></i>

                        </div>
                    }

                    <!-- Camera overlay -->
                    <div class="profile-avatar-camera">
                        <i class="bx bx-camera"></i>
                    </div>

                </label>

                <input type="file"
                       id="profilePhotoInput"
                       accept="image/jpeg,image/png,image/webp"
                       hidden />

            </div>


            <!-- User information -->
            <div class="profile-main-info">

                <div class="profile-name-row">

                    <div>

                        <h4 class="profile-name">
                            @Model?.UserName
                        </h4>

                        <div class="profile-meta">

                            @if (!string.IsNullOrEmpty(joinedText))
                            {
                                <span>
                                    <i class="bx bx-calendar"></i>
                                    @joinedText
                                </span>
                            }

                        </div>

                    </div>


                    <!-- Referral button -->
                    <button type="button"
                            class="btn btn-primary profile-referral-btn"
                            onclick="copyReferralLink('@Model?.MyReferralCode')">

                        <i class="bx bx-copy-alt me-1"></i>

                        @Localizer["Copyreferrallink"]

                    </button>

                </div>

            </div>

        </div>


        <!-- =====================================================
             PHOTO UPLOAD / CROP PANEL
             ===================================================== -->

        <div id="photoUploadPanel"
             class="photo-upload-panel d-none">

            <!-- Header -->
            <div class="photo-upload-header">

                <div>

                    <strong>
                        @Localizer["Changephoto"]
                    </strong>

                    <span>
                        @Localizer["Moveandresizeyourphoto"]
                    </span>

                </div>

                <button type="button"
                        id="cancelPhotoBtn"
                        class="photo-upload-close"
                        aria-label="Close">

                    <i class="bx bx-x"></i>

                </button>

            </div>


            <!-- Crop area -->
            <div class="photo-crop-container">

                <img id="photoCropImage"
                     alt="Photo crop preview" />

            </div>


            <!-- Controls -->
            <div class="photo-crop-controls">

                <button type="button"
                        id="zoomOutPhotoBtn"
                        class="btn btn-label-secondary"
                        title="@Localizer["Zoomout"]">

                    <i class="bx bx-minus"></i>

                </button>


                <button type="button"
                        id="resetPhotoBtn"
                        class="btn btn-label-secondary">

                    <i class="bx bx-reset me-1"></i>

                    @Localizer["Reset"]

                </button>


                <button type="button"
                        id="zoomInPhotoBtn"
                        class="btn btn-label-secondary"
                        title="@Localizer["Zoomin"]">

                    <i class="bx bx-plus"></i>

                </button>

            </div>


            <!-- Footer -->
            <div class="photo-upload-footer">

                <span class="photo-upload-format">
                    JPG, PNG or WEBP · Max 5 MB
                </span>

                <button type="button"
                        id="savePhotoBtn"
                        class="btn btn-primary">

                    <i class="bx bx-check me-1"></i>

                    @Localizer["Save"]

                </button>

            </div>

        </div>

    </div>


    <!-- =====================================================
         PROFILE TABS
         ===================================================== -->

    <div class="profile-tabs-wrapper">

        <ul class="nav nav-pills profile-tabs"
            id="profileTabs"
            role="tablist">

            <!-- Profile -->
            <li class="nav-item"
                role="presentation">

                <button class="nav-link active"
                        id="profile-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#profileTab"
                        type="button"
                        role="tab"
                        aria-controls="profileTab"
                        aria-selected="true">

                    <i class="bx bx-user"></i>

                    @Localizer["Profile"]

                </button>

            </li>


            <!-- My Team -->
            <li class="nav-item"
                role="presentation">

                <button class="nav-link"
                        id="teams-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#teamsTab"
                        type="button"
                        role="tab"
                        aria-controls="teamsTab"
                        aria-selected="false">

                    <i class="bx bx-group"></i>

                    @Localizer["Myteam"]

                </button>

            </li>

        </ul>

    </div>


    <!-- =====================================================
         TAB CONTENT
         ===================================================== -->

    <div class="tab-content"
         id="profileTabsContent">


        <!-- =================================================
             PROFILE TAB
             ================================================= -->

        <div class="tab-pane fade show active"
             id="profileTab"
             role="tabpanel"
             aria-labelledby="profile-tab">

            <div class="row g-4">


                <!-- =========================================
                     ABOUT ME
                     ========================================= -->

                <div class="col-12 col-lg-5 col-xl-4">

                    <div class="card profile-info-card h-100">

                        <div class="card-body">


                            <!-- Section title -->
                            <div class="profile-section-title">

                                <div>

                                    <h5>
                                        @Localizer["AboutMe"]
                                    </h5>

                                </div>

                            </div>


                            <!-- Information -->
                            <div class="profile-info-list">


                                <!-- Username -->
                                <div class="profile-info-item">

                                    <div class="profile-info-icon profile-icon-primary">

                                        <i class="bx bx-user"></i>

                                    </div>

                                    <div class="profile-info-content">

                                        <span class="profile-info-label">
                                            @Localizer["User"]
                                        </span>

                                        <strong>
                                            @(string.IsNullOrWhiteSpace(Model?.UserName)
                                                                                        ? "—"
                                                                                        : Model.UserName)
                                        </strong>

                                    </div>

                                </div>


                                <!-- Referrer -->
                                <div class="profile-info-item">

                                    <div class="profile-info-icon profile-icon-warning">

                                        <i class="bx bx-crown"></i>

                                    </div>

                                    <div class="profile-info-content">

                                        <span class="profile-info-label">
                                            @Localizer["Referrer"]
                                        </span>

                                        <strong>
                                            @(string.IsNullOrWhiteSpace(Model?.ReferrerName)
                                                                                        ? "—"
                                                                                        : Model.ReferrerName)
                                        </strong>

                                    </div>

                                </div>


                                <!-- Status -->
                                <div class="profile-info-item">

                                    <div class="profile-info-icon profile-icon-success">

                                        <i class="bx bx-check-circle"></i>

                                    </div>

                                    <div class="profile-info-content">

                                        <span class="profile-info-label">
                                            @Localizer["Status"]
                                        </span>

                                        <strong class="text-success">
                                            @Localizer["Active"]
                                        </strong>

                                    </div>

                                </div>

                            </div>


                            <!-- Divider -->
                            <div class="profile-divider"></div>


                            <!-- =================================
                                 CONTACTS
                                 ================================= -->

                            <div class="profile-section-title">

                                <div>

                                    <h5>
                                        @Localizer["Contacts"]
                                    </h5>

                                </div>

                            </div>


                            <div class="profile-info-list">


                                <!-- Phone -->
                                <div class="profile-info-item">

                                    <div class="profile-info-icon profile-icon-info">

                                        <i class="bx bx-phone"></i>

                                    </div>

                                    <div class="profile-info-content">

                                        <span class="profile-info-label">
                                            @Localizer["Phone"]
                                        </span>

                                        <strong>
                                            @(string.IsNullOrWhiteSpace(Model?.Phone)
                                                                                        ? "—"
                                                                                        : Model.Phone)
                                        </strong>

                                    </div>

                                </div>


                                <!-- Email -->
                                <div class="profile-info-item">

                                    <div class="profile-info-icon profile-icon-danger">

                                        <i class="bx bx-envelope"></i>

                                    </div>

                                    <div class="profile-info-content">

                                        <span class="profile-info-label">
                                            @Localizer["Email"]
                                        </span>

                                        <strong class="profile-email">
                                            @(string.IsNullOrWhiteSpace(Model?.Email)
                                                                                        ? "—"
                                                                                        : Model.Email)
                                        </strong>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =========================================
                     ACTIVITY
                     ========================================= -->

                <div class="col-12 col-lg-7 col-xl-8">

                    <div class="card profile-activity-card h-100">


                        <!-- Header -->
                        <div class="card-header profile-card-header">

                            <div class="profile-section-title mb-0">

                                <div class="profile-section-icon profile-section-icon-purple">

                                    <i class="bx bx-bar-chart-alt-2"></i>

                                </div>

                                <div>

                                    <h5>
                                        @Localizer["Chronologyofactivities"]
                                    </h5>

                                    <span>
                                        @Localizer["RecentActivity"]
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- Body -->
                        <div class="card-body">

                            <div class="profile-empty-state">

                                <div class="profile-empty-icon">
                                    <i class="bx bx-time-five"></i>
                                </div>

                                <p>
                                    @Localizer["Noinformationonactivity"]
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             MY TEAM TAB
             ================================================= -->

        <div class="tab-pane fade"
             id="teamsTab"
             role="tabpanel"
             aria-labelledby="teams-tab">


            <!-- =================================================
                 TEAM STATISTICS
                 ================================================= -->

            <div class="row g-4 mb-4">


                <!-- Total Members -->
                <div class="col-12 col-sm-6 col-md-4">

                    <div class="team-stat-card">

                        <div class="team-stat-icon team-stat-icon-purple">
                            <i class="bx bx-group"></i>
                        </div>

                        <div class="team-stat-content">

                            <span>
                                @Localizer["TotalMembers"]
                            </span>

                            <strong>
                                @totalMembers
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Active Members -->
                <div class="col-12 col-sm-6 col-md-4">

                    <div class="team-stat-card">

                        <div class="team-stat-icon team-stat-icon-green">
                            <i class="bx bx-user-check"></i>
                        </div>

                        <div class="team-stat-content">

                            <span>
                                @Localizer["ActiveMembers"]
                            </span>

                            <strong>
                                @activeMembers
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Direct Referrals -->
                <div class="col-12 col-sm-6 col-md-4">

                    <div class="team-stat-card">

                        <div class="team-stat-icon team-stat-icon-blue">
                            <i class="bx bx-user-plus"></i>
                        </div>

                        <div class="team-stat-content">

                            <span>
                                @Localizer["DirectReferrals"]
                            </span>

                            <strong>
                                @directReferrals
                            </strong>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 MY REFERRALS
                 ================================================= -->

            <div class="card team-members-card">


                <!-- Header -->
                <div class="card-header team-members-header">

                    <div>

                        <h5>
                            @Localizer["Myreferrals"]
                        </h5>

                    </div>


                    @if (totalMembers > 0)
                    {
                        <span class="team-members-count">
                            @totalMembers
                        </span>
                    }

                </div>


                <!-- =================================================
                     SCROLLABLE MEMBERS AREA
                     ================================================= -->

                <div class="team-members-scroll">

                    @if (Model.Refferals != null &&
                                        Model.Refferals.Any())
                    {

                        <div class="team-member-list">


                            <!-- Table Header -->
                            <div class="team-member-row team-member-list-header">

                                <div>
                                    @Localizer["Member"]
                                </div>

                                <div>
                                    @Localizer["Joinedin"]
                                </div>

                                <div>
                                    @Localizer["Referrals"]
                                </div>

                                <div>
                                    @Localizer["Status"]
                                </div>

                                <div></div>

                            </div>


                            <!-- Members -->
                            @foreach (var referall in Model.Refferals)
                            {

                                var username =
                                $"{referall.FirstName} {referall.LastName}".Trim();

                                string refJoinedText = "";

                                if (referall.CreatedDate.HasValue)
                                {

                                    var monthRef =
                                    referall.CreatedDate.Value.ToString(
                                    "MMM",
                                    CultureInfo.CurrentUICulture);

                                    var yearRef =
                                    referall.CreatedDate.Value.Year;

                                    refJoinedText =
                                    $"{monthRef} {yearRef}";
                                }


                                <div class="team-member-row">


                                    <!-- Member -->
                                    <div class="team-member-main">

                                        <div class="team-member-avatar">

                                            @if (!string.IsNullOrEmpty(
                                                                                referall.PhotoUrl))
                                            {
                                                <img src="@Url.Content(referall.PhotoUrl)"
                                                     alt="Avatar" />
                                            }
                                            else
                                            {
                                                <i class="bx bx-user"></i>
                                            }

                                    </div>


                                    <div class="team-member-info">

                                        <strong>
                                            @(string.IsNullOrWhiteSpace(username)
                                                                                    ? "—"
                                                                                    : username)
                                    </strong>


                                    @if (!string.IsNullOrEmpty(
                                                                        referall.Email))
                                            {
                                                <span>
                                                    @referall.Email
                                                </span>
                                            }

                                        </div>

                                    </div>


                                    <!-- Joined -->
                                    <div class="team-member-date">

                                        @if (!string.IsNullOrEmpty(
                                                                        refJoinedText))
                                        {
                                            <i class="bx bx-calendar"></i>

                                            <span>
                                                @refJoinedText
                                            </span>
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }

                                    </div>


                                    <!-- Referrals -->
                                    <div class="team-member-referrals">

                                        <i class="bx bx-group"></i>

                                        <strong>
                                            0
                                        </strong>

                                    </div>


                                    <!-- Status -->
                                    <div>

                                        <span class="team-status-badge active">

                                            <span class="team-status-dot"></span>

                                            @Localizer["Active"]

                                        </span>

                                    </div>

                                </div>

                            }

                        </div>

                    }
                    else
                    {

                        <!-- =================================================
                             EMPTY TEAM
                             ================================================= -->

                        <div class="profile-empty-state team-empty-state">

                            <div class="profile-empty-icon">

                                <i class="bx bx-group"></i>

                            </div>

                            <h5>
                                @Localizer["Noinformation"]
                            </h5>

                            <p>
                                @Localizer["Noreferals"]
                            </p>

                        </div>

                    }

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =====================================================
     TOASTS
     ===================================================== -->

<div class="position-fixed bottom-0 end-0 p-3"
     style="z-index: 1055">


    <!-- Referral -->
    <div id="referralToast"
         class="toast referral-toast"
         role="alert"
         aria-live="assertive"
         aria-atomic="true">

        <div class="d-flex align-items-center">

            <div class="referral-toast-icon">
                <i class="bx bx-check"></i>
            </div>

            <div class="toast-body">
                @Localizer["Linkcopied"]
            </div>

            <button type="button"
                    class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"
                    aria-label="Close">
            </button>

        </div>

    </div>


    <!-- Photo -->
    <div id="photoToast"
         class="toast referral-toast mt-2"
         role="alert"
         aria-live="assertive"
         aria-atomic="true">

        <div class="d-flex align-items-center">

            <div class="referral-toast-icon">
                <i class="bx bx-image"></i>
            </div>

            <div class="toast-body">
                @Localizer["Photosaved"]
            </div>

            <button type="button"
                    class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"
                    aria-label="Close">
            </button>

        </div>

    </div>

</div>


<!-- =====================================================
     CROPPER.JS
     ===================================================== -->

<script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>


<!-- =====================================================
     PAGE SCRIPT
     ===================================================== -->

<script>

    /* =========================================================
       PROFILE PHOTO
       ========================================================= */

    let selectedPhotoFile = null;

    let photoCropper = null;


    const profilePhotoInput =
        document.getElementById("profilePhotoInput");

    const photoUploadPanel =
        document.getElementById("photoUploadPanel");

    const photoCropImage =
        document.getElementById("photoCropImage");

    const cancelPhotoBtn =
        document.getElementById("cancelPhotoBtn");

    const savePhotoBtn =
        document.getElementById("savePhotoBtn");

    const zoomInPhotoBtn =
        document.getElementById("zoomInPhotoBtn");

    const zoomOutPhotoBtn =
        document.getElementById("zoomOutPhotoBtn");

    const resetPhotoBtn =
        document.getElementById("resetPhotoBtn");


    /*
     * Minimum zoom level.
     *
     * Prevents the user from making the image
     * smaller than the crop area.
     */

    let minimumPhotoZoom = 0;


    /* =========================================================
       SELECT PHOTO
       ========================================================= */

    profilePhotoInput?.addEventListener(
        "change",
        function () {

            const file =
                this.files?.[0];

            if (!file) {
                return;
            }


            /*
             * Validate file type
             */

            const allowedTypes = [
                "image/jpeg",
                "image/png",
                "image/webp"
            ];


            if (!allowedTypes.includes(file.type)) {

                alert(
                    "Please select JPG, PNG or WEBP image."
                );

                this.value = "";

                return;
            }


            /*
             * Validate file size
             *
             * 5 MB
             */

            const maxSize =
                5 * 1024 * 1024;


            if (file.size > maxSize) {

                alert(
                    "Maximum file size is 5 MB."
                );

                this.value = "";

                return;
            }


            selectedPhotoFile = file;


            /*
             * Read image
             */

            const reader =
                new FileReader();


            reader.onload =
                function (event) {

                    photoCropImage.src =
                        event.target.result;


                    photoUploadPanel
                        .classList
                        .remove("d-none");


                    /*
                     * Destroy previous Cropper
                     */

                    if (photoCropper) {

                        photoCropper.destroy();

                        photoCropper = null;
                    }


                    /*
                     * Initialize Cropper
                     */

                    photoCropImage.onload =
                        function () {

                            photoCropper =
                                new Cropper(
                                    photoCropImage,
                                    {

                                        /*
                                         * Avatar is square
                                         */

                                        aspectRatio: 1,


                                        /*
                                         * Prevent image
                                         * from leaving crop area
                                         */

                                        viewMode: 1,


                                        /*
                                         * Drag the image
                                         */

                                        dragMode: "move",


                                        /*
                                         * Initial crop size
                                         */

                                        autoCropArea: 0.85,


                                        /*
                                         * Disable unnecessary UI
                                         */

                                        restore: false,

                                        guides: false,

                                        center: true,

                                        highlight: false,

                                        background: false,


                                        /*
                                         * User cannot change
                                         * crop box size.
                                         */

                                        cropBoxMovable: false,

                                        cropBoxResizable: false,


                                        /*
                                         * Better mobile behavior
                                         */

                                        responsive: true,

                                        toggleDragModeOnDblclick: false,


                                        /*
                                         * Calculate minimum
                                         * zoom after initialization
                                         */

                                        ready: function () {

                                            const cropBoxData =
                                                this.cropper
                                                    .getCropBoxData();

                                            const containerData =
                                                this.cropper
                                                    .getContainerData();

                                            const imageData =
                                                this.cropper
                                                    .getImageData();


                                            /*
                                             * Determine the scale
                                             * required to cover
                                             * the entire crop area.
                                             */

                                            const cropWidth =
                                                cropBoxData.width;

                                            const cropHeight =
                                                cropBoxData.height;


                                            const imageWidth =
                                                imageData.naturalWidth;

                                            const imageHeight =
                                                imageData.naturalHeight;


                                            const scaleX =
                                                cropWidth /
                                                imageWidth;

                                            const scaleY =
                                                cropHeight /
                                                imageHeight;


                                            minimumPhotoZoom =
                                                Math.max(
                                                    scaleX,
                                                    scaleY
                                                );


                                            /*
                                             * Cropper normally
                                             * starts at a suitable
                                             * scale, so we only
                                             * keep this value for
                                             * reference.
                                             */

                                        }

                                    }
                                );

                        };

                };


            reader.readAsDataURL(file);

        }
    );


    /* =========================================================
       ZOOM IN
       ========================================================= */

    zoomInPhotoBtn?.addEventListener(
        "click",
        function () {

            if (!photoCropper) {
                return;
            }

            photoCropper.zoom(0.1);

        }
    );


    /* =========================================================
       ZOOM OUT
       ========================================================= */

    zoomOutPhotoBtn?.addEventListener(
        "click",
        function () {

            if (!photoCropper) {
                return;
            }

            photoCropper.zoom(-0.1);

        }
    );


    /* =========================================================
       RESET
       ========================================================= */

    resetPhotoBtn?.addEventListener(
        "click",
        function () {

            if (!photoCropper) {
                return;
            }

            photoCropper.reset();

        }
    );


    /* =========================================================
       CANCEL
       ========================================================= */

    cancelPhotoBtn?.addEventListener(
        "click",
        function () {

            selectedPhotoFile = null;

            profilePhotoInput.value = "";


            if (photoCropper) {

                photoCropper.destroy();

                photoCropper = null;
            }


            photoUploadPanel
                .classList
                .add("d-none");


            photoCropImage.src = "";

        }
    );


    /* =========================================================
       SAVE PHOTO
       ========================================================= */

    savePhotoBtn?.addEventListener(
        "click",
        async function () {

            if (!photoCropper) {
                return;
            }


            const originalContent =
                savePhotoBtn.innerHTML;


            savePhotoBtn.disabled = true;


            savePhotoBtn.innerHTML = `
                <span class="spinner-border spinner-border-sm me-1"></span>
                @Localizer["Saving"]
            `;


            try {

                /*
                 * Create final cropped image.
                 *
                 * 512x512 is more than enough for
                 * profile avatars and keeps the file
                 * reasonably small.
                 */

                const canvas =
                    photoCropper.getCroppedCanvas(
                        {
                            width: 512,

                            height: 512,

                            imageSmoothingEnabled: true,

                            imageSmoothingQuality: "high"
                        }
                    );


                if (!canvas) {

                    throw new Error(
                        "Unable to crop photo."
                    );

                }


                /*
                 * Convert canvas to JPEG Blob
                 */

                const blob =
                    await new Promise(
                        resolve => {

                            canvas.toBlob(
                                resolve,

                                "image/jpeg",

                                0.90
                            );

                        }
                    );


                if (!blob) {

                    throw new Error(
                        "Unable to process photo."
                    );

                }


                /*
                 * FormData
                 */

                const formData =
                    new FormData();


                formData.append(
                    "photo",
                    blob,
                    "profile.jpg"
                );


                /*
                 * Anti-forgery token
                 */

                const tokenElement =
                    document.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    );


                const token =
                    tokenElement
                        ? tokenElement.value
                        : "";


                /*
                 * Upload
                 */

                const response =
                    await fetch(
                        '@Url.Action("UploadPhoto", "Account")',
                        {
                            method: "POST",

                            body: formData,

                            headers: token
                                ? {
                                    "RequestVerificationToken":
                                        token
                                }
                                : {}
                        }
                    );


                if (!response.ok) {

                    throw new Error(
                        "Unable to upload photo."
                    );

                }


                const result =
                    await response.json();


                if (!result.success) {

                    throw new Error(
                        result.message ||
                        "Unable to upload photo."
                    );

                }


                /*
                 * Cache busting
                 */

                const cacheBustedPhotoUrl =
                    `${result.photoUrl}?v=${Date.now()}`;

                /* =================================================
                   UPDATE PROFILE AVATAR
                   ================================================= */

                const avatar =
                    document.getElementById(
                        "profileAvatar"
                    );


                if (avatar) {

                    if (avatar.tagName === "IMG") {

                        avatar.src =
                            cacheBustedPhotoUrl;

                    }
                    else {

                        const newAvatar =
                            document.createElement("img");


                        newAvatar.id =
                            "profileAvatar";


                        newAvatar.className =
                            "profile-avatar";


                        newAvatar.alt =
                            "User avatar";


                        newAvatar.src =
                            cacheBustedPhotoUrl;


                        avatar.replaceWith(
                            newAvatar
                        );

                    }

                }


                /* =================================================
                   UPDATE NAVBAR AVATARS
                   ================================================= */

                    const navbarAvatars =
                        document.querySelectorAll(
                            ".partnerly-user-avatar, .partnerly-user-header-avatar"
                        );

                    navbarAvatars.forEach(function (avatar) {
                        avatar.src = cacheBustedPhotoUrl;
                    });


                /* =================================================
                   RESET CROP UI
                   ================================================= */

                if (photoCropper) {

                    photoCropper.destroy();

                    photoCropper = null;
                }


                selectedPhotoFile = null;

                profilePhotoInput.value = "";


                photoUploadPanel
                    .classList
                    .add("d-none");


                photoCropImage.src = "";


                /* =================================================
                   SUCCESS TOAST
                   ================================================= */

                showPhotoToast(
                    result.message ||
                    "@Localizer["Photosaved"]"
                );

            }
            catch (error) {

                console.error(
                    "Photo upload error:",
                    error
                );


                alert(
                    error.message ||
                    "Unable to upload photo."
                );

            }
            finally {

                savePhotoBtn.disabled = false;

                savePhotoBtn.innerHTML =
                    originalContent;

            }

        }
    );


    /* =========================================================
       PHOTO SUCCESS TOAST
       ========================================================= */

    function showPhotoToast(message) {

        const toastEl =
            document.getElementById(
                "photoToast"
            );


        if (!toastEl) {
            return;
        }


        const toastBody =
            toastEl.querySelector(
                ".toast-body"
            );


        if (toastBody && message) {

            toastBody.textContent =
                message;

        }


        const toast =
            new bootstrap.Toast(
                toastEl,
                {
                    delay: 2500
                }
            );


        toast.show();

    }


    /* =========================================================
       REFERRAL LINK
       ========================================================= */

    function copyReferralLink(code) {

        if (!code) {
            return;
        }


        const url =
            `${window.location.origin}/Account/Register?reff=${encodeURIComponent(code)}`;


        navigator.clipboard
            .writeText(url)
            .then(() => {

                const toastEl =
                    document.getElementById(
                        "referralToast"
                    );


                if (!toastEl) {
                    return;
                }


                const toast =
                    new bootstrap.Toast(
                        toastEl,
                        {
                            delay: 2500
                        }
                    );


                toast.show();

            })
            .catch(error => {

                console.error(
                    "Copy error:",
                    error
                );

            });

    }

</script>