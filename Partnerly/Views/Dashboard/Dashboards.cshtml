                    <article class="dashboards-kpi dashboards-kpi--notes">
                        <div class="dashboards-kpi-body">
                            <span class="dashboards-kpi-label">@Localizer["Unassigned"]</span>
                            <strong class="dashboards-kpi-value">@Model.TasksUnassigned</strong>
                            <span class="dashboards-kpi-hint">@Pct(Model.TasksUnassigned, Model.TasksTotal)% @Localizer["DashboardsTotal"]</span>
                        </div>
                        <span class="dashboards-kpi-icon"><i class="bx bx-user-x"></i></span>
                    </article>
                    <article class="dashboards-kpi dashboards-kpi--tasks">
                        <div class="dashboards-kpi-body">
                            <span class="dashboards-kpi-label">@Localizer["Unread"]</span>
                            <strong class="dashboards-kpi-value">@Model.TasksUnread</strong>
                            <span class="dashboards-kpi-hint">@Pct(Model.TasksUnread, Model.TasksTotal)% @Localizer["DashboardsTotal"]</span>
                        </div>
                        <span class="dashboards-kpi-icon"><i class="bx bx-envelope-open"></i></span>
                    </article>
                    <article class="dashboards-kpi dashboards-kpi--personal">
                        <div class="dashboards-kpi-body">
                            <span class="dashboards-kpi-label">@Localizer["ThisWeek"]</span>
                            <strong class="dashboards-kpi-value">@Model.TasksWeek</strong>
                            <span class="dashboards-kpi-hint">@Pct(Model.TasksWeek, Model.TasksTotal)% @Localizer["DashboardsTotal"]</span>
                        </div>
                        <span class="dashboards-kpi-icon"><i class="bx bx-calendar"></i></span>
                    </article>
                    <article class="dashboards-kpi dashboards-kpi--roles">
                        <div class="dashboards-kpi-body">
                            <span class="dashboards-kpi-label">@Localizer["OpenTasks"]</span>
                            <strong class="dashboards-kpi-value">@tasksOpen</strong>
                            <span class="dashboards-kpi-hint">@Model.TasksNew @Localizer["New"] · @Model.TasksInProgress @Localizer["InProgress"]</span>
                        </div>
                        <span class="dashboards-kpi-icon"><i class="bx bx-time-five"></i></span>
                    </article>
                </div>
                <div class="dashboards-card-grid">
                    <article class="dashboards-card">
                        <div class="dashboards-card-head">
                            <h5><i class="bx bx-bar-chart-alt-2"></i> @Localizer["TasksByStatus"]</h5>
                        </div>
                        @foreach (var row in Model.TasksByStatus)
                        {
                            <div class="dashboards-bar">
                                <div class="dashboards-bar-meta">
                                    <span>@NamedLabel(row.Name)</span>
                                    <span>@row.Count · @row.Percent%</span>
                                </div>
                                <div class="dashboards-bar-track">
                                    <div class="dashboards-bar-fill dashboards-bar-fill--tasks" style="width: @row.Percent%"></div>
                                </div>
                            </div>
