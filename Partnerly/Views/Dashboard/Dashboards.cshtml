@model Partnerly.Models.ViewModels.DashboardsViewModel
@using Partnerly.Models.ViewModels
@{
    ViewData["Title"] = Localizer["Dashboards"].Value;
    string Fmt(DateTime? d) => d.HasValue ? d.Value.ToString("g") : "";
    string ItemTitle(DashboardListItem item) =>
        string.IsNullOrWhiteSpace(item.Title) ? item.Meta : item.Title;
    string NamedLabel(string? name) => name switch
    {
        "New" => Localizer["New"].Value,
        "InProgress" => Localizer["InProgress"].Value,
        "Closed" => Localizer["Closed"].Value,
        "Online" => Localizer["Online"].Value,
        "Blocked" => Localizer["Blocked"].Value,
        "Unread" => Localizer["Unread"].Value,
        "Information" => Localizer["Information"].Value,
        "Warning" => Localizer["Warning"].Value,
        "Error" => Localizer["Error"].Value,
        "Success" => Localizer["Success"].Value,
        _ => name ?? ""
    };
    int Pct(int part, int total) => total <= 0 ? 0 : (int)Math.Round(part * 100d / total);
    var hasModule = Model.CanUsers || Model.CanRoles || Model.CanTasks || Model.CanGroups || Model.CanNotifications;
    var tasksOpen = Model.TasksNew + Model.TasksInProgress;
    var notificationsRead = Model.NotificationsTotal - Model.NotificationsUnread;
    var firstTab = Model.CanUsers ? "users"
        : Model.CanTasks ? "tasks"
        : Model.CanRoles ? "roles"
        : Model.CanGroups ? "groups"
        : Model.CanNotifications ? "notifications"
        : "";
}

@section PageStyles {
    <link rel="stylesheet" href="~/assets/css/dashboards.css" asp-append-version="true" />
}

@section PageScripts {
    <script src="~/assets/js/dashboards.js" asp-append-version="true"></script>
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="dashboards-page dashboards" data-dashboards>
        @* <header class="dashboards-header">
            <h4 class="dashboards-title">
                <i class="bx bx-grid-alt"></i>
                @Localizer["Dashboards"]
            </h4>
        </header> *@

        @if (!hasModule)
        {
            <p class="dashboards-empty">@Localizer["DashboardsNoAccess"]</p>
        }
        else
        {
        <nav class="dashboards-tabs" role="tablist" aria-label="@Localizer["Dashboards"]">
            @if (Model.CanUsers)
            {
                <button type="button"
                        class="dashboards-tab@(firstTab == "users" ? " is-active" : "")"
                        role="tab"
                        aria-selected="@(firstTab == "users" ? "true" : "false")"
                        data-dash-tab="users">
                    <i class="bx bx-user"></i>
                    <span class="dashboards-tab-label">@Localizer["Users"]</span>
                    <span class="dashboards-tab-count">@Model.UsersTotal</span>
                </button>
            }
            @if (Model.CanTasks)
            {
                <button type="button"
                        class="dashboards-tab@(firstTab == "tasks" ? " is-active" : "")"
                        role="tab"
                        aria-selected="@(firstTab == "tasks" ? "true" : "false")"
                        data-dash-tab="tasks">
                    <i class="bx bx-task"></i>
                    <span class="dashboards-tab-label">@Localizer["Tasks"]</span>
                    <span class="dashboards-tab-count">@Model.TasksTotal</span>
                </button>
            }
            @if (Model.CanRoles)
            {
                <button type="button"
                        class="dashboards-tab@(firstTab == "roles" ? " is-active" : "")"
                        role="tab"
                        aria-selected="@(firstTab == "roles" ? "true" : "false")"
                        data-dash-tab="roles">
                    <i class="bx bx-shield-quarter"></i>
                    <span class="dashboards-tab-label">@Localizer["Roles"]</span>
                    <span class="dashboards-tab-count">@Model.RolesTotal</span>
                </button>
            }
            @if (Model.CanGroups)
            {
                <button type="button"
                        class="dashboards-tab@(firstTab == "groups" ? " is-active" : "")"
                        role="tab"
                        aria-selected="@(firstTab == "groups" ? "true" : "false")"
                        data-dash-tab="groups">
                    <i class="bx bx-group"></i>
                    <span class="dashboards-tab-label">@Localizer["Groups"]</span>
                    <span class="dashboards-tab-count">@Model.GroupsTotal</span>
                </button>
            }
            @if (Model.CanNotifications)
            {
                <button type="button"
                        class="dashboards-tab@(firstTab == "notifications" ? " is-active" : "")"
                        role="tab"
                        aria-selected="@(firstTab == "notifications" ? "true" : "false")"
                        data-dash-tab="notifications">
                    <i class="bx bx-bell"></i>
                    <span class="dashboards-tab-label">@Localizer["Notifications"]</span>
                    <span class="dashboards-tab-count">@Model.NotificationsTotal</span>
                </button>
            }
        </nav>
        }

        @if (Model.CanUsers)
        {
            <section class="dashboards-panel" data-dash-panel="users" role="tabpanel" @(firstTab == "users" ? null : "hidden")>
                <div class="dashboards-kpi-grid">
                    <article class="dashboards-kpi dashboards-kpi--users">
                        <div class="dashboards-kpi-body">
                            <span class="dashboards-kpi-label">@Localizer["DashboardsTotal"]</span>
                            <strong class="dashboards-kpi-value">@Model.UsersTotal</strong>
