                                            }
                                        </span>
                                        <span class="dashboards-list-meta">@item.Meta</span>
                                        <span class="dashboards-list-date">@Fmt(item.Date)</span>
                                    </li>
                                }
                            </ul>
                        }
                    </article>
                </div>
            </section>
