                            <span class="dashboards-kpi-hint">@Pct(Model.UsersOnline, Model.UsersTotal)% @Localizer["DashboardsTotal"]</span>
                        </div>
                        <span class="dashboards-kpi-icon"><i class="bx bx-wifi"></i></span>
                    </article>
                    <article class="dashboards-kpi dashboards-kpi--notes">
