                            <span class="dashboards-kpi-label">@Localizer["GoogleSignIn"]</span>
                            <strong class="dashboards-kpi-value">@Model.UsersGoogle</strong>
                            <span class="dashboards-kpi-hint">@Pct(Model.UsersGoogle, Model.UsersTotal)% @Localizer["DashboardsTotal"]</span>
                        </div>
                        <span class="dashboards-kpi-icon"><i class="bx bxl-google"></i></span>
                    </article>
                </div>
                <div class="dashboards-card-grid">
                    <article class="dashboards-card">
                        <div class="dashboards-card-head">
                            <h5><i class="bx bx-pie-chart-alt"></i> @Localizer["UsersByRole"]</h5>
                        </div>
                        @if (Model.UsersByRole.Count == 0)
                        {
                            <p class="dashboards-empty">@Localizer["DashboardsEmptyList"]</p>
                        }
                        else
                        {
                            foreach (var row in Model.UsersByRole)
                            {
                                <div class="dashboards-bar">
                                    <div class="dashboards-bar-meta">
                                        <span>@row.Name</span>
                                        <span>@row.Count · @row.Percent%</span>
                                    </div>
                                    <div class="dashboards-bar-track">
                                        <div class="dashboards-bar-fill dashboards-bar-fill--users" style="width: @row.Percent%"></div>
                                    </div>
                                </div>
                            }
                        }
                    </article>
                    <article class="dashboards-card">
                        <div class="dashboards-card-head">
                            <h5><i class="bx bx-time-five"></i> @Localizer["RecentUsers"]</h5>
                        </div>
                        @if (Model.RecentUsers.Count == 0)
                        {
                            <p class="dashboards-empty">@Localizer["DashboardsEmptyList"]</p>
                        }
                        else
                        {
                            <ul class="dashboards-list">
                                @foreach (var item in Model.RecentUsers)
                                {
                                    <li>
                                        <span class="dashboards-list-title">
                                            @ItemTitle(item)
                                            @if (!string.IsNullOrEmpty(item.Badge))
                                            {
                                                <span class="dashboards-badge">@NamedLabel(item.Badge)</span>
                                            }
                                        </span>
                                        <span class="dashboards-list-meta">@item.Meta</span>
                                        <span class="dashboards-list-date">@Fmt(item.Date)</span>
                                    </li>
                                }
                            </ul>
                        }
                    </article>
                </div>
            </section>
        }

