@model Partnerly.Models.ViewModels.MySettingsViewModel;
@await Html.PartialAsync("_Toast")
@{
  ViewData["Title"] = "Настройки";
  Layout = "_ContentNavbarLayout";
}

<div class="card">
    <div class="card-header">
        <h5>@ViewData["Title"]</h5>
    </div>
    <form id="settingsForm" asp-action="Settings">
        <input type="hidden" id="activeTab" name="ActiveTab" value="@Model?.ActiveTab" />
        <div class="card-body">

            @await Html.PartialAsync("_StickyButtons", new Partnerly.Models.ViewModels.FormActionsViewModel {
                Back = new Partnerly.Models.ViewModels.ActionBack(visible: true, fromController: "Dashboard", toController: "Home", fromAction: "Settings", toAction: "Index"),
                Undo = new Partnerly.Models.ViewModels.ActionUndo(visible: true, fromController: "Dashboard", toController: "Dashboard", fromAction: "Settings", toAction: "Settings"),
                Save = new Partnerly.Models.ViewModels.ActionSave(visible: true, fromController: "Dashboard", toController: "Dashboard", fromAction: "Settings", toAction: "Settings"),
            })
        </div>
        <div class="card-content ">
           <div class="nav-align-top nav-tabs mb-6">
            <ul class="nav nav-tabs nav-fill" role="tablist">
                <li class="nav-item">
                <button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-justified-profile" aria-controls="navs-justified-profile" aria-selected="false"><span class="d-none d-sm-block"><i class="tf-icons bx bx-user bx-sm me-1_5 align-text-bottom"></i> Профиль</span><i class="bx bx-user bx-sm d-sm-none"></i></button>
            </li>
                <li class="nav-item">
                <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-justified-home" aria-controls="navs-justified-home" aria-selected="true"><span class="d-none d-sm-block"><i class="tf-icons bx bx-key bx-sm me-1_5 align-text-bottom"></i> Изменить пароль </span><i class="bx bx-key bx-sm d-sm-none"></i></button>
            </li>
       
            <li class="nav-item">
                <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-justified-messages" aria-controls="navs-justified-messages" aria-selected="false"><span class="d-none d-sm-block"><i class="tf-icons bx bx-bell bx-sm me-1_5 align-text-bottom"></i> Уведомления</span><i class="bx bx-bell bx-sm d-sm-none"></i></button>
            </li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane fade show active" id="navs-justified-profile" role="tabpanel">
                    <input type="hidden" asp-for="Id" />

                <div class="form-floating mb-1 max-w-600">
                   <input asp-for="FirstName" class="form-control" id="firstName" name="firstName" placeholder=""/>
                   <label asp-for="FirstName"></label>
                   <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="form-floating mb-1 max-w-600">
                   <input asp-for="LastName" class="form-control" id="lastName" name="lastName" placeholder=""/>
                   <label asp-for="LastName"></label>
                   <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="form-floating mb-1 max-w-600">
                   <input asp-for="Email" class="form-control" id="email" name="email" placeholder="Введите свой адрес электронной почты" readonly/>
                   <label asp-for="Email"></label>
                   <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-floating mb-1 max-w-600">
                   <input asp-for="Phone" class="form-control" id="phone" name="phone" placeholder="+37477123456" readonly/>
                   <label asp-for="Phone"></label>
                   <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="form-floating mb-2 max-w-600">
                   <input asp-for="MyReferralCode" class="form-control" id="myReferralCode" name="myReferralCode" readonly placeholder=""/>
                   <label asp-for="MyReferralCode"></label>
                   <span asp-validation-for="MyReferralCode" class="text-danger"></span>
                </div>
            </div>
            <div class="tab-pane fade" id="navs-justified-home" role="tabpanel">
                 <div class="mb-1 form-password-toggle max-w-600">
                    <div class="form-floating input-group input-group-merge">
                        <input asp-for="OldPassword" type="password" id="oldPassword" class="form-control" name="oldPassword" placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;" aria-describedby="password"/>
                        <label asp-for="OldPassword"></label>
                        <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
                    </div>
                    <span asp-validation-for="OldPassword" class="text-danger"></span>
                </div>
                <div class="mb-1 form-password-toggle max-w-600">
                    <div class="form-floating input-group input-group-merge">
                        <input asp-for="Password" type="password" id="password" class="form-control" name="password" placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;" aria-describedby="password"/>
                        <label asp-for="Password"></label>
                        <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="mb-1 form-password-toggle max-w-600">
                    <div class="form-floating input-group input-group-merge">
                        <input asp-for="ConfirmPassword" type="password" id="confirmpassword" class="form-control" name="confirmpassword" placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;" aria-describedby="password"/>
                        <label asp-for="ConfirmPassword"></label>
                        <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>  
                </div>
            <div class="tab-pane fade" id="navs-justified-messages" role="tabpanel">
                <div class="card-body">
                    <div class="form-check form-switch mb-2">
                        <input asp-for="AllowSendEmailsBool" class="form-check-input" type="checkbox" id="allowSendEmails" />
                        <label class="form-check-label" asp-for="AllowSendEmails" for="allowSendEmails"></label>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input asp-for="AllowSendNotificationsBool" class="form-check-input" type="checkbox" id="allowSendNotifications" />
                        <label class="form-check-label" asp-for="AllowSendNotifications" for="allowSendNotifications"></label>
                    </div>
                </div>
            </div>
            </div>
        </div>
     </div>
    </form>
</div>

<script src="~/js/form-change-tracker.js"></script>
<script>
    enableSaveOnChange("#settingsForm", "#btnSave");

    document.addEventListener('DOMContentLoaded', function () {
        // Когда пользователь переключает вкладку — сохраняем ID
        const tabButtons = document.querySelectorAll('[data-bs-toggle="tab"]');
        tabButtons.forEach(button => {
            button.addEventListener('shown.bs.tab', function (event) {
                const activeTab = event.target.getAttribute('data-bs-target');
                document.getElementById('activeTab').value = activeTab;
            });
        });

        // При загрузке страницы — активируем таб, который был сохранён
        const activeTabValue = document.getElementById('activeTab').value;
        if (activeTabValue) {
            const triggerEl = document.querySelector(`[data-bs-target="${activeTabValue}"]`);
            if (triggerEl) {
                const tab = new bootstrap.Tab(triggerEl);
                tab.show();
            }
        }
    });
</script>
