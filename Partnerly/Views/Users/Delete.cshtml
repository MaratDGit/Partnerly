@model Partnerly.Models.ViewModels.UserViewModel;
@await Html.PartialAsync("_Toast")

@{
    ViewData["Title"] = "Delete User";
    Layout = "_ContentNavbarLayout";
}

@await Html.PartialAsync(
"_DeleteConfirmation",
    new Partnerly.Models.ViewModels.DeleteConfirmationViewModel
    {
        Id = Model.Id,
        Title = Localizer["DeleteUser"],
        Message = Localizer["Areyousureyouwanttodeletethisfile"],
        DeleteAction = "DeleteConfirmed",
        DeleteController = "Users",
        CancelAction = "Index",
        CancelController = "Users"
    })