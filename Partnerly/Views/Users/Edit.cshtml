@model Partnerly.Models.ViewModels.UserViewModel;
@await Html.PartialAsync("_Toast")

@{
    ViewData["Title"] = "Редактировать пользователя";
    Layout = "_ContentNavbarLayout";
}

<div class="card">
    <div class="card-header justify-content-between">
        <h5>@ViewData["Title"]</h5>
    </div>

    <div class="card-body">
        <form id="userEditForm" asp-action="Edit">
            @await Html.PartialAsync("_StickyButtons", new Partnerly.Models.ViewModels.FormActionsViewModel {
                Back = new Partnerly.Models.ViewModels.ActionBack(id: Model.Id,visible: true, fromController: "Users", toController: "Users", fromAction: "Edit", toAction: "Index"),
                Undo = new Partnerly.Models.ViewModels.ActionUndo(id: Model.Id, visible: true, fromController: "Users", toController: "Users", fromAction: "Edit", toAction: "Edit"),
                Save = new Partnerly.Models.ViewModels.ActionSave(id: Model.Id, visible: true, fromController: "Users", toController: "Users", fromAction: "Edit", toAction: "Edit"),
                Create = new Partnerly.Models.ViewModels.ActionCreate(id: Model.Id, visible: true, fromController: "Users", toController: "Users", fromAction: "Edit", toAction: "Create"),
                Delete = new Partnerly.Models.ViewModels.ActionDelete(id: Model.Id, visible: true, fromController: "Users", toController: "Users", fromAction: "Edit", toAction: "Delete"),
                Note = new Partnerly.Models.ViewModels.ActionNote(visible: true, note: Model.Note, id: Model.Id),
                Menu = new Partnerly.Models.ViewModels.ActionMenu(visible: true),
                MenuActions = new List<Partnerly.Models.ViewModels.MenuItemAction> {
                    new Partnerly.Models.ViewModels.MenuItemAction(visible: true, icon: "bx bx-key", displayName: "Изменить роль", toController: "Roles", toAction: "Edit", routID: Model.Id),
                }
            })

            <input type="hidden" asp-for="Id" />
            <input type="hidden" id="hiddenNote" asp-for="Note" />

            <div class="form-floating mb-1 max-w-600 position-relative">
                <input asp-for="FirstName"
                       id="firstName"
                       name="firstName"
                       type="text"
                       class="form-control lookup-input pe-5"
                       placeholder=" "
                       data-lookup="true"
                       data-lookup-source="/Users/GetLookupList"
                       data-lookup-title="Пользователи"
                       data-edit-url-base="/Users/Edit/"
                       data-lookup-column-names="name:Название,email:Электронная почта"
                       data-lookup-display-field="FirstName"
                       data-lookup-param="fieldName"
                       data-lookup-param-value="Name" autofocus/>
                <label asp-for="FirstName"></label>
                <i class='bx bx-search lookup-icon'></i>
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            
            <div class="form-floating mb-1 max-w-600">
               <input asp-for="LastName" class="form-control" id="lastName" name="lastName" placeholder=""/>
               <label asp-for="LastName"></label>
               <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="form-floating mb-1 max-w-600">
               <input asp-for="Email" class="form-control" id="email" name="email" placeholder="Введите свой адрес электронной почты"/>
               <label asp-for="Email"></label>
               <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-1 max-w-600">
               <input asp-for="Phone" class="form-control" id="phone" name="phone" placeholder="+37477123456"/>
               <label asp-for="Phone"></label>
               <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="form-floating mb-1 max-w-600">
               <input asp-for="Balance" class="form-control" id="balance" name="balance" placeholder=""/>
               <label asp-for="Balance"></label>
               <span asp-validation-for="Balance" class="text-danger"></span>
            </div>
            <div class="form-floating mb-2 max-w-600">
               <input asp-for="MyReferralCode" class="form-control" id="myReferralCode" name="myReferralCode" readonly placeholder=""/>
               <label asp-for="MyReferralCode"></label>
               <span asp-validation-for="MyReferralCode" class="text-danger"></span>
            </div>
            <div class="form-check form-switch mb-2">
                <input asp-for="EmailConfirmedBool" class="form-check-input" type="checkbox" id="emailConfirmed" />
                <label class="form-check-label" asp-for="EmailConfirmed" for="emailConfirmed"></label>
            </div>
            <div class="form-check form-switch mb-2">
                <input asp-for="IsBlockedBool" class="form-check-input" type="checkbox" id="isBlocked" />
                <label class="form-check-label" asp-for="IsBlocked" for="isBlocked"></label>
            </div>
        </form>
    </div>
</div>

<script src="~/js/form-change-tracker.js"></script>
<script>
    enableSaveOnChange("#userEditForm", "#btnSave");
</script>


