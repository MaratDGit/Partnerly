@{
    ViewData["Title"] = "Пользователи";
    Layout = "_ContentNavbarLayout";
}

@await Html.PartialAsync("_DataTablePartial", null, new ViewDataDictionary(ViewData)
{
    { "TableName", "Пользователи" },
    { "TableId", "usersTable" },
    { "NewRecordControler", "Users" }
})

@section PageScripts {
    <script>
        $(document).ready(function () {
            initUniqueDataTable("usersTable", '@Url.Action("GetData", "Users")', {
                getDataParams: { tableModel: "User" },
                exportAllUrl: '@Url.Action("ExportAllToExcel", "Users")',
                exportSelectedUrl: '@Url.Action("ExportToExcel", "Users")'
            });
        });
    </script>
}