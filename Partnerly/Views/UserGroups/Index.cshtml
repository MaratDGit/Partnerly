@{
    ViewData["Title"] = "Группы пользователей";
    Layout = "_ContentNavbarLayout";
    bool hasAdminRole = ViewBag?.RoleType == Partnerly.Descriptors.Attributes.RoleTypeAttribute.Delete;
}

@await Html.PartialAsync("_DataTablePartial", null, new ViewDataDictionary(ViewData)
{
    { "TableName", "Группы" },
    { "TableId", "userGroupsTable" },
    { "NewRecordControler", "UserGroups" }
})

@section PageScripts {
    <script>
        $(document).ready(function () {
            initUniqueDataTable("userGroupsTable", '@Url.Action("GetData", "UserGroups")', {
                getDataParams: { tableModel: "UserGroup" },
                exportAllUrl: '@(hasAdminRole? Url.Action("ExportAllToExcel", "UserGroups"): "")',
                exportSelectedUrl: '@(hasAdminRole? Url.Action("ExportToExcel", "UserGroups"): "")',
            });
        });
    </script>
}