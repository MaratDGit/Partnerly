@model Partnerly.Models.ViewModels.UserGroupViewModel;
@await Html.PartialAsync("_Toast")

@{
    ViewData["Title"] = "Создать группу";
    Layout = "_ContentNavbarLayout";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5>@ViewData["Title"]</h5>
    </div>

    <div class="card-body">
        <form id="userGroupCreateForm" asp-action="Create">
            <div class="sticky-buttons justify-content-between mb-6">
                <a asp-action="Index" class="btn btn-link p-0">
                    <i class="bx bx-arrow-back me-1 fs-3"></i> 
                </a>
                <a asp-action="Create" asp-route-id="" class="btn btn-link p-0">
                    <i class="bx bx-undo me-1 fs-3"></i>
                </a>
                <button type="submit" id="btnSave" class="btn btn-link p-0">
                    <i class="bx bx-save me-1 fs-3"></i> 
                </button>
            </div>

            <div class="form-floating mb-1 max-w-600 position-relative">
                <input asp-for="Name"
                       id="name"
                       name="name"
                       type="text"
                       class="form-control lookup-input pe-5"
                       placeholder=" "
                       data-lookup="true"
                       data-lookup-source="/UserGroups/GetLookupList"
                       data-lookup-title="Список групп"
                       data-edit-url-base="/UserGroups/Edit/"
                       data-lookup-column-names="name:Название,description:Описание"
                       data-lookup-display-field="Name"
                       data-lookup-param="fieldName"
                       data-lookup-param-value="Name" autofocus/>
                <label asp-for="Name"></label>
                <i class='bx bx-search lookup-icon'></i>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-floating mb-10 max-w-600">
               <input asp-for="Description" class="form-control" id="description" name="description" placeholder=""/>
                <label asp-for="Description"></label>
               <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="card-content ">
                <div class="nav-align-top nav-tabs mb-6">
                    <ul class="nav nav-tabs nav-fill" role="tablist">
                        <li class="nav-item">
                        <button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-justified-profile" aria-controls="navs-justified-profile" aria-selected="false"><span class="d-none d-sm-block"><i class="tf-icons bx bx-group bx-sm me-1_5 align-text-bottom"></i> Пользователи</span><i class="bx bx-user bx-sm d-sm-none"></i></button>
                    </li>
                        <li class="nav-item">
                        <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-justified-home" aria-controls="navs-justified-home" aria-selected="true"><span class="d-none d-sm-block"><i class="tf-icons bx bx-unlink bx-sm me-1_5 align-text-bottom"></i> Связи </span><i class="bx bx-unlink bx-sm d-sm-none"></i></button>
                    </li>
       
                    <li class="nav-item">
                        <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-justified-messages" aria-controls="navs-justified-messages" aria-selected="false"><span class="d-none d-sm-block"><i class="tf-icons bx bx-bell bx-sm me-1_5 align-text-bottom"></i> Уведомления</span><i class="bx bx-bell bx-sm d-sm-none"></i></button>
                    </li>
                    </ul>
                    <div class="tab-content">
                    <div class="tab-pane fade show active" id="navs-justified-profile" role="tabpanel">
                        @*Пользователи*@
                        <!-- Кнопка добавить пользователя -->
                            <button type="button" id="addUserBtn" class="btn btn-primary mb-2">Добавить пользователя</button>

                            <table class="table table-bordered" id="membersTable">
                                <thead>
                                    <tr>
                                        <th>Имя пользователя</th>
                                        <th>Email</th>
                                        <th>Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model?.Members?.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                <input type="hidden" asp-for="Members[@i].UserId" />
                                                <input asp-for="Members[@i].User?.UserName" class="form-control" readonly />
                                            </td>
                                            <td>
                                                <input asp-for="Members[@i].User?.Email" class="form-control" readonly />
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-danger remove-member-btn">Удалить</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                    </div>
                    <div class="tab-pane fade" id="navs-justified-home" role="tabpanel">
         
                    </div>
                    <div class="tab-pane fade" id="navs-justified-messages" role="tabpanel">
                        <div class="card-body">
                            <div class="form-check form-switch mb-2">
                                <label class="form-check-label" for="flexSwitchCheckDefault1">Включить емейл рассылки</label>
                                <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault1">
                            </div>
                            <div class="form-check form-switch mb-2">
                                <label class="form-check-label" for="flexSwitchCheckDefault2">Включить уведомления</label>
                                <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault2">
                            </div>
                        </div>
                    </div>
                    </div>
                </div>
             </div>
        </form>
    </div>

    
</div>

<script src="~/js/form-change-tracker.js"></script>
<script>
    enableSaveOnChange("#userGroupCreateForm", "#btnSave");
</script>