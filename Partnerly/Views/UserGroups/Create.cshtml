@model Partnerly.Models.ViewModels.UserGroupViewModel;
@await Html.PartialAsync("_Toast")

@{
    ViewData["Title"] = "Create a group";
    Layout = "_ContentNavbarLayout";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5>@Localizer["Createagroup"]</h5>
    </div>

    <div class="card-body">
        <form id="userGroupCreateForm" asp-action="Create">
            <input type="hidden" id="MembersGuids" name="MembersGuids" />

             @await Html.PartialAsync("_StickyButtons", new Partnerly.Models.ViewModels.FormActionsViewModel {
                Back = new Partnerly.Models.ViewModels.ActionBack(visible: true, fromController: "UserGroups", toController: "UserGroups", fromAction: "Create", toAction: "Index"),
                Undo = new Partnerly.Models.ViewModels.ActionUndo(visible: true, fromController: "UserGroups", toController: "UserGroups", fromAction: "Create", toAction: "Create"),
                Save = new Partnerly.Models.ViewModels.ActionSave(visible: true, fromController: "UserGroups", toController: "UserGroups", fromAction: "Create", toAction: "Create"),
            })

            <div class="form-floating mb-1 max-w-400 position-relative">
                <input asp-for="Name"
                       id="name"
                       name="name"
                       type="text"
                       class="form-control lookup-input pe-5"
                       placeholder=" "
                       data-lookup="true"
                       data-lookup-source="/UserGroups/GetLookupList"
                       data-lookup-title=@Localizer["Groups"]
                       data-edit-url-base="/UserGroups/Edit/"
                       data-lookup-column-names="name:@Localizer["Name"],description:@Localizer["Description"]"
                       data-lookup-display-field="Name"
                       data-lookup-param="fieldName"
                       data-lookup-param-value="Name"/>
                <label asp-for="Name"></label>
                <i class='bx bx-search lookup-icon'></i>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-floating mb-10 max-w-600">
               <input asp-for="Description" class="form-control" id="description" name="description" placeholder=""/>
                <label asp-for="Description"></label>
               <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </form>
    </div>
</div>

<script src="~/assets/js/form-change-tracker.js"></script>
<script>
    enableSaveOnChange("#userGroupCreateForm", "#btnSave");
</script>

@section PageScripts {
}


