@model Partnerly.Models.ViewModels.UserGroupViewModel;
@await Html.PartialAsync("_Toast")

@{
    ViewData["Title"] = "Delete group";
    Layout = "_ContentNavbarLayout";
}

@await Html.PartialAsync(
"_DeleteConfirmation",
    new Partnerly.Models.ViewModels.DeleteConfirmationViewModel
    {
        Id = Model.Id,
        Title = Localizer["Deletegroup"],
        Message = Localizer["Areyousureyouwanttodeletethisfile"],
        DeleteAction = "DeleteConfirmed",
        DeleteController = "UserGroups",
        CancelAction = "Index",
        CancelController = "UserGroups"
    })