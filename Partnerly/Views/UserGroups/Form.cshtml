@model Partnerly.Models.ViewModels.UserGroupViewModel
@await Html.PartialAsync("_Toast")

@{
    bool isEdit = Model.Id != Guid.Empty;

    ViewData["Title"] = Model.Title;
    Layout = "_ContentNavbarLayout";
}


<style>

    /* =========================================================
           USER GROUP TABS
           ========================================================= */
    .user-group-tabs {
        width: 100%;
        min-width: 0;
    }

        /* Navigation */

        .user-group-tabs > .nav-tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            margin-bottom: 0;
            padding: 0 12px;
            border-bottom: 1px solid #eeeeef;
        }

            .user-group-tabs > .nav-tabs .nav-item {
                margin-bottom: -1px;
            }

            .user-group-tabs > .nav-tabs .nav-link {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 9px;
                min-height: 48px;
                padding: 13px 18px;
                border: 0;
                border-bottom: 2px solid transparent;
                border-radius: 0;
                background: transparent;
                color: #697a8d;
                font-size: 13px;
                font-weight: 500;
                transition: color .2s ease, background .2s ease;
            }

                .user-group-tabs > .nav-tabs .nav-link i {
                    font-size: 19px;
                }

                .user-group-tabs > .nav-tabs .nav-link:hover {
                    color: #696cff;
                    background: rgba(105, 108, 255, .04);
                }

                .user-group-tabs > .nav-tabs .nav-link.active {
                    color: #696cff;
                    background: transparent;
                    border-bottom-color: #696cff;
                    font-weight: 600;
                }

    /* Content */

    .user-group-tab-content {
        min-width: 0;
        padding: 0;
    }

    .user-group-tab-body {
        min-width: 0;
        padding: 22px 20px;
    }

    /* Responsive */

    @@media (max-width: 576px) {
        .user-group-tabs > .nav-tabs {
            padding: 0 8px;
        }

            .user-group-tabs > .nav-tabs .nav-link {
                gap: 6px;
                min-height: 44px;
                padding: 11px 10px;
                font-size: 12px;
            }

                .user-group-tabs > .nav-tabs .nav-link i {
                    font-size: 17px;
                }

        .user-group-tab-body {
            padding: 14px 10px;
        }
    }

    /* =========================================================
           PARTNERLY — USER GROUP TABS DARK THEME
           Append at the end of the existing <style>
           ========================================================= */

    html[data-theme="dark"] .user-group-tabs {
        color: var(--partnerly-text, #c5cee0);
    }

        /* Tabs navigation */

        html[data-theme="dark"] .user-group-tabs > .nav-tabs {
            border-bottom-color: var(--partnerly-border, #29344a);
        }

            html[data-theme="dark"] .user-group-tabs > .nav-tabs .nav-link {
                color: var(--partnerly-muted, #8996b0);
                background: transparent;
                border-bottom-color: transparent;
            }

                html[data-theme="dark"] .user-group-tabs > .nav-tabs .nav-link i {
                    color: inherit;
                    transition: color 0.2s ease, filter 0.2s ease;
                }

                html[data-theme="dark"] .user-group-tabs > .nav-tabs .nav-link:hover {
                    color: var(--partnerly-primary, #8185ff);
                    background: rgba(105, 108, 255, 0.07);
                }

                    html[data-theme="dark"] .user-group-tabs > .nav-tabs .nav-link:hover i {
                        filter: drop-shadow(0 0 5px rgba(105, 108, 255, 0.25));
                    }

                html[data-theme="dark"] .user-group-tabs > .nav-tabs .nav-link.active {
                    color: var(--partnerly-primary, #8185ff);
                    background: linear-gradient( to bottom, rgba(105, 108, 255, 0.07), transparent );
                    border-bottom: 2px solid var(--partnerly-primary, #8185ff);
                    box-shadow: 0 4px 12px -9px rgba(105, 108, 255, 0.8);
                }

                    html[data-theme="dark"] .user-group-tabs > .nav-tabs .nav-link.active i {
                        color: var(--partnerly-primary, #8185ff);
                        filter: drop-shadow(0 0 5px rgba(105, 108, 255, 0.3));
                    }

                /* Keyboard accessibility */

                html[data-theme="dark"] .user-group-tabs > .nav-tabs .nav-link:focus-visible {
                    outline: 2px solid var(--partnerly-primary, #8185ff);
                    outline-offset: -3px;
                    border-radius: 5px;
                }

    /* Tab content */

    html[data-theme="dark"] .user-group-tab-content {
        color: var(--partnerly-text, #c5cee0);
    }

    html[data-theme="dark"] .user-group-tab-body {
        color: var(--partnerly-text, #c5cee0);
    }

    /* Parent card */

    html[data-theme="dark"] .card:has(.user-group-tabs) {
        background: var(--partnerly-background, #151c2c);
        border-color: var(--partnerly-border, #29344a);
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.16);
    }

        html[data-theme="dark"] .card:has(.user-group-tabs) > .card-header {
            background: linear-gradient( 110deg, rgba(105, 108, 255, 0.07), transparent 70% );
            border-bottom-color: var(--partnerly-border, #29344a);
            color: var(--partnerly-text-dark, #edf2ff);
        }

            html[data-theme="dark"] .card:has(.user-group-tabs) > .card-header h5 {
                color: var(--partnerly-text-dark, #edf2ff);
            }

        html[data-theme="dark"] .card:has(.user-group-tabs) > .card-body {
            background: transparent;
            color: var(--partnerly-text, #c5cee0);
        }

        /* Form fields */

        html[data-theme="dark"] .card:has(.user-group-tabs) .form-floating > .form-control {
            background-color: var(--partnerly-control-background, #111a2b);
            border-color: var(--partnerly-border, #29344a);
            color: var(--partnerly-text-dark, #edf2ff);
        }

            html[data-theme="dark"] .card:has(.user-group-tabs) .form-floating > .form-control:focus {
                border-color: var(--partnerly-primary, #8185ff);
                box-shadow: 0 0 0 3px rgba(105, 108, 255, 0.1);
            }

        html[data-theme="dark"] .card:has(.user-group-tabs) .form-floating > label {
            color: var(--partnerly-muted, #8996b0);
        }

        html[data-theme="dark"] .card:has(.user-group-tabs) .lookup-icon {
            color: var(--partnerly-primary, #8185ff);
        }

    /* Responsive */

    @@media (max-width: 576px) {
        html [data-theme="dark"] .user-group-tabs > .nav-tabs {
            gap: 2px;
            padding-right: 8px;
            padding-left: 8px;
        }

            html[data-theme="dark"] .user-group-tabs > .nav-tabs .nav-link {
                padding-right: 10px;
                padding-left: 10px;
            }

        html[data-theme="dark"] .user-group-tab-body {
            padding: 14px 10px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        html [data-theme="dark"] .user-group-tabs > .nav-tabs .nav-link, html[data-theme="dark"] .user-group-tabs > .nav-tabs .nav-link i {
            transition: none;
        }
    }

</style>

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="mb-0">
            @(isEdit
                        ? Localizer["Editgroup"]
                        : Localizer["Createagroup"])
        </h5>

        @if (isEdit)
        {
            @await Html.PartialAsync("_AuditInfo", Model)
        }
    </div>

    <div class="card-body">
        <form id="userGroupForm"
              asp-action="@(isEdit ? "Edit" : "Create")"
              method="post">

            @await Html.PartialAsync("_StickyButtons", Model.StickyButtons)

            @if (isEdit)
            {
                <input type="hidden"
                       name="GroupID"
                       value="@Model.Id"
                       data-parent-key="GroupID" />

                <input type="hidden" asp-for="Note" />
            }

            <div class="form-floating mb-1 max-w-400 position-relative">
                <input asp-for="Name"
                       id="name"
                       class="form-control lookup-input pe-5"
                       placeholder=" "
                       data-lookup="true"
                       data-lookup-source="/UserGroups/GetLookupList"
                       data-lookup-title="@Localizer["Groups"]"
                       data-edit-url-base="/UserGroups/Edit/"
                       data-lookup-column-names="name:@Localizer["Name"],description:@Localizer["Description"]"
                       data-lookup-display-field="Name"
                       data-lookup-param="fieldName"
                       data-lookup-param-value="Name" />

                <label asp-for="Name"></label>

                <i class="bx bx-search lookup-icon"></i>

                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="form-floating mb-1 max-w-600">
                <input asp-for="Description"
                       id="description"
                       class="form-control"
                       placeholder=" " />

                <label asp-for="Description"></label>

                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            @if (isEdit)
            {
                <div class="user-group-tabs mt-4">
                    <ul class="nav nav-tabs"
                        id="userGroupTabs"
                        role="tablist">

                        <li class="nav-item" role="presentation">
                            <button class="nav-link active"
                                    id="users-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#users-tab-pane"
                                    type="button"
                                    role="tab"
                                    aria-controls="users-tab-pane"
                                    aria-selected="true">
                                <i class="bx bx-group"></i>
                                <span>@Localizer["Users"]</span>
                            </button>
                        </li>

                        <li class="nav-item" role="presentation">
                            <button class="nav-link"
                                    id="connections-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#connections-tab-pane"
                                    type="button"
                                    role="tab"
                                    aria-controls="connections-tab-pane"
                                    aria-selected="false">
                                <i class="bx bx-unlink"></i>
                                <span>@Localizer["Connections"]</span>
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content user-group-tab-content"
                         id="userGroupTabContent">

                        <div class="tab-pane fade show active"
                             id="users-tab-pane"
                             role="tabpanel"
                             aria-labelledby="users-tab"
                             tabindex="0">

                            <div class="user-group-tab-body">
                                @await Html.PartialAsync(
                                "~/Views/Shared/DataTable/_DataTable.cshtml",
                                                        Model.groupMembers)
                        </div>
                    </div>

                    <div class="tab-pane fade"
                         id="connections-tab-pane"
                         role="tabpanel"
                         aria-labelledby="connections-tab"
                         tabindex="0">

                        <div class="user-group-tab-body">
                            @* Connections content will be added here. *@
                        </div>
                    </div>
                </div>
                </div>
            }
        </form>
    </div>
</div>

@if (isEdit)
{
    <div class="modal fade"
         id="sendGroupMessageModal"
         tabindex="-1"
         aria-labelledby="sendGroupMessageModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-3 shadow-lg">
                <div class="modal-header py-2">
                    <h6 class="modal-title" id="sendGroupMessageModalLabel">
                        <span class="note-modal-icon">
                            <i class="bx bx-bell" id="sendGroupMessageIcon"></i>
                        </span>
                        <span id="sendGroupMessageTitle">@Localizer["Sendnotification"]</span>
                    </h6>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="@Localizer["Close"]">
                    </button>
                </div>

                <div class="modal-body py-2">
                    <p class="send-group-recipients" id="sendGroupRecipients">
                        @Localizer["Selectatleastoneuser"]
                    </p>

                    <div class="form-floating mb-3 d-none" id="sendGroupSubjectWrap">
                        <input type="text"
                               class="form-control"
                               id="sendGroupSubject"
                               maxlength="200" />
                        <label for="sendGroupSubject">@Localizer["Subject"]</label>
                    </div>

                    <div class="form-floating">
                        <textarea class="form-control"
                                  id="sendGroupMessage"></textarea>
                        <label for="sendGroupMessage">@Localizer["Message"]</label>
                    </div>
                </div>

                <div class="modal-footer py-2">
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            data-bs-dismiss="modal">
                        @Localizer["Cancel"]
                    </button>
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            id="sendGroupMessageBtn">
                        @Localizer["Send"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<script src="~/assets/js/form-change-tracker.js"></script>

<script>
    enableSaveOnChange("#userGroupForm", "#btnSave");
</script>

@if (isEdit)
{
    <script>
        (function () {
            const tableId = @Html.Raw(Json.Serialize(Partnerly.Models.DataTable.DataTableNames.userGroupsMembersTable));
            const groupId = @Html.Raw(Json.Serialize(Model.Id.ToString()));
            const labels = {
                notificationTitle: @Html.Raw(Json.Serialize(Localizer["Sendnotification"].Value)),
                emailTitle: @Html.Raw(Json.Serialize(Localizer["Sendanemail"].Value)),
                recipients: @Html.Raw(Json.Serialize(Localizer["Selectedusers"].Value)),
                selectUsers: @Html.Raw(Json.Serialize(Localizer["Selectatleastoneuser"].Value)),
                required: @Html.Raw(Json.Serialize(Localizer["FieldRequired"].Value))
            };

            let sendMode = "notification";

            function addSelectedId(ids, seen, value) {
                const id = String(value || "").trim();
                if (!id || seen[id]) {
                    return;
                }
                seen[id] = true;
                ids.push(id);
            }

            function getSelectedUserIds() {
                const table = document.getElementById(tableId);
                const ids = [];
                const seen = {};
                const ctx = (table && table._partnerlyDataTable)
                    || (window.PartnerlyDataTables && window.PartnerlyDataTables[tableId]);

                if (ctx && ctx.state && Array.isArray(ctx.state.selectedRows)) {
                    ctx.state.selectedRows.forEach(function (id) {
                        addSelectedId(ids, seen, id);
                    });
                }

                if (table) {
                    table.querySelectorAll(".data-table-row-select:checked, .data-table-boolean:checked").forEach(function (checkbox) {
                        addSelectedId(ids, seen, checkbox.getAttribute("data-row-id"));

                        const row = checkbox.closest("tr");
                        if (!row) {
                            return;
                        }

                        try {
                            const keys = JSON.parse(row.getAttribute("data-row-keys") || "{}");
                            addSelectedId(ids, seen, keys.UserId || keys.userId);
                        } catch (error) {
                            /* ignore malformed keys */
                        }
                    });
                }

                return ids;
            }

            function getAntiForgeryToken() {
                const input = document.querySelector('input[name="__RequestVerificationToken"]');
                return input ? input.value : "";
            }

            function showClientToast(message, isError) {
                const existing = document.getElementById("groupSendToast");
                if (existing) {
                    existing.remove();
                }

                const container = document.createElement("div");
                container.className = "toast-container position-fixed bottom-0 end-0 p-3";
                container.innerHTML =
                    '<div id="groupSendToast" class="toast align-items-center ' +
                    (isError ? "text-bg-danger" : "text-bg-primary") +
                    ' border-0" role="alert" aria-live="assertive" aria-atomic="true">' +
                    '<div class="d-flex"><div class="toast-body"></div>' +
                    '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>';

                document.body.appendChild(container);
                container.querySelector(".toast-body").textContent = message;

                const toastEl = document.getElementById("groupSendToast");
                const toast = new bootstrap.Toast(toastEl, { delay: 3500 });
                toastEl.addEventListener("hidden.bs.toast", function () {
                    container.remove();
                });
                toast.show();
            }

            window.prepareGroupSend = function (mode) {
                sendMode = mode === "email" ? "email" : "notification";

                const title = document.getElementById("sendGroupMessageTitle");
                const icon = document.getElementById("sendGroupMessageIcon");
                const subjectWrap = document.getElementById("sendGroupSubjectWrap");
                const recipients = document.getElementById("sendGroupRecipients");
                const selected = getSelectedUserIds();

                if (title) {
                    title.textContent = sendMode === "email"
                        ? labels.emailTitle
                        : labels.notificationTitle;
                }

                if (icon) {
                    icon.className = sendMode === "email"
                        ? "bx bx-envelope-open"
                        : "bx bx-bell";
                }

                if (subjectWrap) {
                    subjectWrap.classList.toggle("d-none", sendMode !== "email");
                }

                if (recipients) {
                    recipients.textContent = selected.length === 0
                        ? labels.selectUsers
                        : labels.recipients.replace("{0}", String(selected.length));
                }
            };

            document.addEventListener("DOMContentLoaded", function () {
                const sendBtn = document.getElementById("sendGroupMessageBtn");
                const modal = document.getElementById("sendGroupMessageModal");

                if (modal) {
                    document.body.appendChild(modal);
                    modal.addEventListener("show.bs.modal", function () {
                        prepareGroupSend(sendMode);
                    });
                }

                if (!sendBtn) {
                    return;
                }

                sendBtn.addEventListener("click", async function (event) {
                    event.preventDefault();

                    const userIds = getSelectedUserIds();
                    if (userIds.length === 0) {
                        showClientToast(labels.selectUsers, true);
                        return;
                    }

                    const messageEl = document.getElementById("sendGroupMessage");
                    const subjectEl = document.getElementById("sendGroupSubject");
                    const message = messageEl ? messageEl.value.trim() : "";
                    const subject = subjectEl ? subjectEl.value.trim() : "";

                    if (!message || (sendMode === "email" && !subject)) {
                        showClientToast(labels.required, true);
                        return;
                    }

                    sendBtn.disabled = true;

                    try {
                        const url = sendMode === "email"
                            ? "@Url.Action("SendEmail", "UserGroups")"
                            : "@Url.Action("SendNotification", "UserGroups")";

                        const response = await fetch(url, {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken": getAntiForgeryToken()
                            },
                            body: JSON.stringify({
                                groupId: groupId,
                                userIds: userIds,
                                subject: subject,
                                message: message
                            })
                        });

                        const result = await response.json().catch(function () { return null; });
                        const text = result && result.message
                            ? result.message
                            : labels.required;

                        showClientToast(text, !response.ok || !(result && result.success));

                        if (response.ok && result && result.success) {
                            const instance = bootstrap.Modal.getInstance(modal);
                            if (instance) {
                                instance.hide();
                            }

                            if (messageEl) {
                                messageEl.value = "";
                            }
                            if (subjectEl) {
                                subjectEl.value = "";
                            }
                        }
                    } catch (error) {
                        console.error(error);
                        showClientToast(labels.required, true);
                    } finally {
                        sendBtn.disabled = false;
                    }
                });
            });
        })();
    </script>
}