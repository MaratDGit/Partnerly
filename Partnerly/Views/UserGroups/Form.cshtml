@model Partnerly.Models.ViewModels.UserGroupViewModel
@await Html.PartialAsync("_Toast")

@{
    bool isEdit = Model.Id != Guid.Empty;

    ViewData["Title"] = Model.Title;
    Layout = "_ContentNavbarLayout";
}


<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="mb-0">
            @(isEdit
                        ? Localizer["Editgroup"]
                        : Localizer["Createagroup"])
        </h5>

        @if (isEdit)
        {
            @await Html.PartialAsync("_AuditInfo", Model)
        }
    </div>

    <div class="card-body">
        <form id="userGroupForm"
              asp-action="@(isEdit ? "Edit" : "Create")"
              method="post">

            @await Html.PartialAsync("_StickyButtons", Model.StickyButtons)

            @if (isEdit)
            {
                <input type="hidden"
                       name="GroupID"
                       value="@Model.Id"
                       data-parent-key="GroupID" />

                <input type="hidden" asp-for="Note" />
            }

            <div class="form-floating mb-1 max-w-400 position-relative">
                <input asp-for="Name"
                       id="name"
                       class="form-control lookup-input pe-5"
                       placeholder=" "
                       data-lookup="true"
                       data-lookup-source="/UserGroups/GetLookupList"
                       data-lookup-title="@Localizer["Groups"]"
                       data-edit-url-base="/UserGroups/Edit/"
                       data-lookup-column-names="name:@Localizer["Name"],description:@Localizer["Description"]"
                       data-lookup-display-field="Name"
                       data-lookup-param="fieldName"
                       data-lookup-param-value="Name" />

                <label asp-for="Name"></label>

                <i class="bx bx-search lookup-icon"></i>

                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="form-floating mb-1 max-w-600">
                <input asp-for="Description"
                       id="description"
                       class="form-control"
                       placeholder=" " />

                <label asp-for="Description"></label>

                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            @if (isEdit)
            {
                <partnerly-tabs id="userGroupTabs" class="mt-4">
                    <partnerly-tab id="users"
                                   icon="bx bx-group"
                                   title="@Localizer["Users"]"
                                   active="true">
                        @await Html.PartialAsync(
                            "~/Views/Shared/DataTable/_DataTable.cshtml",
                            Model.groupMembers)
                    </partnerly-tab>
                    <partnerly-tab id="connections"
                                   icon="bx bx-unlink"
                                   title="@Localizer["Connections"]">
                        @* Connections content will be added here. *@
                    </partnerly-tab>
                </partnerly-tabs>
            }
        </form>
    </div>
</div>

@if (isEdit)
{
    <div class="modal fade"
         id="sendGroupMessageModal"
         tabindex="-1"
         aria-labelledby="sendGroupMessageModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-3 shadow-lg">
                <div class="modal-header py-2">
                    <h6 class="modal-title" id="sendGroupMessageModalLabel">
                        <span class="note-modal-icon">
                            <i class="bx bx-bell" id="sendGroupMessageIcon"></i>
                        </span>
                        <span id="sendGroupMessageTitle">@Localizer["Sendnotification"]</span>
                    </h6>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="@Localizer["Close"]">
                    </button>
                </div>

                <div class="modal-body py-2">
                    <p class="send-group-recipients" id="sendGroupRecipients">
                        @Localizer["Selectatleastoneuser"]
                    </p>

                    <div class="mb-3 d-none" id="sendGroupTemplateWrap">
                        <label class="form-label small mb-1" for="sendGroupTemplate">@Localizer["EmailTemplate"]</label>
                        <select class="form-select form-select-sm" id="sendGroupTemplate">
                            <option value="">@Localizer["Notemplate"]</option>
                        </select>
                        <div class="small text-muted mt-1 d-none" id="sendGroupTemplateInfo">
                            <i class="bx bx-paperclip"></i>
                            @Localizer["Attachments"]: <span id="sendGroupTemplateAttachments">0</span>
                        </div>
                    </div>

                    <div class="form-floating mb-3 d-none" id="sendGroupSubjectWrap">
                        <input type="text"
                               class="form-control"
                               id="sendGroupSubject"
                               maxlength="200" />
                        <label for="sendGroupSubject">@Localizer["Subject"]</label>
                    </div>

                    <div class="form-floating">
                        <textarea class="form-control"
                                  id="sendGroupMessage"></textarea>
                        <label for="sendGroupMessage">@Localizer["Message"]</label>
                    </div>
                </div>

                <div class="modal-footer py-2">
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            data-bs-dismiss="modal">
                        @Localizer["Cancel"]
                    </button>
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            id="sendGroupMessageBtn">
                        @Localizer["Send"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<script src="~/assets/js/form-change-tracker.js"></script>

<script>
    enableSaveOnChange("#userGroupForm", "#btnSave");
</script>

@if (isEdit)
{
    <script>
        (function () {
            const tableId = @Html.Raw(Json.Serialize(Partnerly.Models.DataTable.DataTableNames.userGroupsMembersTable));
            const groupId = @Html.Raw(Json.Serialize(Model.Id.ToString()));
            const labels = {
                notificationTitle: @Html.Raw(Json.Serialize(Localizer["Sendnotification"].Value)),
                emailTitle: @Html.Raw(Json.Serialize(Localizer["Sendanemail"].Value)),
                recipients: @Html.Raw(Json.Serialize(Localizer["Selectedusers"].Value)),
                selectUsers: @Html.Raw(Json.Serialize(Localizer["Selectatleastoneuser"].Value)),
                required: @Html.Raw(Json.Serialize(Localizer["FieldRequired"].Value)),
                sending: @Html.Raw(Json.Serialize(Localizer["Sending"].Value))
            };
            const templatesUrl = "@Url.Action("EmailTemplates", "UserGroups")";
            let templates = null;

            let sendMode = "notification";

            function addSelectedId(ids, seen, value) {
                const id = String(value || "").trim();
                if (!id || seen[id]) {
                    return;
                }
                seen[id] = true;
                ids.push(id);
            }

            function getSelectedUserIds() {
                const table = document.getElementById(tableId);
                const ids = [];
                const seen = {};
                const ctx = (table && table._partnerlyDataTable)
                    || (window.PartnerlyDataTables && window.PartnerlyDataTables[tableId]);

                if (ctx && ctx.state && Array.isArray(ctx.state.selectedRows)) {
                    ctx.state.selectedRows.forEach(function (id) {
                        addSelectedId(ids, seen, id);
                    });
                }

                if (table) {
                    table.querySelectorAll(".data-table-row-select:checked, .data-table-boolean:checked").forEach(function (checkbox) {
                        addSelectedId(ids, seen, checkbox.getAttribute("data-row-id"));

                        const row = checkbox.closest("tr");
                        if (!row) {
                            return;
                        }

                        try {
                            const keys = JSON.parse(row.getAttribute("data-row-keys") || "{}");
                            addSelectedId(ids, seen, keys.UserId || keys.userId);
                        } catch (error) {
                            /* ignore malformed keys */
                        }
                    });
                }

                return ids;
            }

            function getAntiForgeryToken() {
                const input = document.querySelector('input[name="__RequestVerificationToken"]');
                return input ? input.value : "";
            }

            function showClientToast(message, isError) {
                const existing = document.getElementById("groupSendToast");
                if (existing) {
                    existing.remove();
                }

                const container = document.createElement("div");
                container.className = "toast-container position-fixed bottom-0 end-0 p-3";
                container.innerHTML =
                    '<div id="groupSendToast" class="toast align-items-center ' +
                    (isError ? "text-bg-danger" : "text-bg-primary") +
                    ' border-0" role="alert" aria-live="assertive" aria-atomic="true">' +
                    '<div class="d-flex"><div class="toast-body"></div>' +
                    '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>';

                document.body.appendChild(container);
                container.querySelector(".toast-body").textContent = message;

                const toastEl = document.getElementById("groupSendToast");
                const toast = new bootstrap.Toast(toastEl, { delay: 3500 });
                toastEl.addEventListener("hidden.bs.toast", function () {
                    container.remove();
                });
                toast.show();
            }

            function htmlToText(html) {
                const doc = new DOMParser().parseFromString(html || "", "text/html");
                doc.querySelectorAll("style,script").forEach(function (el) { el.remove(); });
                return (doc.body.textContent || "").replace(/\n{3,}/g, "\n\n").trim();
            }

            function currentTemplate() {
                const select = document.getElementById("sendGroupTemplate");
                if (!select || !select.value || !templates) {
                    return null;
                }
                return templates.find(function (t) { return t.id === select.value; }) || null;
            }

            function applyTemplate() {
                const t = currentTemplate();
                const subjectEl = document.getElementById("sendGroupSubject");
                const messageEl = document.getElementById("sendGroupMessage");
                const info = document.getElementById("sendGroupTemplateInfo");
                const count = document.getElementById("sendGroupTemplateAttachments");

                if (subjectEl) {
                    subjectEl.readOnly = !!t;
                    if (t) { subjectEl.value = t.subject || ""; }
                }
                if (messageEl) {
                    messageEl.readOnly = !!t;
                    if (t) { messageEl.value = htmlToText(t.body); }
                }
                if (info) {
                    info.classList.toggle("d-none", !t);
                }
                if (count) {
                    count.textContent = t ? String(t.attachments) : "0";
                }
            }

            async function loadTemplates() {
                if (templates) {
                    return;
                }
                const select = document.getElementById("sendGroupTemplate");
                try {
                    const response = await fetch(templatesUrl, { credentials: "same-origin" });
                    templates = response.ok ? await response.json() : [];
                } catch (error) {
                    templates = [];
                }
                templates.forEach(function (t) {
                    const option = document.createElement("option");
                    option.value = t.id;
                    option.textContent = t.name;
                    select.appendChild(option);
                });
            }

            window.prepareGroupSend = function (mode) {
                sendMode = mode === "email" ? "email" : "notification";

                const title = document.getElementById("sendGroupMessageTitle");
                const icon = document.getElementById("sendGroupMessageIcon");
                const subjectWrap = document.getElementById("sendGroupSubjectWrap");
                const recipients = document.getElementById("sendGroupRecipients");
                const selected = getSelectedUserIds();

                if (title) {
                    title.textContent = sendMode === "email"
                        ? labels.emailTitle
                        : labels.notificationTitle;
                }

                if (icon) {
                    icon.className = sendMode === "email"
                        ? "bx bx-envelope-open"
                        : "bx bx-bell";
                }

                if (subjectWrap) {
                    subjectWrap.classList.toggle("d-none", sendMode !== "email");
                }

                const templateWrap = document.getElementById("sendGroupTemplateWrap");
                if (templateWrap) {
                    templateWrap.classList.toggle("d-none", sendMode !== "email");
                }
                if (sendMode === "email") {
                    loadTemplates();
                } else {
                    const select = document.getElementById("sendGroupTemplate");
                    if (select) { select.value = ""; }
                    applyTemplate();
                }

                if (recipients) {
                    recipients.textContent = selected.length === 0
                        ? labels.selectUsers
                        : labels.recipients.replace("{0}", String(selected.length));
                }
            };

            document.addEventListener("DOMContentLoaded", function () {
                const sendBtn = document.getElementById("sendGroupMessageBtn");
                const modal = document.getElementById("sendGroupMessageModal");

                const templateSelect = document.getElementById("sendGroupTemplate");
                if (templateSelect) {
                    templateSelect.addEventListener("change", applyTemplate);
                }

                if (modal) {
                    document.body.appendChild(modal);
                    modal.addEventListener("show.bs.modal", function () {
                        prepareGroupSend(sendMode);
                    });
                }

                if (!sendBtn) {
                    return;
                }

                sendBtn.addEventListener("click", async function (event) {
                    event.preventDefault();

                    const userIds = getSelectedUserIds();
                    if (userIds.length === 0) {
                        showClientToast(labels.selectUsers, true);
                        return;
                    }

                    const messageEl = document.getElementById("sendGroupMessage");
                    const subjectEl = document.getElementById("sendGroupSubject");
                    const message = messageEl ? messageEl.value.trim() : "";
                    const subject = subjectEl ? subjectEl.value.trim() : "";
                    const template = sendMode === "email" ? currentTemplate() : null;

                    if (!template && (!message || (sendMode === "email" && !subject))) {
                        showClientToast(labels.required, true);
                        return;
                    }

                    const originalBtnHtml = sendBtn.innerHTML;
                    const lockEls = modal.querySelectorAll("input, textarea, select, .btn-close, [data-bs-dismiss=modal]");
                    sendBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>' +
                        '<span class="send-group-sending"></span>';
                    sendBtn.querySelector(".send-group-sending").textContent = labels.sending;
                    sendBtn.disabled = true;
                    lockEls.forEach(function (el) { el.disabled = true; });
                    const modalInstance = bootstrap.Modal.getInstance(modal);
                    if (modalInstance && modalInstance._config) {
                        modalInstance._config.backdrop = "static";
                        modalInstance._config.keyboard = false;
                    }

                    try {
                        const url = sendMode === "email"
                            ? "@Url.Action("SendEmail", "UserGroups")"
                            : "@Url.Action("SendNotification", "UserGroups")";

                        const response = await fetch(url, {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken": getAntiForgeryToken()
                            },
                            body: JSON.stringify({
                                groupId: groupId,
                                userIds: userIds,
                                subject: subject,
                                message: message,
                                templateId: template ? template.id : null
                            })
                        });

                        const result = await response.json().catch(function () { return null; });
                        const text = result && result.message
                            ? result.message
                            : labels.required;

                        showClientToast(text, !response.ok || !(result && result.success));

                        if (response.ok && result && result.success) {
                            const instance = bootstrap.Modal.getInstance(modal);
                            if (instance) {
                                instance.hide();
                            }

                            if (templateSelect) {
                                templateSelect.value = "";
                            }
                            applyTemplate();
                            if (messageEl) {
                                messageEl.value = "";
                            }
                            if (subjectEl) {
                                subjectEl.value = "";
                            }
                        }
                    } catch (error) {
                        console.error(error);
                        showClientToast(labels.required, true);
                    } finally {
                        lockEls.forEach(function (el) { el.disabled = false; });
                        sendBtn.disabled = false;
                        sendBtn.innerHTML = originalBtnHtml;
                        const inst = bootstrap.Modal.getInstance(modal);
                        if (inst && inst._config) {
                            inst._config.backdrop = true;
                            inst._config.keyboard = true;
                        }
                    }
                });
            });
        })();
    </script>
}