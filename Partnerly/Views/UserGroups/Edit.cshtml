@model Partnerly.Models.ViewModels.UserGroupViewModel;
@await Html.PartialAsync("_Toast")

@{
    ViewData["Title"] = "Редактировать группу";
    Layout = "_ContentNavbarLayout";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5>@ViewData["Title"]</h5>
    </div>

    <div class="card-body">
        <form id="userGroupEditForm" asp-action="Edit">

             @await Html.PartialAsync("_StickyButtons", new Partnerly.Models.ViewModels.FormActionsViewModel {
                Back = new Partnerly.Models.ViewModels.ActionBack(id: Model.Id,visible: true, fromController: "UserGroups", toController: "UserGroups", fromAction: "Edit", toAction: "Index"),
                Undo = new Partnerly.Models.ViewModels.ActionUndo(id: Model.Id, visible: true, fromController: "UserGroups", toController: "UserGroups", fromAction: "Edit", toAction: "Edit"),
                Save = new Partnerly.Models.ViewModels.ActionSave(id: Model.Id, visible: true, fromController: "UserGroups", toController: "UserGroups", fromAction: "Edit", toAction: "Edit"),
                Create = new Partnerly.Models.ViewModels.ActionCreate(id: Model.Id, visible: true, fromController: "UserGroups", toController: "UserGroups", fromAction: "Edit", toAction: "Create"),
                Delete = new Partnerly.Models.ViewModels.ActionDelete(id: Model.Id, visible: true, fromController: "UserGroups", toController: "UserGroups", fromAction: "Edit", toAction: "Delete"),
                Menu = new Partnerly.Models.ViewModels.ActionMenu(visible: true),
                MenuActions = new List<Partnerly.Models.ViewModels.MenuItemAction> {
                    new Partnerly.Models.ViewModels.MenuItemAction(visible: true, icon: "bx bx-bell", displayName: "Отправить уведомление"),
                    new Partnerly.Models.ViewModels.MenuItemAction(visible: true, icon: "bx bx-envelope-open", displayName: "Отправить электронное письмо"),
                }
            })

            <div class="form-floating mb-1 max-w-600 position-relative">
                <input asp-for="Name"
                       id="name"
                       name="name"
                       type="text"
                       class="form-control lookup-input pe-5"
                       placeholder=" "
                       data-lookup="true"
                       data-lookup-source="/UserGroups/GetLookupList"
                       data-lookup-title="Список групп"
                       data-edit-url-base="/UserGroups/Edit/"
                       data-lookup-column-names="name:Название,description:Описание"
                       data-lookup-display-field="Name"
                       data-lookup-param="fieldName"
                       data-lookup-param-value="Name" autofocus/>
                <label asp-for="Name"></label>
                <i class='bx bx-search lookup-icon'></i>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-floating mb-10 max-w-600">
               <input asp-for="Description" class="form-control" id="description" name="description" placeholder=""/>
                <label asp-for="Description"></label>
               <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="card-content ">
                <div class="nav-align-top nav-tabs mb-6">
                    <ul class="nav nav-tabs nav-fill" role="tablist">
                        <li class="nav-item">
                        <button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-justified-profile" aria-controls="navs-justified-profile" aria-selected="false"><span class="d-none d-sm-block"><i class="tf-icons bx bx-group bx-sm me-1_5 align-text-bottom"></i> Пользователи</span><i class="bx bx-user bx-sm d-sm-none"></i></button>
                    </li>
                        <li class="nav-item">
                        <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-justified-home" aria-controls="navs-justified-home" aria-selected="true"><span class="d-none d-sm-block"><i class="tf-icons bx bx-unlink bx-sm me-1_5 align-text-bottom"></i> Связи </span><i class="bx bx-unlink bx-sm d-sm-none"></i></button>
                    </li>
       
                    <li class="nav-item">
                        <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-justified-messages" aria-controls="navs-justified-messages" aria-selected="false"><span class="d-none d-sm-block"><i class="tf-icons bx bx-bell bx-sm me-1_5 align-text-bottom"></i> Уведомления</span><i class="bx bx-bell bx-sm d-sm-none"></i></button>
                    </li>
                    </ul>
                    <div class="tab-content p-0">
                    <div class="tab-pane fade show active" id="navs-justified-profile" role="tabpanel">
                        @*Пользователи*@
                        @await Html.PartialAsync("_DataTablePartial", null, new ViewDataDictionary(ViewData)
                        {
                            { "TableId", "userGroupsMembersTable" },
                            { "WithoutCard", true }
                        })
                    </div>
                    <div class="tab-pane fade" id="navs-justified-home" role="tabpanel">
         
                    </div>
                    <div class="tab-pane fade" id="navs-justified-messages" role="tabpanel">
                        <div class="card-body">
                            
                        </div>
                    </div>
                    </div>
                </div>
             </div>
        </form>
    </div>
</div>

<script src="~/js/form-change-tracker.js"></script>
<script>
    enableSaveOnChange("#userGroupEditForm", "#btnSave");
</script>

@section PageScripts {
    <script>
        const preselectedIds = @Html.Raw(Json.Serialize(Model.MembersGuids ?? new List<string>()));
        const tableId = "userGroupsMembersTable";

        $(document).ready(function () {

            initUniqueDataTable(tableId, '@Url.Action("GetData", "UserGroups")', {
                getDataParams: { tableModel: "User" },
            });

            // ждем немного, чтобы таблица отрендерилась
            setTimeout(() => {
                if (!window[`selectedIds_${tableId}`]) return;

                preselectedIds.forEach(id => {
                    // Добавляем в Set выбранных
                    window[`selectedIds_${tableId}`].add(id);

                    // Ставим checked у соответствующего чекбокса
                    $(`#${tableId} .row-select-checkbox[data-id='${id}']`).prop("checked", true);
                });

                // Обновляем "select-all" checkbox
                const allChecked = $(`#${tableId} .row-select-checkbox`).length === preselectedIds.length;
                $('#select-all-checkbox').prop("checked", allChecked);
            }, 300); // можно увеличить, если таблица грузится медленно
        });

        // submit формы
        $("#userGroupEditForm").on("submit", function () {
            const selectedIds = Array.from(window[`selectedIds_${tableId}`] || []);

            // Удаляем старые, если есть
            $("input[name='MembersGuids']").remove();

            // Добавляем по одному на каждый ID
            for (const id of selectedIds) {
                $(this).append(`<input type="hidden" name="MembersGuids" value="${id}" />`);
            }
        });

        $(document).on("change", `#${tableId} .row-select-checkbox`, function () {
            $("#userGroupEditForm").trigger("change");
        });
    </script>
}
