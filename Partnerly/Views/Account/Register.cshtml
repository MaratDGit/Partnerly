@model Partnerly.Models.ViewModels.RegisterViewModel
@{
  Layout = "_BlankLayout";
  ViewData["Title"] = "Зарегистрироваться";
}

@section PageStyles {
    <link rel="stylesheet" href="~/assets/vendor/css/pages/page-auth.css">
}

<div class="container-xxl">
  <div class="authentication-wrapper authentication-basic container-p-y">
    <div class="authentication-inner">

      <div class="card px-sm-6 px-0">
        <div class="card-body">
          <!-- Logo -->
          <div class="app-brand justify-content-center mb-6">
            <a href="/" class="app-brand-link gap-2">
              <span class="app-brand-logo demo">@await Html.PartialAsync("../_Partials/_Macros")</span>
              <span class="app-brand-text demo text-heading fw-bold">@TempData.Peek("appName")</span>
            </a>
          </div>
          <!-- /Logo -->
          <h5 class="mb-1">Приключение начинается здесь!</h5>

          <form id="formAuthentication" class="mb-2" asp-action="Register" method="POST">
            <div class="form-floating mb-2">
               <input asp-for="FullName" class="form-control" id="fullName" name="fullName" placeholder="" autofocus/>
               <label asp-for="FullName"></label>
               <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-floating mb-2">
                <input type="hidden" asp-for="FromReferrerLink" />
                @if (Model.FromReferrerLink)
                {
                    <input type="text" class="form-control" value="@Model.ReferrerCode" readonly />
                    <input type="hidden" asp-for="ReferrerCode" />
                }
                else
                {
                    <input asp-for="ReferrerCode" class="form-control" id="referrerCode" name="referrerCode" placeholder="Реферальный код пригласителя"/>
                }
                <label asp-for="ReferrerCode"></label>
                <span asp-validation-for="ReferrerCode" class="text-danger"></span>
            </div>
            <div class="form-floating mb-2">
               <input asp-for="Email" class="form-control" id="email" name="email" placeholder="Введите свой адрес электронной почты"/>
               <label asp-for="Email"></label>
               <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-2">
               <input asp-for="Phone" class="form-control" id="phone" name="phone" placeholder="+37477123456"/>
               <label asp-for="Phone"></label>
               <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="mb-2 form-password-toggle">
              <div class="form-floating input-group input-group-merge">
                <input asp-for="Password" type="password" id="password" class="form-control" name="password" placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;" aria-describedby="password"/>
                <label asp-for="Password"></label>
                <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
              </div>
              <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-2 form-password-toggle">
              <div class="form-floating input-group input-group-merge">
                <input asp-for="ConfirmPassword" type="password" id="confirmpassword" class="form-control" name="confirmpassword" placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;" aria-describedby="password"/>
                <label asp-for="ConfirmPassword"></label>
                <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
              </div>
              <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="my-8">
              <div class="form-check mb-0 ms-2">
                 <input asp-for="TermsConditions" class="form-check-input" type="checkbox" id="terms-conditions"/>
                <label class="form-check-label" for="terms-conditions">
                  Я согласен с
                  <a asp-controller="Home" asp-action="Privacy" target="_blank">Политика конфиденциальности и условия</a>
                </label>
              </div>
              <span asp-validation-for="TermsConditions" class="text-danger"></span>
            </div>
            <button class="btn btn-primary d-grid w-100">
              Зарегистрироваться
            </button>
          </form>

          <p class="text-center">
            <span>У вас уже есть аккаунт?</span>
            <a asp-action="Login">
              <span>Войти</span>
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
