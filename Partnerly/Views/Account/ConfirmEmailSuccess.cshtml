@{
  Layout = "_BlankLayout";
  ViewData["Title"] = "Email verified";
}

<div class="container-xxl">
  <div class="authentication-wrapper authentication-basic container-p-y">
    <div class="authentication-inner">
      <div class="card px-sm-6 px-0">
        <div class="card-body">
                    <h4 class="text-success mb-4">✅ @Localizer["Youremailsuccessfullyverified"]</h4>
            <p class="mb-4">
                        @Localizer["Younowloginusingyourcredentials"]
            </p>
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg">
                @Localizer["Login"]
            </a>
        </div>
      </div>
    </div>
  </div>
</div>
