@model Partnerly.Models.ViewModels.ChangePasswordViewModel

@{
    Layout = "_BlankLayout";
    ViewData["Title"] = "Reset password";
}

@section PageStyles {
    <link rel="stylesheet"
          href="~/assets/vendor/css/pages/page-auth.css"
          asp-append-version="true">
}

<div class="partnerly-auth-page partnerly-auth-page-single">
    <div class="partnerly-auth-form">
        <div class="auth-form-container auth-result-container">

            <div class="auth-result-logo">
                <a asp-controller="Home" asp-action="Index" class="auth-logo">
                    <span class="auth-logo-icon">
                        <img src="~/favicon.png" alt="Logo">
                    </span>
                    <span>@TempData.Peek("appName")</span>
                </a>
            </div>

            <div class="auth-form-header">
                <div class="auth-form-icon">
                    <i class="bx bx-lock-open-alt"></i>
                </div>

                <h2>@Localizer["Resetpassword"]</h2>

                <p>
                    @Localizer["Enternewpasswordconfirm"].
                </p>
            </div>

            <form id="formAuthentication"
                  class="auth-form"
                  asp-action="ChangePassword"
                  method="POST">

                <div class="form-floating mb-3">
                    <input asp-for="Email"
                           class="form-control"
                           id="email"
                           placeholder="@Localizer["Enteryouremailaddress"]"
                           autocomplete="email"
                           readonly />

                    <label asp-for="Email"></label>

                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="mb-3 form-password-toggle">
                    <div class="form-floating input-group input-group-merge">

                        <input asp-for="Password"
                               type="password"
                               id="password"
                               class="form-control"
                               placeholder="••••••••"
                               autocomplete="new-password" />

                        <label asp-for="Password"></label>

                        <span class="input-group-text cursor-pointer">
                            <i class="bx bx-hide"></i>
                        </span>
                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger"></span>
                </div>

                <div class="mb-4 form-password-toggle">
                    <div class="form-floating input-group input-group-merge">

                        <input asp-for="ConfirmPassword"
                               type="password"
                               id="confirmpassword"
                               class="form-control"
                               placeholder="••••••••"
                               autocomplete="new-password" />

                        <label asp-for="ConfirmPassword"></label>

                        <span class="input-group-text cursor-pointer">
                            <i class="bx bx-hide"></i>
                        </span>
                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger"></span>
                </div>

                <button class="btn auth-primary-btn"
                        type="submit">

                    <span>@Localizer["Save"]</span>
                    <i class="bx bx-check"></i>

                </button>
            </form>

            <div class="auth-bottom-text">
                <a asp-controller="Account"
                   asp-action="Login">

                    <i class="bx bx-left-arrow-alt"></i>
                    @Localizer["Login"]

                </a>
            </div>

        </div>
    </div>
</div>