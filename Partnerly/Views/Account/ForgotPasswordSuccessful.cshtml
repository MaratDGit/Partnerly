@{
    Layout = "_BlankLayout";
    ViewData["Title"] = "Password reset";
}

@section PageStyles {
    <link rel="stylesheet"
          href="~/assets/vendor/css/pages/page-auth.css"
          asp-append-version="true">
}

<div class="partnerly-auth-page partnerly-auth-page-single">
    <div class="partnerly-auth-form">
        <div class="auth-form-container auth-result-container">

            <div class="auth-result-logo">
                <a asp-controller="Home" asp-action="Index" class="auth-logo">
                    <span class="auth-logo-icon">
                        <img src="~/favicon.png" alt="Logo">
                    </span>

                    <span>@TempData.Peek("appName")</span>
                </a>
            </div>

            <div class="auth-result-icon success">
                <i class="bx bx-envelope"></i>
            </div>

            <div class="auth-form-header">

                <h2>@Localizer["EmailSent"]</h2>

                <p>
                    @Localizer["Wehavesentemailwithinstructionsresetyourpassword"]
                </p>

            </div>

            <a asp-controller="Account"
               asp-action="Login"
               class="btn auth-primary-btn">

                <span>@Localizer["OK"]</span>
                <i class="bx bx-right-arrow-alt"></i>

            </a>

            <div class="auth-result-footer">
                <span>
                    <i class="bx bx-info-circle"></i>
                    @Localizer["Checkyourinbox"]
                </span>
            </div>

        </div>
    </div>
</div>