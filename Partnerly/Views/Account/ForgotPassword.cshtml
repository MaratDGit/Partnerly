@model Partnerly.Models.ViewModels.ForgotPasswordViewModel

@{
    Layout = "_BlankLayout";
    ViewData["Title"] = Localizer["ForgotPassword"].Value;
}

@section PageStyles {
    <link rel="stylesheet"
          href="~/assets/vendor/css/pages/page-auth.css"
          asp-append-version="true">
}

<div class="partnerly-auth-page partnerly-auth-page-single">
    <div class="partnerly-auth-form">
        <div class="auth-form-container auth-result-container">

            <div class="auth-result-logo">
                <a asp-controller="Home" asp-action="Index" class="auth-logo">
                    @await Html.PartialAsync("_SiteLogo", "forgot")
                    <span>@TempData.Peek("appName")</span>
                </a>
            </div>

            <div class="auth-form-header">
                <h2>@Localizer["Forgotyourpassword"]</h2>

                <p>
                    @Localizer["EnteryouremailaddressandclickGet"].
                </p>
            </div>

            <form id="formAuthentication"
                  class="auth-form"
                  asp-action="ForgotPassword"
                  method="POST">

                <div class="form-floating mb-4">

                    <input asp-for="Email"
                           class="form-control"
                           id="email"
                           placeholder="@Localizer["Enteryouremailaddress"]"
                           autocomplete="email"
                           autofocus />

                    <label asp-for="Email"></label>

                    <span asp-validation-for="Email"
                          class="text-danger"></span>

                </div>

                <button class="btn auth-primary-btn"
                        type="submit">

                    <span>@Localizer["Get"]</span>
                    <i class="bx bx-send"></i>

                </button>

            </form>

            <div class="auth-bottom-text">

                <span>
                    @Localizer["Doyoualreadhaveanaccount"]
                </span>

                <a asp-controller="Account"
                   asp-action="Login">

                    @Localizer["Login"]

                </a>

            </div>

        </div>
    </div>
</div>