@model Partnerly.Models.ViewModels.ForgotPasswordViewModel
@{
  Layout = "_BlankLayout";
  ViewData["Title"] = "Забыли пароль";
}

@section PageStyles {
    <link rel="stylesheet" href="~/assets/vendor/css/pages/page-auth.css">
}

<div class="container-xxl">
  <div class="authentication-wrapper authentication-basic container-p-y">
    <div class="authentication-inner">
      <div class="card px-sm-6 px-0">
        <div class="card-body">
          <!-- Logo -->
          <div class="app-brand justify-content-center">
            <a href="/" class="app-brand-link gap-2">
              <span class="app-brand-logo demo"><img src="~/favicon.png" alt="Logo" width="32" height="32" class="me-2" />@*@await Html.PartialAsync("../_Partials/_Macros")*@</span>
              <span class="app-brand-text demo text-heading fw-bold">@TempData.Peek("appName")</span>
            </a>
          </div>
          <!-- /Logo -->
           <p class="mb-6">Введите свой адрес электронной почты и нажмите Получить.</p>

          <form id="formAuthentication" class="mb-6" asp-action="ForgotPassword" method="POST">
            <div class="form-floating mb-6">
               <input asp-for="Email" class="form-control" id="email" name="email" placeholder="Введите свой адрес электронной почты" autofocus/>
               <label asp-for="Email"></label>
               <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-6">
              <button class="btn btn-primary d-grid w-100" type="submit">Получить</button>
            </div>
          </form>

          <p class="text-center">
            <span>У вас уже есть аккаунт?</span>
            <a asp-controller="Account" asp-action="Login">
              <span>Войти</span>
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>



