@model Partnerly.Models.ViewModels.LoginViewModel

@{
    Layout = "_BlankLayout";
    ViewData["Title"] = "Log in";
}

@section PageStyles {

    <link rel="stylesheet"
          href="~/assets/vendor/css/pages/page-auth.css"
          asp-append-version="true">
}

@section PageScripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            var emailError = '@Html.Raw(ViewBag.EmailConfirmationMessage ?? "")';

            if (emailError.length > 0) {

                var modalElement =
                    document.getElementById('emailErrorModal');

                if (modalElement) {

                    var myModal =
                        new bootstrap.Modal(modalElement);

                    myModal.show();
                }
            }

        });
    </script>
}


<div class="partnerly-auth-page">

    <!-- =====================================================
         LEFT BRAND PANEL
         ===================================================== -->

    <div class="partnerly-auth-brand">
        <div class="auth-brand-content">

            <a asp-controller="Home"
               asp-action="Index"
               class="auth-logo">

                <span class="auth-logo-icon">
                    <img src="~/favicon.png"
                         alt="Logo">
                </span>

                <span>
                    @TempData.Peek("appName")
                </span>

            </a>


            <div class="auth-brand-main">

                <h1>
                    @Localizer["PlaySmarter"]
                    <strong>
                        @Localizer["WinwithConfidence"]
                    </strong>
                </h1>

                <div class="auth-brand-card">

                    <div class="auth-brand-card-icon">
                        <i class="bx bx-brain"></i>
                    </div>

                    <div>
                        <strong>@TempData.Peek("authorName")</strong>
                        <span>
                            @Localizer["YourSmartBeloteAssistant"]
                        </span>
                    </div>

                </div>
            </div>
        </div>
    </div>


    <!-- =====================================================
         FORM PANEL
         ===================================================== -->

    <div class="partnerly-auth-form">

        <div class="auth-form-container">

            <!-- Logo mobile -->

            <div class="auth-mobile-logo">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="auth-logo">

                    <span class="auth-logo-icon">
                        <img src="~/favicon.png"
                             alt="Logo">
                    </span>

                    <span>
                        @TempData.Peek("appName")
                    </span>
                </a>
            </div>


            <div class="auth-form-header">
                <h2>
                    @Localizer["Login"]
                </h2>
            </div>


            <!-- =================================================
                 LOGIN FORM
                 ================================================= -->

            <form id="formAuthentication"
                  class="auth-form"
                  asp-action="Login"
                  method="POST">

                <!-- Email -->

                <div class="form-floating mb-3">

                    <input asp-for="Email"
                           class="form-control"
                           id="email"
                           placeholder="@Localizer["Enteryouremailaddress"]"
                           autocomplete="email"
                           autofocus />

                    <label asp-for="Email"></label>

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                <!-- Password -->

                <div class="mb-3 form-password-toggle">

                    <div class="form-floating input-group input-group-merge">

                        <input asp-for="Password"
                               type="password"
                               id="password"
                               class="form-control"
                               placeholder="••••••••"
                               autocomplete="current-password"
                               aria-describedby="password" />

                        <label asp-for="Password"></label>

                        <span class="input-group-text cursor-pointer password-toggle-icon"
                              role="button"
                              tabindex="0"
                              aria-label="Show password">
                            <i class="bx bx-hide"></i>
                        </span>

                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                </div>


                <!-- Remember / Forgot -->

                <div class="auth-options">

                    <div class="form-check">

                        <input asp-for="RememberMe"
                               class="form-check-input"
                               id="remember-me" />

                        <label asp-for="RememberMe"
                               class="form-check-label">
                        </label>

                    </div>


                    <a asp-controller="Account"
                       asp-action="ForgotPassword">

                        @Localizer["Forgotyourpassword"]

                    </a>

                </div>


                <!-- Login -->

                <button class="btn auth-primary-btn"
                        type="submit">

                    <span>
                        @Localizer["Login"]
                    </span>

                    <i class="bx bx-right-arrow-alt"></i>

                </button>

            </form>


            @if (ViewBag.GoogleLoginEnabled as bool? ?? true)
            {
            <!-- =================================================
                 GOOGLE
                 ================================================= -->

            <div class="auth-divider">

                <span>
                    @Localizer["Or"]
                </span>

            </div>


            <form asp-controller="Account"
                  asp-action="GoogleLogin"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="returnUrl"
                       value="@ViewBag.ReturnUrl" />

                <button type="submit"
                        class="btn auth-google-btn">

                    <i class="bx bxl-google"></i>

                    <span>
                        @Localizer["ContinuewithGoogle"]
                    </span>

                </button>

            </form>
            }


            <!-- =================================================
                 REGISTER
                 ================================================= -->

            <div class="auth-bottom-text">

                <span>
                    @Localizer["Newtoourplatform"]
                </span>

                <a asp-controller="Account"
                   asp-action="Register">

                    @Localizer["Createanaccount"]

                </a>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     EMAIL CONFIRMATION MODAL
     ========================================================= -->

<div class="modal fade"
     id="emailErrorModal"
     tabindex="-1"
     aria-labelledby="emailErrorModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content auth-modal">

            <div class="modal-header">

                <div class="auth-modal-icon">
                    <i class="bx bx-error"></i>
                </div>

                <h5 class="modal-title"
                    id="emailErrorModalLabel">

                    @Localizer["Error"]

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="@Localizer["Close"]">
                </button>

            </div>

            <div class="modal-body">

                @ViewBag.EmailConfirmationMessage

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-primary"
                        data-bs-dismiss="modal">

                    @Localizer["OK"]

                </button>

            </div>

        </div>

    </div>

</div>