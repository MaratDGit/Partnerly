@using Partnerly.Models.Authorization
@model Partnerly.Models.ViewModels.SupportTicketViewModel
@await Html.PartialAsync("_Toast")

@{
    ViewData["Title"] = Localizer["Viewcase"].Value;
    Layout = "_ContentNavbarLayout";

    var permissions = ViewData["Permissions"] as HashSet<string>
        ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    bool canEdit = permissions.Contains(PermissionCodes.SupportTicketsEdit);

    bool isNew = Model.Status == Partnerly.Descriptors.Attributes.SupportTicketStatusAttribute.New;
    bool isInProgress = Model.Status == Partnerly.Descriptors.Attributes.SupportTicketStatusAttribute.InProgress;
    bool isClosed = Model.Status == Partnerly.Descriptors.Attributes.SupportTicketStatusAttribute.Closed;

    string statusClass = isClosed ? "is-closed" : (isInProgress ? "is-progress" : "is-new");
    string statusIcon = isClosed ? "bx bx-check-circle" : (isInProgress ? "bx bx-loader-circle" : "bx bx-error-circle");
    int currentStep = isClosed ? 2 : (isInProgress ? 1 : 0);

    var culture = System.Globalization.CultureInfo.CurrentUICulture;
    string? createdText = Model.CreatedDate?.ToString("dd.MM.yyyy HH:mm", culture);
    string? updatedText = Model.UpdatedDate?.ToString("dd.MM.yyyy HH:mm", culture);
    bool isUnassigned = Model.AssignedTo == null;

    string DefaultPhoto(string? url) =>
        string.IsNullOrWhiteSpace(url)
            ? "~/assets/img/profiles/default-user.png"
            : url;

    string FormatSize(long bytes)
    {
        if (bytes < 1024)
        {
            return bytes + " B";
        }

        if (bytes < 1024 * 1024)
        {
            return (bytes / 1024.0).ToString("0.#", culture) + " KB";
        }

        return (bytes / (1024.0 * 1024)).ToString("0.#", culture) + " MB";
    }

    string FileIcon(string? contentType, string? fileName)
    {
        var type = (contentType ?? string.Empty).ToLowerInvariant();
        var ext = System.IO.Path.GetExtension(fileName ?? string.Empty).ToLowerInvariant();

        if (type.StartsWith("image/") || ext is ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".svg")
        {
            return "bx bx-image";
        }

        if (type.Contains("pdf") || ext == ".pdf")
        {
            return "bx bxs-file-pdf";
        }

        if (type.Contains("word") || ext is ".doc" or ".docx")
        {
            return "bx bxs-file-doc";
        }

        if (type.Contains("excel") || type.Contains("spreadsheet") || ext is ".xls" or ".xlsx" or ".csv")
        {
            return "bx bx-spreadsheet";
        }

        if (type.Contains("zip") || type.Contains("compressed") || ext is ".zip" or ".rar" or ".7z")
        {
            return "bx bx-archive";
        }

        return "bx bx-file";
    }

    string StepClass(int index)
    {
        if (index < currentStep)
        {
            return "is-done";
        }

        if (index == currentStep)
        {
            return isClosed ? "is-current is-closed" : "is-current";
        }

        return string.Empty;
    }
}

@section PageStyles {
    <link rel="stylesheet"
          href="~/assets/vendor/css/pages/page-viewcase.css"
          asp-append-version="true" />
}

<div class="card support-ticket-card">

    <div class="card-header">
        <div class="support-ticket-header-row">
            <div class="support-ticket-header-main">
                <div class="support-ticket-header-icon">
                    <i class="bx bx-task"></i>
                </div>
                <div class="support-ticket-heading">
                    <div class="support-ticket-kicker">
                        <span class="support-ticket-number">
                            <i class="bx bx-hash"></i>
                            @Model.TicketID
                        </span>
                        @if (Model.IsAssignedToCurrentUser)
                        {
                            <span class="support-ticket-yours">
                                <i class="bx bx-user-check"></i>
                                @Localizer["AssignedToYou"]
                            </span>
                        }
                        else if (isUnassigned)
                        {
                            <span class="support-ticket-unassigned">
                                <i class="bx bx-user-x"></i>
                                @Localizer["Unassigned"]
                            </span>
                        }
                    </div>
                    <h1 class="support-ticket-subject">@Model.Subject</h1>
                </div>
            </div>

            <span class="support-ticket-badge @statusClass">
                <i class="@statusIcon"></i>
                @Model.StatusAsView
            </span>
        </div>

        <ol class="support-ticket-steps" aria-label="@Localizer["Status"]">
            <li class="@StepClass(0)">@Localizer["New"]</li>
            <li class="@StepClass(1)">@Localizer["InProgress"]</li>
            <li class="@StepClass(2)">@Localizer["Closed"]</li>
        </ol>
    </div>

    <div class="card-body">

        <form id="viewCaseForm"
              class="support-ticket-form"
              asp-action="ViewCase"
              asp-controller="SupportTickets"
              asp-route-id="@Model.Id"
              method="post">

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Note" id="hiddenNote" />

            <div class="support-ticket-sticky">
                @await Html.PartialAsync("_StickyButtons", new Partnerly.Models.ViewModels.FormActionsViewModel {
                    Back = new Partnerly.Models.ViewModels.ActionBack(
                        id: Model.Id,
                        visible: true,
                        fromController: "SupportTickets",
                        toController: "SupportTickets",
                        fromAction: "ViewCase",
                        toAction: "Index"
                    ) { Permission = PermissionCodes.SupportTicketsView },

                    Save = new Partnerly.Models.ViewModels.ActionSave(
                        id: Model.Id,
                        visible: true,
                        fromController: "SupportTickets",
                        toController: "SupportTickets",
                        fromAction: "ViewCase",
                        toAction: "ViewCase"
                    ) { Permission = PermissionCodes.SupportTicketsEdit },

                    Attachements = new Partnerly.Models.ViewModels.ActionAttachements(
                        visible: true,
                        entityType: "SupportTicket",
                        entityId: Model.Id
                    ) { Permission = PermissionCodes.SupportTicketsView },

                    Note = new Partnerly.Models.ViewModels.ActionNote(
                        visible: true,
                        note: Model.Note,
                        id: Model.Id
                    ) { Permission = PermissionCodes.SupportTicketsEdit }
                })
            </div>

            @if (TempData.Peek("FormToast") != null)
            {
                <div class="alert alert-danger mx-3 mt-3 mb-0">
                    @TempData["FormToast"]
                </div>
                TempData.Remove("FormToast");
            }

        </form>

        @if (canEdit)
        {
            <div class="support-ticket-actions-bar">
                @if (!isInProgress)
                {
                    <a class="support-ticket-action support-ticket-action-start"
                       href="@Url.Action("StartCase", "SupportTickets", new { id = Model.Id })">
                        <i class="bx bx-play-circle"></i>
                        @Localizer["Start"]
                    </a>
                }
                @if (!isClosed)
                {
                    <a class="support-ticket-action support-ticket-action-close"
                       href="@Url.Action("CloseCase", "SupportTickets", new { id = Model.Id })">
                        <i class="bx bx-check-circle"></i>
                        @Localizer["Close"]
                    </a>
                }
                <a class="support-ticket-action"
                   href="@Url.Action("Edit", "SupportTickets", new { id = Model.Id })">
                    <i class="bx bx-user-plus"></i>
                    @Localizer["Assignto"]
                </a>
            </div>
        }

        <div class="support-ticket-layout">

            <div class="support-ticket-main">
                <article class="support-ticket-request">
                    <div class="support-ticket-request-head">
                        <img class="support-ticket-avatar"
                             src="@Url.Content(DefaultPhoto(Model.CreatorPhotoUrl))"
                             alt="" />
                        <div class="support-ticket-person-info">
                            <span class="support-ticket-person-label">@Localizer["From"]</span>
                            <span class="support-ticket-person-name">
                                @(string.IsNullOrWhiteSpace(Model.CreatorName) ? Localizer["None"] : Model.CreatorName)
                            </span>
                            @if (!string.IsNullOrWhiteSpace(Model.CreatorEmail))
                            {
                                <span class="support-ticket-person-email">@Model.CreatorEmail</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(createdText))
                        {
                            <time class="support-ticket-request-date">@createdText</time>
                        }
                    </div>

                    <div class="support-ticket-message-label">
                        <i class="bx bx-message-detail"></i>
                        @Localizer["Description"]
                    </div>
                    <p class="support-ticket-message-text">@Model.Message</p>
                </article>

                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <div class="support-ticket-note">
                        <div class="support-ticket-message-label">
                            <i class="bx bx-note"></i>
                            @Localizer["Note"]
                        </div>
                        <p class="support-ticket-message-text">@Model.Note</p>
                    </div>
                }
            </div>

            <aside class="support-ticket-aside">

                <div class="support-ticket-panel">
                    <h6 class="support-ticket-panel-title">
                        <i class="bx bx-info-circle"></i>
                        @Localizer["Details"]
                    </h6>
                    <div class="support-ticket-meta">
                        <div class="support-ticket-meta-row">
                            <span class="support-ticket-meta-label">@Localizer["CreatedDate"]</span>
                            <span class="support-ticket-meta-value">@(createdText ?? "—")</span>
                        </div>
                        <div class="support-ticket-meta-row">
                            <span class="support-ticket-meta-label">@Localizer["UpdatedDate"]</span>
                            <span class="support-ticket-meta-value">@(updatedText ?? "—")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.UpdatedByUserName))
                        {
                            <div class="support-ticket-meta-row">
                                <span class="support-ticket-meta-label">@Localizer["UpdaterName"]</span>
                                <span class="support-ticket-meta-value">@Model.UpdatedByUserName</span>
                            </div>
                        }
                        <div class="support-ticket-meta-row">
                            <span class="support-ticket-meta-label">@Localizer["IsRead"]</span>
                            <span class="support-ticket-meta-value">
                                <span class="support-ticket-read @(Model.IsReadBool ? "is-read" : "is-unread")">
                                    @(Model.IsReadBool ? Localizer["Read"] : Localizer["Unread"])
                                </span>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="support-ticket-panel @(Model.IsAssignedToCurrentUser ? "is-yours" : (isUnassigned ? "is-empty" : string.Empty))">
                    <h6 class="support-ticket-panel-title">
                        <i class="bx bx-user-check"></i>
                        @Localizer["AssignedTo"]
                    </h6>

                    <div class="support-ticket-person">
                        @if (isUnassigned)
                        {
                            <span class="support-ticket-avatar support-ticket-avatar-fallback">
                                <i class="bx bx-user-x"></i>
                            </span>
                        }
                        else
                        {
                            <img class="support-ticket-avatar"
                                 src="@Url.Content(DefaultPhoto(Model.AssignedToPhotoUrl))"
                                 alt="" />
                        }
                        <div class="support-ticket-person-info">
                            <span class="support-ticket-person-name">
                                @(string.IsNullOrWhiteSpace(Model.AssignedToName) ? Localizer["Unassigned"] : Model.AssignedToName)
                            </span>
                            @if (!string.IsNullOrWhiteSpace(Model.AssignedToEmail))
                            {
                                <span class="support-ticket-person-email">@Model.AssignedToEmail</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="support-ticket-panel">
                    <h6 class="support-ticket-panel-title">
                        <i class="bx bx-paperclip"></i>
                        @Localizer["Attachments"]
                    </h6>

                    @if (Model.TicketFiles.Count == 0)
                    {
                        <p class="support-ticket-empty">@Localizer["None"]</p>
                    }
                    else
                    {
                        <div class="support-ticket-files">
                            @foreach (var file in Model.TicketFiles)
                            {
                                <a class="support-ticket-file"
                                   href="@Url.Action("Download", "Attachments", new { id = file.Id })">
                                    <span class="support-ticket-file-icon">
                                        <i class="@FileIcon(file.ContentType, file.FileName)"></i>
                                    </span>
                                    <span class="support-ticket-person-info">
                                        <span class="support-ticket-file-name">@file.FileName</span>
                                        <span class="support-ticket-file-size">@FormatSize(file.FileSize)</span>
                                    </span>
                                </a>
                            }
                        </div>
                    }
                </div>

            </aside>

        </div>

    </div>

</div>

@section PageScripts {
    <script src="~/assets/js/form-change-tracker.js" asp-append-version="true"></script>
    <script>
        enableSaveOnChange("#viewCaseForm", "#btnSave");
    </script>
}
