@model Partnerly.Models.ViewModels.SupportTicketViewModel;
@await Html.PartialAsync("_Toast")

@{
    ViewData["Title"] = "Просмотреть задачу";
    Layout = "_ContentNavbarLayout";
    bool hasRole = ViewBag?.RoleType == Partnerly.Descriptors.Attributes.RoleTypeAttribute.Delete || ViewBag?.RoleType == Partnerly.Descriptors.Attributes.RoleTypeAttribute.Update;
    bool hasAdminRole = ViewBag?.RoleType == Partnerly.Descriptors.Attributes.RoleTypeAttribute.Delete;
}

<style>
.task-id {
  background: linear-gradient(90deg, #007bff, #00c4ff);
  color: #fff;
  font-weight: 600;
  padding: 4px 12px;
  border-radius: 12px;
  font-size: 0.9rem;
  box-shadow: 0 2px 8px rgba(0, 123, 255, 0.3);
}

.text-muted {
  color: #6c757d !important;
}
</style>

<div class="card">
    <div class="card-body">
        @await Html.PartialAsync("_StickyButtons", new Partnerly.Models.ViewModels.FormActionsViewModel {
            Back = new Partnerly.Models.ViewModels.ActionBack(id: Model.Id,visible: true, fromController: "SupportTickets", toController: "SupportTickets", fromAction: "ViewCase", toAction: "Index"),
            Menu = new Partnerly.Models.ViewModels.ActionMenu(visible: hasRole),
            MenuActions = new List<Partnerly.Models.ViewModels.MenuItemAction> {
                new Partnerly.Models.ViewModels.MenuItemAction(visible:hasRole, icon: "bx bx-fast-forward", displayName: "Начинать", fromController: "SupportTickets", toController: "SupportTickets", fromAction: "ViewCase", toAction: "StartCase", routID: @Model.Id),
                new Partnerly.Models.ViewModels.MenuItemAction(visible:hasRole, icon: "bx bx-x", displayName: "Закрыть задачу", fromController: "SupportTickets", toController: "SupportTickets", fromAction: "ViewCase", toAction: "CloseCase", routID: @Model.Id),
                new Partnerly.Models.ViewModels.MenuItemAction(visible:hasAdminRole, icon: "bx bx-reply", displayName: "Назначить", fromController: "SupportTickets", toController: "SupportTickets", fromAction: "ViewCase", toAction: "Edit", routID: @Model.Id),
            }
        })
        @if (@Model.Status == Partnerly.Descriptors.Attributes.SupportTicketStatusAttribute.InProgress || @Model.Status == Partnerly.Descriptors.Attributes.SupportTicketStatusAttribute.Closed)
        {
             <div class="alert alert-primary">@Model.StatusAsView</div>
        }
       
        <div class="mb-1 max-w-600">
            <div class="container my-5">
                <div class="task-card p-4 mx-auto">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <small class="text-muted">
                        <i class="bx bx-calendar-event me-1 text-primary"></i>
                        @(Model.CreatedDate.Value.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ru-RU")))
                        </small>
                        <span class="task-id">@Model.TicketID</span>
                    </div>

                    <div class="mb-3">
                        <h6 class="fw-bold text-dark mb-1">@Model.Subject</h6>
                        <p class="small text-muted mb-0">
                        @Model.Message
                        </p>
                    </div>

                    <div class="d-flex justify-content-between align-items-center border-top pt-3">
                        <div class="small text-muted">
                        <i class="bi bi-person-fill text-primary me-1"></i>
                        <strong>От:</strong> @Model.CreatorName
                        </div>
                        <div class="small text-muted">
                        <i class="bi bi-person-fill text-success me-1"></i>
                        <strong>Кому:</strong> @Model.AssignedToName
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



