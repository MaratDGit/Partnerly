@{
    ViewData["Title"] = "Задачи";
    Layout = "_ContentNavbarLayout";
    bool hasAdminRole = ViewBag?.RoleType == Partnerly.Descriptors.Attributes.RoleTypeAttribute.Delete;
}

@await Html.PartialAsync("_DataTablePartial", null, new ViewDataDictionary(ViewData)
{
    { "TableName", ViewData["Title"] },
    { "TableId", "supportTicketTable" },
    { "NewRecordControler", "SupportTickets" }
})

@section PageScripts {
    <script>
        $(document).ready(function () {
            initUniqueDataTable("supportTicketTable", '@Url.Action("GetData", controller: "SupportTickets")', 
            {
                getDataParams: { tableModel: "SupportTicket" },
                exportAllUrl: '@(hasAdminRole? Url.Action("ExportAllToExcel", "SupportTickets"): "")',
                exportSelectedUrl: '@(hasAdminRole? Url.Action("ExportToExcel", "SupportTickets"): "")',
            });
        });
    </script>
}