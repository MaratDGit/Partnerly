@model Partnerly.Models.ViewModels.SupportTicketViewModel;

@{
    ViewData["Title"] = "Delete task";
    Layout = "_ContentNavbarLayout";
}

@await Html.PartialAsync(
"_DeleteConfirmation",
    new Partnerly.Models.ViewModels.DeleteConfirmationViewModel
    {
        Id = Model.Id,
        Title = Localizer["Deletetask"],
        Message = Localizer["Areyousureyouwanttodeletethisfile"],
        DeleteAction = "DeleteConfirmed",
        DeleteController = "SupportTickets",
        CancelAction = "Index",
        CancelController = "SupportTickets"
    })