@model Partnerly.Models.ViewModels.UserViewModel;

@{
    ViewData["Title"] = "Delete task";
    Layout = "_ContentNavbarLayout";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5>@Localizer["Deletetask"]</h5>
    </div>

    <div class="card-body">
        <form id="userDeleteForm" asp-action="DeleteConfirmed">
            <div class="sticky-buttons justify-content-between mb-6">
                 <a asp-action="Index" class="btn btn-sm btn-outline-primary">
                    <i class="bx bx-arrow-back me-1 fs-6"></i> @Localizer["Cancel"]
                </a>
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bx bx-trash me-1 fs-6"></i> @Localizer["Confirm"]</button>
            </div>

            <input type="hidden" asp-for="Id" />
        </form>
    </div>
</div>